098f\u0995\u0995\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09ac\u09be\u09a6\u09be\u09a4 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0993 \u0986\u09aa\u09a8\u09be\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0986\u09b9\u0178\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09bf \u09a4\u0996\u09a8\u0987 \u09a4\u09be\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u0986\u09b9\u0178\u09be\u09a8 \u09b6\u09cd\u09b0\u09ac\u09a3 \u09a8\u09be \u0995\u09b0\u09be\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0985\u0999\u09cd\u0997\u09c1\u09b2\u09bf \u09a6\u09bf\u09df\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u09a8 \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u0986\u09ae\u09be\u0995\u09c7 \u09af\u09c7\u09a8 \u09a8\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09df \u09b8\u09c7 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0995\u09be\u09aa\u09dc \u09a6\u09bf\u09df\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u099a\u09c7\u09b9\u09be\u09b0\u09be\u0997\u09c1\u09b2\u09cb \u09a2\u09c7\u0995\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u0964 \u0989\u09aa\u09b0\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09b2\u09be\u09b2\u09bf\u09a4 \u09b6\u09bf\u09b0\u0995\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u099f\u09b2 \u09a5\u09c7\u0995\u09c7\u099b\u09c7\u0964 \u09b8\u09b0\u09cd\u09ac\u09cb\u09aa\u09b0\u09bf \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09af\u09c7 \u09ac\u09bf\u09b7\u09df\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u0986\u09b9\u0178\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09bf \u09a4\u09be \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09be \u0993 \u098f\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u0985\u09b9\u0999\u09cd\u0995\u09be\u09b0 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\u09ae\u09c2\u09b2\u0995 \u09a6\u09c2\u09b0\u09c7 \u09a5\u09c7\u0995\u09c7\u099b\u09c7\u0964","footnotes":null},{"id":"5427","sura":"71","aya":"8","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u064a \u062f\u064e\u0639\u064e\u0648\u06e1\u062a\u064f\u0647\u064f\u0645\u06e1 \u062c\u0650\u0647\u064e\u0627\u0631\u0657\u0627","translation":"\u09ee. \u0985\u09a4\u0983\u09aa\u09b0 \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09cd\u09af\u09c7 \u0986\u09b9\u0178\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09bf\u0964","footnotes":null},{"id":"5428","sura":"71","aya":"9","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u0650\u064a\u0653 \u0623\u064e\u0639\u06e1\u0644\u064e\u0646\u062a\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0633\u06e1\u0631\u064e\u0631\u06e1\u062a\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0633\u06e1\u0631\u064e\u0627\u0631\u0657\u0627","translation":"\u09ef. \u0985\u09a4\u0983\u09aa\u09b0 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09a6\u09be\u0993\u09df\u09be\u09a4\u09c7\u09b0 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u0995\u09c7 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8\u09b0\u09c2\u09aa\u09c0 \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u0986\u09b9\u0178\u09be\u09a8\u09c7\u09b0 \u09b8\u09cd\u09ac\u09b0 \u0995\u0996\u09a8\u09cb \u0989\u0981\u099a\u09c1 \u0986\u09ac\u09be\u09b0 \u0995\u0996\u09a8\u09cb \u09a8\u09bf\u099a\u09c1 \u0995\u09b0\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0995\u09cb\u09ae\u09b2 \u09b8\u09cd\u09ac\u09b0\u09c7 \u0986\u09b9\u0178\u09be\u09a8 \u099c\u09be\u09a8\u09bf\u09df\u09c7\u099b\u09bf\u0964","footnotes":null},{"id":"5429","sura":"71","aya":"10","arabic_text":"\u0641\u064e\u0642\u064f\u0644\u06e1\u062a\u064f \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0641\u0650\u0631\u064f\u0648\u0627\u0652 \u0631\u064e\u0628\u0651\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u063a\u064e\u0641\u0651\u064e\u0627\u0631\u0657\u0627","translation":"\u09e7\u09e6. \u09a4\u09be\u0987 \u09a4\u09cb \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09b2\u09be\u09ae, \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df! \u09a4\u09cb\u09ae\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09b0\u09ac\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09a4\u09be\u0993\u09ac\u09be \u0995\u09b0\u09c7 \u09a4\u09be\u0981\u09b0 \u0995\u09cd\u09b7\u09ae\u09be \u099a\u09be\u0993\u0964 \u0995\u09c7\u09a8\u09a8\u09be, \u09a4\u09bf\u09a8\u09bf \u09a8\u09bf\u099c \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u0995\u09be\u09b0 \u09af\u09be\u09b0\u09be \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u0995\u09cd\u09b7\u09ae\u09be \u099a\u09be\u09df \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7 \u0985\u09a8\u09c7\u0995 \u0995\u09cd\u09b7\u09ae\u09be\u0995\u09be\u09b0\u09c0\u0964","footnotes":null},{"id":"5430","sura":"71","aya":"11","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u0650\u0644\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645 \u0645\u0651\u0650\u062f\u06e1\u0631\u064e\u0627\u0631\u0657\u0627","translation":"\u09e7\u09e7. \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be \u0995\u09b0\u09b2\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09df\u09cb\u099c\u09a8 \u0985\u09a8\u09c1\u09af\u09be\u09df\u09c0 \u09ae\u09c1\u09b7\u09b2