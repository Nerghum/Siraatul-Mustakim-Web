0 \u0995\u09b0\u09c7 \u09ac\u09bf\u099b\u09bf\u09df\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964","footnotes":null},{"id":"5439","sura":"71","aya":"20","arabic_text":"\u0644\u0651\u0650\u062a\u064e\u0633\u06e1\u0644\u064f\u0643\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0633\u064f\u0628\u064f\u0644\u0657\u0627 \u0641\u0650\u062c\u064e\u0627\u062c\u0657\u0627","translation":"\u09e8\u09e6. \u0986\u09b6\u09be \u0995\u09b0\u09be \u09af\u09be\u09df, \u09b9\u09be\u09b2\u09be\u09b2 \u0989\u09aa\u09be\u09b0\u09cd\u099c\u09a8\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u098f\u09b0 \u09aa\u09cd\u09b0\u09b6\u09b8\u09cd\u09a4 \u09aa\u09a5 \u09a6\u09bf\u09df\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u099a\u09b2\u09be\u099a\u09b2 \u0995\u09b0\u09ac\u09c7\u0964","footnotes":null},{"id":"5440","sura":"71","aya":"21","arabic_text":"\u0642\u064e\u0627\u0644\u064e \u0646\u064f\u0648\u062d\u065e \u0631\u0651\u064e\u0628\u0651\u0650 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0635\u064e\u0648\u06e1\u0646\u0650\u064a \u0648\u064e\u0671\u062a\u0651\u064e\u0628\u064e\u0639\u064f\u0648\u0627\u0652 \u0645\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0632\u0650\u062f\u06e1\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0648\u064e\u0644\u064e\u062f\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u062e\u064e\u0633\u064e\u0627\u0631\u0657\u0627","translation":"\u09e8\u09e7. \u09a8\u09c2\u09b9 (\u0986\u09b2\u09be\u0987\u09b9\u09bf\u09b8-\u09b8\u09be\u09b2\u09be\u09ae) \u09ac\u09b2\u09b2\u09c7\u09a8, \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u09a8\u09bf\u09b6\u09cd\u099a\u09df\u0987 \u0986\u09ae\u09be\u09b0 \u099c\u09be\u09a4\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u098f\u0995\u09a4\u09cd\u09ac\u09ac\u09be\u09a6 \u0993 \u098f\u0995\u0995 \u098f\u09ac\u09be\u09a6\u09a4 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c0\u09df \u0986\u09ae\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0985\u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u0986\u09b0 \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u00a4\u0153 \u09b8\u09cd\u09a4\u09b0\u09c7\u09b0 \u09b2\u09cb\u0995\u09c7\u09b0\u09be \u09b8\u09c7 \u09b8\u09ac \u09a8\u09c7\u09a4\u09be\u09b0 \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u099b \u09af\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u09aa\u09a8\u09bf \u09b8\u09ae\u09cd\u09aa\u09a6 \u0993 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09be\u09a6\u09bf \u09a6\u09bf\u09df\u09c7 \u09a7\u09a8\u09cd\u09af \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u09ab\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u098f \u09b8\u09ac \u09a8\u09bf\u09df\u09be\u09ae\u09a4 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0995\u09c7\u09ac\u09b2 \u09ad\u09cd\u09b0\u09b7\u09cd\u099f\u09a4\u09be\u09b0 \u09a6\u09bf\u0995\u09c7\u0987 \u09a0\u09c7\u09b2\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u0964","footnotes":null},{"id":"5441","sura":"71","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0643\u064e\u0631\u064f\u0648\u0627\u0652 \u0645\u064e\u0643\u06e1\u0631\u0657\u0627 \u0643\u064f\u0628\u0651\u064e\u0627\u0631\u0657\u0627","translation":"\u09e8\u09e8. \u09a4\u09be\u09a6\u09c7\u09b0 \u09ac\u09dc\u09b0\u09be \u09a8\u09bf\u00a4\u0153\u09b8\u09cd\u09a4\u09b0\u09c7\u09b0 \u09b2\u09cb\u0995\u09a6\u09c7\u09b0\u0995\u09c7 \u09a8\u09c2\u09b9 \u098f\u09b0 \u09aa\u09c7\u099b\u09a8\u09c7 \u09b2\u09c7\u09b2\u09bf\u09df\u09c7 \u09a6\u09bf\u09df\u09c7 \u09ac\u09dc \u09a7\u09b0\u09a8\u09c7\u09b0 \u09ab\u09a8\u09cd\u09a6\u09bf \u098f\u0981\u099f\u09c7\u099b\u09c7\u0964","footnotes":null},{"id":"5442","sura":"71","aya":"23","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f\u0646\u0651\u064e \u0621\u064e\u0627\u0644\u0650\u0647\u064e\u062a\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f\u0646\u0651\u064e \u0648\u064e\u062f\u0651\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0633\u064f\u0648\u064e\u0627\u0639\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u063a\u064f\u0648\u062b\u064e \u0648\u064e\u064a\u064e\u0639\u064f\u0648\u0642\u064e \u0648\u064e\u0646\u064e\u0633\u06e1\u0631\u0657\u0627","translation":"\u09e8\u09e9. \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c0\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09b2\u09cb, \u09a4\u09cb\u09ae\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09a6\u09c7\u09ac\u09a4\u09be\u09a6\u09c7\u09b0 \u0987\u09ac\u09be\u09a6\u09be\u09a4 \u099b\u09be\u09dc\u09ac\u09c7 \u09a8\u09be\u0964 \u0986\u09b0 \u09a8\u09be \u09a4\u09cb\u09ae\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09ae\u09c2\u09b0\u09cd\u09a4\u09bf \u0993\u09df\u09be\u09a6, \u09b8\u09c2\u0993\u09df\u09be, \u0987\u09df\u09be\u0997\u09c1\u09b8, \u0987\u09df\u09be\u0989\u0995 \u0993 \u09a8\u09be\u09b8\u09b0\u0995\u09c7 \u09aa\u09b0\u09bf\u09a4\u09cd\u09af\u09be\u0997 \u0995\u09b0\u09ac\u09c7\u0964","footnotes":null},{"id":"5443","sura":"71","aya":"24","arabic_text":"\u0648\u064e\u0642\u064e\u062f\u06e1 \u0623\u064e\u0636\u064e\u0644\u0651\u064f\u0648\u0627\u0652 \u0643\u064e\u062b\u0650\u064a\u0631\u0657\u0627\u06d6 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0636\u064e\u0644\u064e\u0670\u0644\u0657\u0627","translation":"\u09e8\u09ea. \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u098f \u09b8\u09ac \u09ae\u09c2\u09b0\u09cd\u09a4\u09bf \u09a6\u09bf\u09df\u09c7 \u09ac\u09b9\u09c1 \u09b8\u0982\u0996\u09cd\u09af\u0995 \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u09aa\u09a5\u09ad\u09cd\u09b0\u09b7\u09cd\u099f \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u0986\u09aa\u09a8\u09bf \u0995\u09c1\u09ab\u09b0\u09c0 \u0993 \u09aa\u09be\u09aa\u09be\u099a\u09be\u09b0\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09ac\u09bf\u099a\u09b2 \u09a5\u09be\u0995\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09ac\u09bf\u099a\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09a4\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09ad\u09cd\u09b0\u09b7\u09cd\u099f\u09a4\u09be \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u0985\u09a8\u09cd\u09af \u0995\u09bf\u099b\u09c1 \u09ac\u09be\u09dc\u09bf\u09df\u09c7 \u09a6\u09bf\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":null},{"id":"5444","sura":"71","aya":"25","arabic_text":"\u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u062e\u064e\u0637\u0650\u064a\u0653\u0640\u0654\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0623\u064f\u063a\u06e1\u0631\u0650\u0642\u064f\u0648\u0627\u0652 \u0641\u064e\u0623\u064f\u062f\u06e1\u062e\u0650\u0644\u064f\u0648\u0627\u0652 \u0646\u064e\u0627\u0631\u0657\u0627 \u0641\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u062c\u0650\u062f\u064f\u0648\u0627\u0652 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u0657\u0627","translation":"\u09e8\u09eb. \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09c3\u09a4 \u09aa\u09be\u09aa\u09c7\u09b0 \u09a6\u09b0\u09c1\u09a8 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a4\u09c1\u09ab\u09be\u09a8 \u09a6\u09bf\u09df\u09c7 \u09a1\u09c1\u09ac\u09bf\u09df\u09c7 \u09a6\u09c7\u09df\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09b0 \u09aa\u09b0 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964 \u09b8\u09c7 \u09a6\u09bf\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u099b\u09be\u09dc\u09be \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09c1\u09dc\u09c7 \u0993 \u09a1\u09c1\u09ac\u09c7 \u09af\u09be\u0993\u09df\u09be \u09a5\u09c7\u09a4\u09c7 \u09b0\u0995\u09cd\u09b7\u09be\u0995\u09be\u09b0\u09c0 \u0986\u09b0 \u0995\u09c7\u0989 \u09a5\u09be\u0995\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":null},{"id":"5445","sura":"71","aya":"26","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0646\u064f\u0648\u062d\u065e \u0631\u0651\u064e\u0628\u0651\u0650 \u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u06e1 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u062f\u064e\u064a\u0651\u064e\u0627\u0631\u064b\u0627","translation":"\u09e8\u09ec. \u09a8\u09c2\u09b9 (\u0986\u09b2\u09be\u0987\u09b9\u09bf\u09b8 \u09b8\u09be\u09b2\u09be\u09ae) \u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u09af\u0996\u09a8 \u09a4\u09be\u0981\u09b0 \u099c\u09be\u09a4\u09bf\u09b0 \u0988\u09ae\u09be\u09a8 \u09a8\u09be \u0986\u09a8\u09be\u09b0 \u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09bf\u09b2\u09c7\u09a8 \u09a4\u0996\u09a8 \u09a4\u09bf\u09a8\u09bf \u09ac\u09b2\u09b2\u09c7\u09a8, \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u0986\u09aa\u09a8\u09bf \u09af\u09ae\u09c0\u09a8\u09c7 \u0995\u09cb\u09a8 \u0995\u09be\u09ab\u09bf\u09b0\u0995\u09c7 \u099a\u09b2\u09a4\u09c7 \u09a6\u09bf\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":null},{"id":"5446","sura":"71","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0625\u0650\u0646 \u062a\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064f\u0636\u0650\u0644\u0651\u064f\u0648\u0627\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u064e\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0644\u0650\u062f\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u064e\u0627\u062c\u0650\u0631\u0657\u0627 \u0643\u064e\u0641\u0651\u064e\u0627\u0631\u0657\u0627","translation":"\u09e8\u09ed. \u09b9\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u098f\u09ad\u09be\u09ac\u09c7 \u099b\u09c7\u09dc\u09c7 \u09a6\u09bf\u09df\u09c7 \u0986\u09b0\u09cb \u0985\u09ac\u0995\u09be\u09b6 \u09a6\u09c7\u09a8 \u09a4\u09be\u09b9\u09b2\u09c7 \u09a4\u09be\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09c1\u09ae\u09bf\u09a8 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09a5\u09ad\u09cd\u09b0\u09b7\u09cd\u099f \u0995\u09b0\u09ac\u09c7\u0964 \u098f\u09ae\u09a8\u0995\u09bf \u09a4\u09be\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09ac\u09be\u09a7\u09cd\u09af, \u09aa\u09be\u09aa\u09bf\u09b7\u09cd\u09a0 \u0993 \u09a8\u09bf\u0986\u09ae\u09a4\u09c7\u09b0 \u09b6\u09c1\u0995\u09b0\u09bf\u09df\u09be \u0985\u09a8\u09be\u09a6\u09be\u09df\u0995\u09be\u09b0\u09c0 \u0995\u09a0\u09bf\u09a8 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4\u09bf\u09b0 \u0995\u09be\u09ab\u09bf\u09b0 \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u0985\u09a8\u09cd\u09af \u0995\u09be\u0989\u0995\u09c7 \u099c\u09a8\u09cd\u09ae \u09a6\u09bf\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":null},{"id":"5447","sura":"71","aya":"28","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u0650\u064a \u0648\u064e\u0644\u0650\u0648\u064e\u0670\u0644\u0650\u062f\u064e\u064a\u0651\u064e \u0648\u064e\u0644\u0650\u0645\u064e\u0646 \u062f\u064e\u062e\u064e\u0644\u064e \u0628\u064e\u064a\u06e1\u062a\u0650\u064a\u064e \u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0657\u0627 \u0648\u064e\u0644\u0650\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064e\u0670\u062a\u0650\u06d6 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0632\u0650\u062f\u0650 \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u062a\u064e\u0628\u064e\u0627\u0631\u064e\u06e2\u0627","translation":"\u09e8\u09ee. \u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995! \u0986\u09aa\u09a8\u09bf \u0986\u09ae\u09be\u09b0 \u09aa\u09be\u09aa\u09b8\u09ae\u09c2\u09b9 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09b0 \u09ae\u09be\u09a4\u09be-\u09aa\u09bf\u09a4\u09be\u0995\u09c7 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09b0\u09cb \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c1\u09a8 \u0993\u0995\u09c7 \u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u0998\u09b0\u09c7 \u09ae\u09c1\u09ae\u09bf\u09a8 \u09b9\u09df\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09b8\u0995\u09b2 \u09ae\u09c1\u09ae\u09bf\u09a8 \u09aa\u09c1\u09b0\u09c1\u09b7 \u0993 \u09a8\u09be\u09b0\u09c0\u09a6\u09c7\u09b0\u0995\u09c7\u0964 \u0986\u09b0 \u09af\u09be\u09b0\u09be \u0995\u09c1\u09ab\u09c1\u09b0\u09c0 \u0993 \u09aa\u09be\u09aa\u09be\u099a\u09be\u09b0\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09ac\u09bf\u099a\u09be\u09b0 \u0995\u09b0\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u09aa\u09a8\u09bf \u09a7\u09cd\u09ac\u0982\u09b8 \u0993 \u0995\u09cd\u09b7\u09a4\u09bf \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u0985\u09a8\u09cd\u09af \u0995\u09bf\u099b\u09c1 \u09ac\u09be\u09dc\u09bf\u09df\u09c7 \u09a6\u09bf\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":null}]}