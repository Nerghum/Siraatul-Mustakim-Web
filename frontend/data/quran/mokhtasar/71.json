u0642\u0657\u0627","translation":"\u09e7\u09eb. \u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09bf \u09a6\u09c7\u0996\u09cb \u09a8\u09be \u09af\u09c7, \u09a4\u09bf\u09a8\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u098f\u0995\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09aa\u09b0\u099f\u09bf \u09b0\u09c7\u0996\u09c7 \u09b8\u09be\u09a4 \u09a4\u09ac\u0995 \u0986\u09b8\u09ae\u09be\u09a8 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964","footnotes":null},{"id":"5435","sura":"71","aya":"16","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u064e \u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u0646\u064f\u0648\u0631\u0657\u0627 \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u064e \u0633\u0650\u0631\u064e\u0627\u062c\u0657\u0627","translation":"\u09e7\u09ec. \u09a4\u09bf\u09a8\u09bf \u099a\u09a8\u09cd\u09a6\u09cd\u09b0\u0995\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u0986\u09b8\u09ae\u09be\u09a8\u09c7 \u09af\u09ae\u09c0\u09a8\u09ac\u09be\u09b8\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u09c7 \u099c\u09cd\u09af\u09cb\u09a4\u09bf \u09ac\u09be\u09a8\u09bf\u09df\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u09b8\u09c2\u09b0\u09cd\u09af\u0995\u09c7 \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u0986\u09b2\u09cb\u0995\u09ac\u09b0\u09cd\u09a4\u09bf\u0995\u09be\u0964","footnotes":null},{"id":"5436","sura":"71","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0646\u064e\u0628\u064e\u0627\u062a\u0657\u0627","translation":"\u09e7\u09ed. \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0986\u09a6\u09ae\u0995\u09c7 \u09ae\u09be\u099f\u09bf \u09a5\u09c7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a4