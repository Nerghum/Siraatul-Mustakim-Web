":"5587","sura":"75","aya":"36","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0623\u064e\u0646 \u064a\u064f\u062a\u06e1\u0631\u064e\u0643\u064e \u0633\u064f\u062f\u064b\u0649","translation":"\u09e9\u09ec. \u09ae\u09be\u09a8\u09c1\u09b7 \u0995\u09bf \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7\u099b\u09c7 \u09af\u09c7, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09b0 \u0989\u09aa\u09b0 \u0995\u09cb\u09a8\u09b0\u09c2\u09aa \u09ac\u09bf\u09a7\u09bf-\u09ac\u09bf\u09a7\u09be\u09a8 \u0986\u09b0\u09cb\u09aa \u0995\u09b0\u09be \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u09a6\u09be\u09df\u09bf\u09a4\u09cd\u09ac\u09b9\u09c0\u09a8\u09ad\u09be\u09ac\u09c7 \u09a4\u09be\u0995\u09c7 \u099b\u09c7\u09dc\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u09a8?","footnotes":null},{"id":"5588","sura":"75","aya":"37","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0641\u064e\u0629\u0657 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0646\u0650\u064a\u0651\u0656 \u064a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"\u09e9\u09ed. \u098f \u09ae\u09be\u09a8\u09c1\u09b7\u099f\u09bf \u0995\u09bf \u098f\u0995\u09a6\u09bf\u09a8 \u09ac\u09c0\u09b0\u09cd\u09af\u09c7\u09b0 \u09ab\u09cb\u099f\u09be\u09b0\u09c2\u09aa\u09c7 \u099b\u09bf\u09b2\u09cb \u09a8\u09be\u0964 \u09af\u09be \u0997\u09b0\u09cd\u09ad\u09be\u09b6\u09df\u09c7 \u09b8\u09cd\u09a5\u09bf\u09b0 \u0995\u09b0\u09be \u09b9\u09a4\u09cb\u0964","footnotes":null},{"id":"5589","sura":"75","aya":"38","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0642\u064e\u0629\u0657 \u0641\u064e\u062e\u064e\u0644\u064e\u0642\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670","translation":"\u09e9\u09ee. \u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09be \u098f\u0995\u099f\u09bf \u099c\u09ae\u09be\u099f \u09b0\u0995\u09cd\u09a4\u09aa\u09bf\u00d0\u09c7 \