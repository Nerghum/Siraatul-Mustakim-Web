u09b8\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09a4\u09c7\u09a8\u0964 \u098f\u0995\u0995\u09ad\u09be\u09ac\u09c7 \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f\u0987 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09ab\u09b2\u09c7 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099c\u09c7\u09b0 \u09ac\u09a6\u09b2\u09be \u09a6\u09bf\u09ac\u09c7\u09a8\u0964 \u09ad\u09b2\u09cb \u0995\u09be\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09b9\u09ac\u09c7 \u09ad\u09be\u09b2\u09cb\u0964 \u0986\u09b0 \u09ae\u09a8\u09cd\u09a6 \u0995\u09be\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09b9\u09ac\u09c7 \u09ae\u09a8\u09cd\u09a6\u0964","footnotes":null},{"id":"5203","sura":"64","aya":"4","arabic_text":"\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u062a\u064f\u0633\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064f\u0639\u06e1\u0644\u0650\u0646\u064f\u0648\u0646\u064e\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u0650\u064a\u0645\u064f\u06e2 \u0628\u0650\u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0635\u0651\u064f\u062f\u064f\u0648\u0631\u0650","translation":"\u09ea. \u09a4\u09bf\u09a8\u09bf \u0986\u09b8\u09ae\u09be\u09a8 \u0993 \u09af\u09ae\u09c0\u09a8\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7 \u09b8\u09ac\u0987 \u099c\u09be\u09a8\u09c7\u09a8\u0964 \u09a4\u09bf\u09a8\u09bf \u0986\u09b0\u09cb \u099c\u09be\u09a8\u09c7\u09a8 \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09cb \u0986\u09b0 \u09af\u09be \u0997\u09cb\u09aa\u09a8 \u0995\u09b0\u09cb\u0964 \u09a4\u09bf\u09a8\u09bf \u09ac\u0995\u09cd\u09b7\u0997\u09c1\u09b2\u09cb\u09a4\u09c7 \u09ad\u09be\u09b2\u09cb-\u09ae\u09a8\u09cd\u09a6 \u09af\u09be \u09b0\u09df\u09c7\u099b\u09c7 \u09a4\u09be \u09b8\u09ac\u0987 \u099c\u09be\u09a8\u09c7\u09a8\u0964 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u098f \u09b8\u09ac\u09c7\u09b0 \u0995\u09cb\u09a8 \u0995\u09bf\u099b\u09c1\u0987 \u0997\u09cb\u09aa\u09a8 \u09a5\u09be\u0995\u09c7 \u09a8\u09be\u0964","footnotes":null},{"id":"5204","sura":"64","aya":"5","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0623\u06e1\u062a\u0650\u0643\u064f\u0645\u06e1 \u0646\u064e\u0628\u064e\u0624\u064f\u0627\u0652 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f \u0641\u064e\u0630\u064e\u0627\u0642\u064f\u0648\u0627\u0652 \u0648\u064e\u0628\u064e\u0627\u0644\u064e \u0623\u064e\u0645\u06e1\u0631\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064c \u0623\u064e\u0644\u0650\u064a\u0645\u065e","translation":"\u09eb. \u09b9\u09c7 \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09b0\u09be! \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u0995\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7\u0995\u09be\u09b0 \u0985\u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8\u09c0\u09a6\u09c7\u09b0 \u09b8\u0982\u09ac\u09be\u09a6 \u0986\u09b8\u09c7\u09a8\u09bf?! \u09af\u09c7\u09ae\u09a8: \u09a8\u09c2\u09b9, \u0986\u09a6, \u09b8\u09be\u09ae\u09c2\u09a6 \u0993 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u09c7\u09b0\u0964 \u09a4\u09be\u09b0\u09be \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7 \u0995\u09c1\u09ab\u09b0\u09c0\u09b0 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u0986\u09b8\u09cd\u09ac\u09be\u09a6\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u0989\u09aa\u09b0\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09df\u09c7\u099b\u09c7 \u09aa\u09b0\u0995\u09be\u09b2\u09c7\u09b0 \u0995\u09b7\u09cd\u099f\u09a6\u09be\u09df\u0995 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u0964 \u09b9\u09cd\u09af\u09be\u0981, \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09be \u098f\u09b8\u09c7\u099b\u09c7\u0964 \u09a4\u09be\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09b0\u09bf\u09a3\u09a4\u09bf \u09a5\u09c7\u0995\u09c7 \u0989\u09aa\u09a6\u09c7\u09b6 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09cb \u098f\u09ac\u0982 \u09a4\u09be\u09a6\u09c7\u09b0 \u09ae\u09a4\u09cb \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u0986\u09b8\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09be\u0993\u09ac\u09be \u0995\u09b0\u09cb\u0964","footnotes":null},{"id":"5205","sura":"64","aya":"6","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e\u062a \u062a\u0651\u064e\u0623\u06e1\u062a\u0650\u064a\u0647\u0650\u0645\u06e1 \u0631\u064f\u0633\u064f\u0644\u064f\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u06e1\u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0670\u062a\u0650 \u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0628\u064e\u0634\u064e\u0631\u065e \u064a\u064e\u0647\u06e1\u062f\u064f\u0648\u0646\u064e\u0646\u064e\u0627 \u0641\u064e\u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0648\u0627\u0652\u06d6 \u0648\u0651\u064e\u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u063a\u064e\u0646\u0650\u064a\u0651\u064c \u062d\u064e\u0645\u0650\u064a\u062f\u065e","translation":"\u09ec. \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u098f \u099c\u09a8\u09cd\u09af \u0986\u09b8\u09b2\u09cb \u09af\u09c7, \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09b0\u09be\u09b8\u09c2\u09b2\u0997\u09a3 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09a6\u09b2\u09c0\u09b2 \u0993 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09be\u09a6\u09bf \u09a8\u09bf\u09df\u09c7 \u0986\u0997\u09ae\u09a8 \u0995\u09b0\u09b2\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2\u0997\u09a3 \u09ae\u09be\u09a8\u09ac \u09b6\u09cd\u09b0\u09c7\u09a3\u09c0 \u09a5\u09c7\u0995\u09c7 \u0995\u09c7\u09a8 \u0986\u0997\u09ae\u09a8 \u0995\u09b0\u09b2\u09c7\u09a8 \u098f \u0986\u09aa\u09a4\u09cd\u09a4\u09bf \u0989\u09a4\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c7 \u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09b2\u09cb \u09af\u09c7, \u09ae\u09be\u09a8\u09c1\u09b7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0995\u09c0 \u09aa\u09a5 \u09a6\u09c7\u0996\u09be\u09ac\u09c7? \u098f \u0995\u09a5\u09be \u09ac\u09b2\u09c7 \u09a4\u09be\u09b0\u09be \u0995\u09c1\u09ab\u09b0\u09c0 \u0995\u09b0\u09c7 \u0988\u09ae\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09ae\u09c1\u0996 \u09b9\u09df\u09c7 \u0997\u09c7\u09b2\u09cb\u0964 \u098f\u09a4\u09c7 \u0995\u09b0\u09c7 \u09a4\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09cb\u09a8\u09b0\u09c2\u09aa \u0995\u09cd\u09b7\u09a4\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09b2\u09cb \u09a8\u09be\u0964 \u09ac\u09b0\u0982 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0988\u09ae\u09be\u09a8 \u0993 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09ac\u09c7\u09aa\u09b0\u0993\u09df\u09be \u09b9\u09b2\u09c7\u09a8\u0964 \u0995\u09c7\u09a8\u09a8\u09be, \u09a4\u09be\u09a6\u09c7\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u09a4\u09be\u0981\u09b0 \u0995\u09cb\u09a8 \u0995\u09bf\u099b\u09c1\u0987 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09c7 \u09a8\u09be\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a7\u09a8\u09be\u09a2\u09cd\u09af\u0964 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u0981\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u09ae\u09c1\u0996\u09be\u09aa\u09c7\u0995\u09cd\u09b7\u09c0 \u09a8\u09a8\u0964 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u0981\u09b0 \u0995\u09a5\u09be \u0993 \u0995\u09be\u099c\u09c7 \u09aa\u09cd\u09b0\u09b6\u0982\u09b8\u09a8\u09c0\u09df\u0964","footnotes":null},{"id":"5206","sura":"64","aya":"7","arabic_text":"\u0632\u064e\u0639\u064e\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064f\u0628\u06e1\u0639\u064e\u062b\u064f\u0648\u0627\u0652\u06da \u0642\u064f\u0644\u06e1 \u0628\u064e\u0644\u064e\u0649\u0670 \u0648\u064e\u0631\u064e\u0628\u0651\u0650\u064a \u0644\u064e\u062a\u064f\u0628\u06e1\u0639\u064e\u062b\u064f\u0646\u0651\u064e \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u062a\u064f\u0646\u064e\u0628\u0651\u064e\u0624\u064f\u0646\u0651\u064e \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u06e1\u062a\u064f\u0645\u06e1\u06da \u0648\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u0633\u0650\u064a\u0631\u065e","translation":"\u09ed. \u0995\u09be\u09ab\u09bf\u09b0\u09b0\u09be \u09a7\u09be\u09b0\u09a3\u09be \u0995\u09b0\u09c7 \u09a8\u09bf\u09df\u09c7\u099b\u09c7 \u09af\u09c7, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ae\u09b0\u09a3\u09c7\u09b0 \u09aa\u09b0 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09bf\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964 \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u0986\u09aa\u09a8\u09bf \u098f \u09b8\u09ac \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8 \u0985\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09c7 \u09a6\u09bf\u09a8 \u09af\u09c7, \u09b9\u09cd\u09af\u09be\u0981 \u0986\u09ae\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09b6\u09aa\u09a5, \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964 \u0985\u09a4\u0983\u09aa\u09b0 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u0995\u09c3\u09a4\u0995\u09b0\u09cd\u09ae\u09c7\u09b0 \u09b8\u0982\u09ac\u09be\u09a6 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c7\u09df\u09be \u09b9\u09ac\u09c7\u0964 \u0986\u09b0 \u098f \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a4\u09bf \u09b8\u09b9\u099c\u0964 \u0995\u09c7\u09a8\u09a8\u09be, \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u0985\u09a4\u098f\u09ac, \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09b0 \u09aa\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac \u0993 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8 \u09a6\u09be\u09a8\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09b8\u0995\u09cd\u09b7\u09ae\u0964","footnotes":null},{"id":"5207","sura":"64","aya":"8","arabic_text":"\u0641\u064e\u0640\u0654\u064e\u0627\u0645\u0650\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0671\u0644\u0646\u0651\u064f\u0648\u0631\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u0646\u064e\u0627\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e \u062e\u064e\u0628\u0650\u064a\u0631\u065e","translation":"\u09ee. \u09b9\u09c7 \u09ae\u09be\u09a8\u09ac \u09b8\u09ae\u09be\u099c! \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0993 \u09a4\u09a6\u09c0\u09df \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0989\u09aa\u09b0 \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09cb \u098f\u09ac\u0982 \u0993\u0987 \u0995\u09c1\u09b0\u0986\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0\u0993 \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09cb \u09af\u09be \u0986\u09ae\u09bf \u09a8\u09bf\u099c \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09ac\u09a4\u09c0\u09b0\u09cd\u09a3 \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09ae\u09b2 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09aa\u09b0\u09bf\u099c\u09cd\u099e\u09be\u09a4\u0964 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09cb\u09a8 \u0986\u09ae\u09b2\u0987 \u0997\u09cb\u09aa\u09a8 \u09a8\u09df \u098f\u09ac\u0982 \u09a4\u09bf\u09a8\u09bf \u098f\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09a6\u09bf\u09ac\u09c7\u09a8\u0964","footnotes":null},{"id":"5208","sura":"64","aya":"9","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062c\u06e1\u0645\u064e\u0639\u064f\u0643\u064f\u0645\u06e1 \u0644\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u062c\u064e\u0645\u06e1\u0639\u0650\u06d6 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u062a\u0651\u064e\u063a\u064e\u0627\u0628\u064f\u0646\u0650\u06d7 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u06e2 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u064a\u064e\u0639\u06e1\u0645\u064e\u0644\u06e1 \u0635\u064e\u0670\u0644\u0650\u062d\u0657\u0627 \u064a\u064f\u0643\u064e\u0641\u0651\u0650\u0631\u06e1 \u0639\u064e\u0646\u06e1\u0647\u064f \u0633\u064e\u064a\u0651\u0650\u0640\u0654\u064e\u0627\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u062f\u06e1\u062e\u0650\u0644\u06e1\u0647\u064f \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u0653 \u0623\u064e\u0628\u064e\u062f\u0657\u0627\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0641\u064e\u0648\u06e1\u0632\u064f \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u064f","translation":"\u09ef. \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u0986\u09aa\u09a8\u09bf \u09b8\u09c7\u0987 \u09a6\u09bf\u09a8\u09c7\u09b0 \u0995\u09a5\u09be \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7 \u0986\u09ae\u09b2\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09a6\u09c7\u09df\u09be\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09ae\u09ac\u09c7\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u098f\u0987 \u09b8\u09c7\u0987 \u09a6\u09bf\u09a8 \u09af\u09be\u09a4\u09c7 \u0995\u09be\u09ab\u09bf\u09b0\u09a6\u09c7\u09b0 \u0995\u09cd\u09b7\u09a4\u09bf \u0993 \u0998\u09be\u099f\u09a4\u09bf \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u09aa\u09be\u09ac\u09c7\u0964 \u09af\u0996\u09a8 \u09ae\u09c1\u09ae\u09bf\u09a8\u09b0\u09be \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c7 \u09a5\u09be\u0995\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c0\u09a6\u09c7\u09b0 \u09ac\u09be\u09dc\u09c0\u0997\u09c1\u09b2\u09cb\u09b0 \u0989\u09a4\u09cd\u09a4\u09be\u09b0\u09be\u09a7\u09bf\u0995\u09be\u09b0\u09c0 \u09b9\u09ac\u09c7\u0964 \u0986\u09b0 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c0\u09b0\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7 \u09a5\u09be\u0995\u09be \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c0\u09a6\u09c7\u09b0 \u0986\u09ac\u09be\u09b8\u09a8\u0997\u09c1\u09b2\u09cb\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0\u09be\u09a7\u09bf\u0995\u09be\u09b0\u09c0 \u09b9\u09ac\u09c7\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0989\u09aa\u09b0 \u0987\u09ae\u09be\u09a8 \u0986\u09a8\u09c7 \u0993 \u09b8\u09ce \u0986\u09ae\u09b2 \u0995\u09b0\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09b0 \u09aa\u09be\u09aa\u09b8\u09ae\u09c2\u09b9 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c7 \u09a6\u09c7\u09a8\u0964 \u09a4\u09be\u0995\u09c7 \u098f\u09ae\u09a8 \u09b8\u09ac \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c7 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09c7\u09a8 \u09af\u09c7\u0997\u09c1\u09b2\u09cb\u09b0 \u0985\u099f\u09cd\u099f\u09be\u09b2\u09bf\u0995\u09be \u0993 \u09ac\u09c3\u0995\u09cd\u09b7\u09b0\u09be\u099c\u09bf\u09b0 \u09a4\u09b2\u09a6\u09c7\u09b6 \u09a6\u09bf\u09df\u09c7 \u09a8\u09a6\u09c0-\u09a8\u09be\u09b2\u09be \u09aa\u09cd\u09b0\u09ac\u09be\u09b9\u09bf\u09a4 \u09b9\u09df\u0964 \u09a4\u09be\u09b0\u09be \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0\u09ad\u09be\u09ac\u09c7 \u09ac\u09b8\u09ac\u09be\u09b8 \u0995\u09b0\u09ac\u09c7\u0964 \u09b8\u09c7\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09a4\u09be\u09b0\u09be \u0995\u0996\u09a8\u09cb \u09ac\u09c7\u09b0 \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u0986\u09b0 \u09a8\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09a5\u09c7\u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u09df\u09be\u09ae\u09a4 \u0995\u0996\u09a8\u09cb \u09ac\u09bf\u099a\u09cd\u099b\u09bf\u09a8\u09cd\u09a8 \u09b9\u09ac\u09c7\u0964 \u09a4\u09be\u09b0\u09be \u09af\u09be \u09b2\u09be\u09ad \u0995\u09b0\u09b2\u09cb \u09a4\u09be \u098f\u09ae\u09a8 \u09b8\u09ab\u09b2\u09a4\u09be \u09af\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u09b8\u09ab\u09b2\u09a4\u09be\u09b0 \u09a4\u09c1\u09b2\u09a8\u09be \u09b9\u09df \u09a8\u09be\u0964","footnotes":null},{"id":"5209","sura":"64","aya":"10","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627\u0653 \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u06d6 \u0648\u064e\u0628\u0650\u0626\u06e1\u0633\u064e \u0671\u0644\u06e1\u0645\u064e\u0635\u0650\u064a\u0631\u064f","translation":"\u09e7\u09e6. \u09af\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0995\u09c7 \u0985\u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09b0 \u09b8\u09c7 \u09b8\u09ac \u0986\u09df\u09be\u09a4\u0995\u09c7 \u0985\u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09c7 \u09af\u09c7\u0997\u09c1\u09b2\u09cb\u0995\u09c7 \u0986\u09ae\u09bf \u09a8\u09bf\u099c \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0989\u09aa\u09b0 \u0985\u09ac\u09a4\u09c0\u09b0\u09cd\u09a3 \u0995\u09b0\u09c7\u099b\u09bf \u09a4\u09be\u09b0\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c0\u0964 \u09a4\u09be\u09b0\u09be \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0\u09ad\u09be\u09ac\u09c7 \u09ac\u09b8\u09ac\u09be\u09b8 \u0995\u09b0\u09ac\u09c7\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0995\u09a4\u09cb\u0987 \u09a8\u09be \u09ae\u09a8\u09cd\u09a6 \u09a4\u09be\u09a6\u09c7\u09b0 \u09a0\u09bf\u0995\u09be\u09a8\u09be\u0964","footnotes":null},{"id":"5210","sura":"64","aya":"11","arabic_text":"\u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u064e\u0627\u0628\u064e \u0645\u0650\u0646 \u0645\u0651\u064f\u0635\u0650\u064a\u0628\u064e\u0629\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0625\u0650\u0630\u06e1\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d7 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u06e2 \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u0647\u06e1\u062f\u0650 \u0642\u064e\u0644\u06e1\u0628\u064e\u0647\u064f\u06e5\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u065e","translation":"\u09e7\u09e7. \u0995\u09be\u09b0\u09cb \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09b8\u09a4\u09cd\u09a4\u09be, \u09b8\u09ae\u09cd\u09aa\u09a6 \u0995\u09bf\u0982\u09ac\u09be \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u0995\u09cb\u09a8 \u09ac\u09bf\u09aa\u09a6 \u0986\u09aa\u09a4\u09bf\u09a4 \u09b9\u09b2\u09c7 \u09a4\u09be \u09b9\u09df\u09c7 \u09a5\u09be\u0995\u09c7 \u0995\u09c7\u09ac\u09b2 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09ab\u09be\u09df\u09b8\u09be\u09b2\u09be \u0993 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0985\u09a8\u09c1\u09af\u09be\u09df\u09c0\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09ab\u09be\u09df\u09b8\u09be\u09b2\u09be \u0993 \u09a4\u09be\u0995\u09a6\u09c0\u09b0\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6 \u09ae\u09be\u09a8\u09be\u09b0 \u0993 \u09a4\u09be\u0981\u09b0 \u09ab\u09be\u09df\u09b8\u09be\u09b2\u09be\u09df \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09a5\u09be\u0995\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b8\u09c1\u09aa\u09a5\u0997\u09be\u09ae\u09c0 \u0995\u09b0\u09c7\u09a8\u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09b8\u09b0\u09cd\u09ac \u09ac\u09bf\u09b7\u09df\u09c7 \u09aa\u09b0\u09bf\u099c\u09cd\u099e\u09be\u09a4\u0964 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u0995\u09cb\u09a8 \u0995\u09bf\u099b\u09c1\u0987 \u0997\u09cb\u09aa\u09a8 \u09a5\u09be\u0995\u09c7 \u09a8\u09be\u0964","footnotes":null},{"id":"5211","sura":"64","aya":"12","arabic_text":"\u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u0652 \u0671\u0644\u0631\u0651\u064e\u0633\u064f\u0648\u0644\u064e\u06da \u0641\u064e\u0625\u0650\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0646\u064e\u0627 \u0671\u0644\u06e1\u0628\u064e\u0644\u064e\u0670\u063a\u064f \u0671\u0644\u06e1\u0645\u064f\u0628\u0650\u064a\u0646\u064f","translation":"\u09e7\u09e8. \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0993 \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u0995\u09b0\u09cb\u0964 \u09af\u09a6\u09bf \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2 \u0986\u09a8\u09bf\u09a4 \u09ac\u09bf\u09b7\u09df \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09ae\u09c1\u0996 \u09b9\u0993 \u09a4\u09be\u09b9\u09b2\u09c7 \u098f\u0987 \u09ac\u09bf\u09ae\u09c1\u0996\u09a4\u09be\u09b0 \u09aa\u09be\u09aa \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7\u0987 \u09aa\u09be\u09ac\u09c7\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u09ae\u09be\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u0995\u09c7 \u0986\u09ae\u09bf \u09af\u09be \u09aa\u09c7\u09d7\u0981\u099b\u09c7 \u09a6\u09bf\u09a4\u09c7 \u0986\u09a6\u09c7\u09b6 \u0995\u09b0\u09c7\u099b\u09bf \u09a4\u09be \u099b\u09be\u09dc\u09be \u0985\u09a8\u09cd\u09af \u0995\u09bf\u099b\u09c1 \u09a4\u09be\u0981\u09b0 \u0989\u09aa\u09b0 \u09ac\u09b0\u09cd\u09a4\u09be\u09df \u09a8\u09be\u0964 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09aa\u09c7\u09d7\u0981\u099b\u09c7 \u09a6\u09c7\u09df\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a6\u09bf\u09b7\u09cd\u099f \u09ac\u09bf\u09b7\u09df \u09aa\u09c7\u09d7\u0981\u099b\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964","footnotes":null},{"id":"5212","sura":"64","aya":"13","arabic_text":"\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0670\u0647\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0644\u06e1\u064a\u064e\u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u0650 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u09e7\u09e9. \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0987 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09ae\u09be\u09ac\u09c2\u09a6; \u09a4\u09bf\u09a8\u09bf \u09ac\u09cd\u09af\u09a4\u09c0\u09a4 \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09ae\u09be\u09ac\u09c2\u09a6 \u09a8\u09c7\u0987\u0964 \u09ae\u09c1\u2019\u09ae\u09bf\u09a8\u09a6\u09c7\u09b0 \u0989\u099a\u09bf\u09ce \u09a4\u09be\u09b0\u09be \u09af\u09c7\u09a8 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ac\u09bf\u09b7\u09df\u09c7 \u098f\u0995\u0995\u09ad\u09be\u09ac\u09c7 \u0995\u09c7\u09ac\u09b2 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0989\u09aa\u09b0\u0987 \u09ad\u09b0\u09b8\u09be \u0995\u09b0\u09c7\u0964","footnotes":null},{"id":"5213","sura":"64","aya":"14","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0650\u0643\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0670\u062f\u0650\u0643\u064f\u0645\u06e1 \u0639\u064e\u062f\u064f\u0648\u0651\u0657\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0641\u064e\u0671\u062d\u06e1\u0630\u064e\u0631\u064f\u0648\u0647\u064f\u0645\u06e1\u06da \u0648\u064e\u0625\u0650\u0646 \u062a\u064e\u0639\u06e1\u0641\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0635\u06e1\u0641\u064e\u062d\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u063a\u06e1\u0641\u0650\u0631\u064f\u0648\u0627\u0652 \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u063a\u064e\u0641\u064f\u0648\u0631\u065e \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c","translation":"\u09e7\u09ea. \u09b9\u09c7 \u09ae\u09c1\u2019\u09ae\u09bf\u09a8 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df! \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0989\u09aa\u09b0 \u0988\u09ae\u09be\u09a8 \u098f\u09a8\u09c7\u099b\u09cb \u098f\u09ac\u0982 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u09a4\u09be\u0981\u09b0 \u09ac\u09bf\u09a7\u09be\u09a8 \u0985\u09a8\u09c1\u09af\u09be\u09df\u09c0 \u0986\u09ae\u09b2 \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09cb \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09cd\u09a4\u09cd\u09b0\u09c0 \u0993 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09b6\u09a4\u09cd\u09b0\u00e6 \u09b0\u09df\u09c7\u099b\u09c7\u0964 \u09af\u09be\u09b0\u09be \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 \u0993 \u09a4\u09be\u0981\u09b0 \u09aa\u09a5\u09c7 \u099c\u09bf\u09b9\u09be\u09a6 \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u0993 \u09aa\u09bf\u099b\u09bf\u09df\u09c7 \u09b0\u09be\u0996\u09c7\u0964 \u09a4\u09be\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u09b9\u0993\u09df\u09be \u09a5\u09c7\u0995\u09c7 \u09b8\u09a4\u09b0\u09cd\u0995 \u09a5\u09be\u0995\u09cb\u0964 \u09a4\u09ac\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09a6\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u09ad\u09c1\u09b2-\u09ad\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09bf \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c7 \u09a6\u09be\u0993 \u098f\u09ac\u0982 \u09a4\u09be \u09ac\u09bf\u09b7\u09cd\u09ae\u09c3\u09a4 \u09b9\u0993 \u0989\u09aa\u09b0\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be \u0997\u09cb\u09aa\u09a8 \u09b0\u09be\u0996\u09cb \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09aa\u09b8\u09ae\u09c2\u09b9 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09ac\u09c7\u09a8 \u0993 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a6\u09df\u09be \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0995\u09b0\u09cd\u09ae \u09af\u09c7\u09ae\u09a8 \u09b9\u09df \u09ab\u09b2\u09be\u09ab\u09b2\u0993 \u09a4\u09c7\u09ae\u09a8\u0987 \u09b9\u09df\u09c7 \u09a5\u09be\u0995\u09c7\u0964","footnotes":null},{"id":"5214","sura":"64","aya":"15","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u064f\u0643\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0670\u062f\u064f\u0643\u064f\u0645\u06e1 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u065e\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062c\u06e1\u0631\u064c \u0639\u064e\u0638\u0650\u064a\u0645\u065e","translation":"\u09e7\u09eb. \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09a6 \u0993 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8-\u09b8\u09a8\u09cd\u09a4\u09a4\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09b8\u09cd\u09ac\u09b0\u09c2\u09aa\u0964 \u09a4\u09be\u0987 \u09a4\u09be\u09b0\u09be \u0995\u0996\u09a8\u09cb \u0995\u0996\u09a8\u09cb \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b9\u09be\u09b0\u09be\u09ae \u0989\u09aa\u09b0\u09cd\u099c\u09a8 \u0993 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u09aa\u09b0\u09bf\u09b9\u09be\u09b0\u09c7 \u09ac\u09be\u09a7\u09cd\u09af \u0995\u09b0\u09ac\u09c7\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af\u0995\u09c7 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09a6\u09c7\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u0993 \u09b8\u09ae\u09cd\u09aa\u09a6\u09c7\u09b0 \u09ae\u09cb\u09b9-\u09ae\u09be\u09df\u09be\u09b0 \u0989\u09aa\u09b0 \u09aa\u09cd\u09b0\u09be\u09a7\u09be\u09a8\u09cd\u09af \u09a6\u09c7\u09df \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09bf\u0995\u099f \u09b0\u09df\u09c7\u099b\u09c7 \u09ae\u09b9\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8\u0964 \u0986\u09b0 \u098f \u09ae\u09b9\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09b9\u09b2\u09cb \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u0964","footnotes":null},{"id":"5215","sura":"64","aya":"16","arabic_text":"\u0641\u064e\u0671\u062a\u0651\u064e\u0642\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0645\u064e\u0627 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0648\u064e\u0671\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0627\u0652 \u0648\u064e\u0623\u064e\u0637\u0650\u064a\u0639\u064f\u0648\u0627\u0652 \u0648\u064e\u0623\u064e\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u0652 \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0644\u0651\u0650\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u06e1\u06d7 \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0648\u0642\u064e \u0634\u064f\u062d\u0651\u064e \u0646\u064e\u0641\u06e1\u0633\u0650\u0647\u0650\u06e6 \u0641\u064e\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064f\u0641\u06e1\u0644\u0650\u062d\u064f\u0648\u0646\u064e","translation":"\u09e7\u09ec. \u09a4\u09be\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0986\u09a6\u09c7\u09b6-\u09a8\u09bf\u09b7\u09c7\u09a7 \u09ae\u09be\u09a8\u09cd\u09af \u0995\u09b0\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b8\u09be\u09a7\u09cd\u09af\u09ae\u09a4\u09cb \u09a4\u09be\u0981\u0995\u09c7 \u09ad\u09df \u0995\u09b0\u09c7 \u09a4\u09be\u0981\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af\u09c7\u09b0 \u09aa\u09a5\u09c7 \u099a\u09b2\u09cb\u0964 \u0986\u09b0 \u09a4\u09be\u0981\u09b0 \u0995\u09a5\u09be \u09b6\u09cd\u09b0\u09ac\u09a3 \u0995\u09b0\u09cb \u098f\u09ac\u0982 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0993 \u09a4\u09a6\u09c0\u09df \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u0995\u09b0\u09cb\u0964 \u09a4\u09c7\u09ae\u09a8\u09bf\u09ad\u09be\u09ac\u09c7 \u09a4\u09be\u0981\u09b0 \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u09b8\u09ae\u09cd\u09aa\u09a6\u0995\u09c7 \u0995\u09b2\u09cd\u09af\u09be\u09a3\u09c7\u09b0 \u0995\u09be\u099c\u09c7 \u09ac\u09cd\u09af\u09df \u0995\u09b0\u09cb\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u09af\u09be\u0995\u09c7 \u09a4\u09be\u09b0 \u0986\u09a4\u09cd\u09ae\u09be\u09b0 \u0985\u09a8\u09bf\u09b7\u09cd\u099f \u09a5\u09c7\u0995\u09c7 \u09b0\u09c7\u09b9\u09be\u0987 \u09a6\u09c7\u09df\u09be \u09b9\u09b2\u09cb \u09a4\u09be\u09b0\u09be\u0987 \u0995\u09be\u09ae\u09cd\u09af \u09ac\u09b8\u09cd\u09a4\u09c1 \u09b2\u09be\u09ad\u09c7 \u0993 \u0985\u09aa\u09cd\u09b0\u09bf\u09df \u09ac\u09b8\u09cd\u09a4\u09c1 \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u0995\u09cd\u09a4\u09bf \u0985\u09b0\u09cd\u099c\u09a8\u09c7 \u09a7\u09a8\u09cd\u09af\u0964","footnotes":null},{"id":"5216","sura":"64","aya":"17","arabic_text":"\u0625\u0650\u0646 \u062a\u064f\u0642\u06e1\u0631\u0650\u0636\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0642\u064e\u0631\u06e1\u0636\u064b\u0627 \u062d\u064e\u0633\u064e\u0646\u0657\u0627 \u064a\u064f\u0636\u064e\u0670\u0639\u0650\u0641\u06e1\u0647\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u064a\u064e\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0634\u064e\u0643\u064f\u0648\u0631\u064c \u062d\u064e\u0644\u0650\u064a\u0645\u064c","translation":"\u09e7\u09ed. \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09a6\u09bf \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09a7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09a6 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09a5\u09c7 \u09ac\u09cd\u09af\u09df \u0995\u09b0\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a4\u09be\u0981\u0995\u09c7 \u0989\u09a4\u09cd\u09a4\u09ae \u098b\u09a3 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09cb \u09a4\u09be\u09b9\u09b2\u09c7 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09ac\u09b9\u09c1 \u0997\u09c1\u09a3\u09c7 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u098f\u0995\u099f\u09bf \u09aa\u09c1\u09a3\u09cd\u09af\u0995\u09c7 \u09a6\u09b6 \u09a5\u09c7\u0995\u09c7 \u09b8\u09be\u09a4 \u09b6\u09a4 \u0997\u09c1\u09a3\u09c7\u0964 \u09ac\u09b0\u0982 \u09a4\u09bf\u09a8\u09bf \u09af\u09a4\u09cb \u099a\u09be\u09a8 \u09a4\u09a4\u09cb \u09ac\u09be\u09dc\u09bf\u09df\u09c7 \u09a6\u09bf\u09ac\u09c7\u09a8 \u098f\u09ac\u0982 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09aa\u09b8\u09ae\u09c2\u09b9 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u098f\u09ae\u09a8 \u0995\u09c3\u09a4\u099c\u09cd\u099e \u09af\u09bf\u09a8\u09bf \u0995\u09ae \u0986\u09ae\u09b2\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ac\u09c7\u09b6\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09a6\u09c7\u09a8\u0964 \u09a4\u09bf\u09a8\u09bf \u09b8\u09b9\u09a8\u09b6\u09c0\u09b2; \u09a4\u09cd\u09ac\u09b0\u09bf\u09a4 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":null},{"id":"5217","sura":"64","aya":"18","arabic_text":"\u0639\u064e\u0670\u0644\u0650\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0648\u064e\u0671\u0644\u0634\u0651\u064e\u0647\u064e\u0670\u062f\u064e\u0629\u0650 \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u064f \u0671\u0644\u06e1\u062d\u064e\u0643\u0650\u064a\u0645\u064f","translation":"\u09e7\u09ee. \u09ae\u09b9\u09be\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4-\u0985\u09a8\u09c1\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b8\u09ac \u0995\u09bf\u099b\u09c1\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u09b0\u09be\u0996\u09c7\u09a8\u0964 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u098f \u09b8\u09ac\u09c7\u09b0 \u0995\u09cb\u09a8 \u0995\u09bf\u099b\u09c1\u0987 \u0997\u09cb\u09aa\u09a8 \u09a5\u09be\u0995\u09c7 \u09a8\u09be\u0964 \u09a4\u09bf\u09a8\u09bf \u09aa\u09b0\u09be\u0995\u09cd\u09b0\u09ae\u09b6\u09be\u09b2\u09c0; \u09a4\u09be\u0981\u0995\u09c7 \u0995\u09cb\u09a8 \u0995\u09bf\u099b\u09c1\u0987 \u09aa\u09b0\u09be\u09b8\u09cd\u09a4 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09a8\u09be\u0964 \u09a4\u09bf\u09a8\u09bf \u09a4\u09a6\u09c0\u09df \u09b8\u09c3\u09b7\u09cd\u099f\u09bf, \u09ac\u09bf\u09a7\u09be\u09a8 \u0993 \u09ab\u09be\u09df\u09b8\u09be\u09b2\u09be\u09df \u09aa\u09cd\u09b0\u099c\u09cd\u099e\u09be\u09ac\u09be\u09a8\u0964","footnotes":null}]}