 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"\u09e9\u09ee. \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995\u09c7 \u0995\u09bf \u098f \u0986\u09b6\u09be \u0995\u09b0\u09c7 \u09af\u09c7, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u0995\u09c7 \u09ad\u09cb\u0997-\u09ac\u09bf\u09b2\u09be\u09b8\u09c7\u09b0 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c7 \u09aa\u09cd\u09b0\u09ac\u09bf\u09b7\u09cd\u099f \u0995\u09b0\u09ac\u09c7\u09a8\u0964 \u09af\u09a5\u09be\u09df \u09b8\u09c7 \u09b8\u09cd\u09a5\u09be\u09df\u09c0 \u09a8\u09bf\u09df\u09be\u09ae\u09a4\u09c7 \u09ac\u09b8\u09ac\u09be\u09b8 \u0995\u09b0\u09ac\u09c7\u0964 \u0985\u09a5\u099a \u09b8\u09c7 \u098f\u0996\u09a8\u09cb \u09a8\u09bf\u099c \u0995\u09c1\u09ab\u09b0\u09c0\u09b0 \u0989\u09aa\u09b0 \u0985\u099f\u09b2 \u09b0\u09df\u09c7\u099b\u09c7?!","footnotes":null},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u09e9\u09ef. \u09ac\u09bf\u09b7\u09df\u099f\u09bf \u09a4\u09c7\u09ae\u09a8 \u09a8\u09df \u09af\u09c7\u09ae\u09a8 \u09a4\u09be\u09b0\u09be \u09a7\u09be\u09b0\u09a3\u09be \u0995\u09b0\u099b\u09c7\u0964 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09aa\u09b0\u09bf\u099a\u09bf\u09a4 \u09ac\u09b8\u09cd\u09a4\u09c1 \u09a4\u09a5\u09be \u09a8\u0997\u09a3\u09cd\u09af \u09aa\u09be\u09a8\u09bf \u09a5\u09c7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u09ab\u09b2\u09c7 \u09a4\u09be\u09b0\u09be \u098f\u09ae\u09a8 \u09a6\u09c1\u09b0\u09cd\u09ac\u09b2 \u09af\u09c7, \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u0989\u09aa\u0995\u09be\u09b0 \u0995\u09bf\u0982\u09ac\u09be \u0985\u09aa\u0995\u09be\u09b0\u09c7\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0 \u09b0\u09be\u0996\u09c7 \u09a8\u09be\u0964 \u098f\u09a4\u09a6\u09b8\u09a4\u09cd\u09a4\u09c7\u00a1\u0993 \u09a4\u09be\u09b0\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0985\u09b9\u0999\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09c7?!","footnotes":null},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u09ea\u09e6. \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u0993 \u09b8\u09c2\u09b0\u09cd\u09af\u09c7\u09b0 \u0989\u09a6\u09df \u098f\u09ac\u0982 \u0985\u09b8\u09cd\u09a4\u09be\u099a\u09b2\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995\u09c7\u09b0 \u0995\u09b8\u09ae \u0996\u09c7\u09df\u09c7 \u09ac\u09b2\u099b\u09c7\u09a8, \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0986\u09ae\u09bf \u09b8\u0995\u09cd\u09b7\u09ae\u0964","footnotes":null},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"\u09ea\u09e7. \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0985\u09a8\u09c1\u0997\u09a4\u09a6\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a7\u09cd\u09ac\u0982\u09b8 \u0995\u09b0\u09a4\u09c7 \u0985\u09aa\u09be\u09b0\u0997 \u09a8\u0987\u0964 \u0986\u09b0 \u0986\u09ae\u09bf \u0985\u09a8\u09cd\u09af\u09a6\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0987\u09b2\u09c7 \u0995\u09bf\u0982\u09ac\u09be \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a7\u09cd\u09ac\u0982\u09b8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0987\u09b2\u09c7 \u098f\u0995\u09be\u099c\u09c7 \u0986\u09ae\u09be\u0995\u09c7 \u09aa\u09b0\u09be\u09b8\u09cd\u09a4\u0995\u09be\u09b0\u09c0 \u0995\u09c7\u0989 \u09a8\u09c7\u0987\u0964","footnotes":null},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u09ea\u09e8. \u0985\u09a4\u098f\u09ac, \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u0986\u09aa\u09a8\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0993\u09a6\u09c7\u09b0 \u09ac\u09be\u09a4\u09bf\u09b2 \u0993 \u09ad\u09cd\u09b0\u09b7\u09cd\u099f\u09a4\u09be\u09df \u099b\u09c7\u09dc\u09c7 \u09a6\u09bf\u09a8\u0964 \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u099c\u09c0\u09ac\u09a8\u09c7 \u0996\u09c7\u09b2-\u09a4\u09be\u09ae\u09be\u09b6\u09be \u0995\u09b0\u09a4\u09c7 \u09a5\u09be\u0995\u09c1\u0995\u0964 \u0985\u09ac\u09b6\u09c7\u09b7\u09c7 \u0995\u09c1\u09b0\u0986\u09a8\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4 \u0995\u09c3\u09a4 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0 \u0985\u09a8\u09c1\u09af\u09be\u09df\u09c0 \u09a4\u09be\u09b0\u09be \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u0995\u09cd\u09b7\u09be\u09a4 \u0995\u09b0\u09ac\u09c7\u0964","footnotes":null},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"\u09ea\u09e9. \u09b8\u09c7 \u09a6\u09bf\u09a8 \u09a4\u09be\u09b0\u09be \u0995\u09ac\u09b0 \u09a5\u09c7\u0995\u09c7 \u098f\u09ae\u09a8\u09ad\u09be\u09ac\u09c7 \u09a6\u09cd\u09b0\u00e6\u09a4 \u09ac\u09c7\u09b0\u09bf\u09df\u09c7 \u09aa\u09dc\u09ac\u09c7 \u09af\u09c7\u09a8 \u09a4\u09be\u09b0\u09be \u0995\u09cb\u09a8 \u09a8\u09bf\u09b6\u09be\u09a8\u09be\u09b0 \u09a6\u09bf\u0995\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09af\u09cb\u0997\u09bf\u09a4\u09be\u09ae\u09c2\u09b2\u0995\u09ad\u09be\u09ac\u09c7 \u0985\u0997\u09cd\u09b0\u09b8\u09b0 \u09b9\u099a\u09cd\u099b\u09c7\u0964","footnotes":null},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u09ea\u09ea. \u099a\u09cb\u0996 \u09a8\u09bf\u099a\u09c1 \u0995\u09b0\u09c7\u0964 \u09b8\u09c7\u0997\u09c1\u09b2\u09cb\u0995\u09c7 \u09a4\u0996\u09a8 \u09b2\u09be\u099e\u09cd\u099b\u09a8\u09be \u0998\u09bf\u09b0\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u0964 \u098f \u09b9\u09b2\u09cb \u09b8\u09c7 \u09a6\u09bf\u09a8 \u09af\u09c7 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964 \u0985\u09a5\u099a \u09a4\u09be\u09b0\u09be \u098f \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u0995\u09cb\u09a8 \u09aa\u09b0\u0993\u09df\u09be\u0987 \u0995\u09b0\u09a4\u09cb \u09a8\u09be\u0964","footnotes":null}]}