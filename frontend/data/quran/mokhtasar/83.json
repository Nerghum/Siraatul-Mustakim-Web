u09bf\u09a8\u09a6\u09c7\u09b0\u0995\u09c7 \u09a8\u09bf\u09df\u09c7 \u09b9\u09be\u09b8\u09be\u09b9\u09be\u09b8\u09bf \u0995\u09b0\u09a4\u09cb\u0964","footnotes":null},{"id":"5883","sura":"83","aya":"35","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0643\u0650 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"\u09e9\u09eb. \u09a4\u09be\u09b0\u09be \u09b8\u09c1\u09b8\u099c\u09cd\u099c\u09bf\u09a4 \u0986\u09b8\u09a8\u09c7 \u09ac\u09b8\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u0995\u09c3\u09a4 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09cd\u09a5\u09be\u09df\u09c0 \u09a8\u09bf\u09df\u09be\u09ae\u09a4 \u09aa\u09cd\u09b0\u09b0\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09ac\u09c7\u0964","footnotes":null},{"id":"5884","sura":"83","aya":"36","arabic_text":"\u0647\u064e\u0644\u06e1 \u062b\u064f\u0648\u0651\u0650\u0628\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064f \u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u09e9\u09ec. \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0995\u09be\u09ab\u09bf\u09b0\u09a6\u09c7\u09b0\u0995\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u0995\u09c3\u09a4\u0995\u09b0\u09cd\u09ae\u09c7\u09b0 \u09ab\u09b2\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa \u09aa\u09b0\u0995\u09be\u09b2\u09c7 \u0985\u09aa\u09ae\u09be\u09a8\u099c\u09a8\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09a6\u09c7\u09df\u09be \u09b9\u09ac\u09c7\u0964","footnotes":null}]}