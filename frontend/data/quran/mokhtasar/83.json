0993 \u09ac\u09bf\u09a6\u09cd\u09b0\u0192\u09aa\u09c7\u09b0 \u099b\u09b2\u09c7 \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0 \u099a\u09cb\u0996 \u099f\u09bf\u09aa\u09be-\u099f\u09bf\u09aa\u09bf \u0995\u09b0\u09c7\u0964","footnotes":null},{"id":"5879","sura":"83","aya":"31","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u0645\u064f \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0627\u0652 \u0641\u064e\u0643\u0650\u0647\u0650\u064a\u0646\u064e","translation":"\u09e9\u09e7. \u0986\u09ac\u09be\u09b0 \u09af\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09aa\u09b0\u09bf\u099c\u09a8\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09ab\u09bf\u09b0\u09c7 \u09af\u09be\u09df \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u0986\u09a8\u09a8\u09cd\u09a6 \u099a\u09bf\u09a4\u09cd\u09a4\u09c7 \u09ab\u09bf\u09b0\u09c7 \u098f \u0995\u09be\u09b0\u09a3\u09c7 \u09af\u09c7, \u09a4\u09be\u09b0\u09be \u0995\u09c1\u09ab\u09b0\u09bf\u09b0 \u0989\u09aa\u09b0 \u09b0\u09df\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09ae\u09c1\u09ae\u09bf\u09a8\u09a6\u09c7\u09b0\u0995\u09c7 \u09a8\u09bf\u09df\u09c7 \u09ac\u09bf\u09a6\u09cd\u09b0\u0192\u09aa \u0995\u09b0\u09c7\u099b\u09c7\u0964","footnotes":null},{"id":"5880","sura":"83","aya":"32","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064f\u0645\u06e1 \u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0653\u0624\u064f\u0644\u064e\u0627\u0653\u0621\u0650 \u0644\u064e\u0636\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e","translation":"\u09e9\u09e8. \u0986\u09b0 \u09af\u0996\u09a8 \u09ae\u09c1\u09b8\u09b2\u09ae\u09be\u09a8\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c7\u0996\u09c7 \u09a4\u0996\u09a8 \u09ac\u09b2\u09c7, \u098f\u09b0\u09be \u09ae\u09c2\u