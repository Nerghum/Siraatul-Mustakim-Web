a6\u09cd\u09a6\u09c0\u09a8\u201d \u09ae\u09be\u09a8\u09c7 \u09b9\u09bf\u09b8\u09be\u09ac-\u09a8\u09bf\u0995\u09be\u09b6 \u0993 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09a6\u09bf\u09ac\u09b8\u0964","footnotes":null},{"id":"5","sura":"1","aya":"5","arabic_text":"\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0639\u06e1\u0628\u064f\u062f\u064f \u0648\u064e\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0633\u06e1\u062a\u064e\u0639\u0650\u064a\u0646\u064f","translation":"\u09eb. \u09b9\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9! \u0986\u09ae\u09b0\u09be \u0995\u09c7\u09ac\u09b2 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0987 \u09af\u09be\u09ac\u09a4\u09c0\u09df \u0987\u09ac\u09be\u09a6\u09a4 \u0993 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af \u0995\u09b0\u09bf\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09b0 \u0995\u09be\u0989\u0995\u09c7 \u09b6\u09b0\u09c0\u0995 \u0995\u09b0\u09bf \u09a8\u09be\u0964 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u0995\u09b2 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u0995\u09c7\u09ac\u09b2 \u0986\u09aa\u09a8\u09be\u09b0\u0987 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09be\u09ae\u09a8\u09be \u0995\u09b0\u09bf\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b9\u09be\u09a4\u09c7\u0987 \u09b8\u0995\u09b2 \u0995\u09b2\u09cd\u09af\u09be\u09a3\u0964 \u0986\u09aa\u09a8\u09bf \u099b\u09be\u09dc\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09b0 \u0995\u09cb\u09a8 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u0995\u09be\u09b0\u09c0 \u09a8\u09c7\u0987\u0964","footnotes":null},{"id":"6","sura":"1","aya":"6","arabic_text":"\u0671\u0647\u06e1\u062f\u0650\u0646\u064e\u0627 \u0671\u0644\u0635\u0651\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"\u09ec. \u0986\u09aa\u09a8\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09b0\u09b2 \u09aa\u09a5 \u09a6\u09c7\u0996\u09be\u09a8\u0964 \u098f\u09b0 \u0989\u09aa\u09b0 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\u0964 \u0985\u099f\u09b2 \u09b0\u09be\u0996\u09c1\u09a8\u0964 \u0986\u09b0\u09cb \u09b9\u09bf\u09a6\u09be\u09df\u09c7\u09a4 \u09ac\u09be\u09dc\u09bf\u09df\u09c7 \u09a6\u09bf\u09a8\u0964 \u0627\u0644\u0635\u0651\u0650\u0631\u064e\u0627\u0637\u064f \u0627\u0644\u0652\u0640\u0645\u064f\u0633\u0652\u062a\u064e\u0642\u0650\u064a\u0652\u0645\u064f \u201c\u0986\u09b8-\u09b8\u09bf\u09b0\u09be\u09a4\u09c1\u09b2-\u09ae\u09c1\u09b8\u09cd\u09a4\u09be\u0995\u09c0\u09ae\u201d \u09ae\u09be\u09a8\u09c7 \u098f\u09ae\u09a8 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09aa\u09a5 \u09af\u09be\u09a4\u09c7 \u0995\u09cb\u09a8 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09ac\u0995\u09cd\u09b0\u09a4\u09be \u09a8\u09c7\u0987\u0964 \u09b8\u09c7\u099f\u09bf \u09b9\u09b2\u09cb \u09b8\u09c7\u0987 \u0987\u09b8\u09b2\u09be\u09ae \u09af\u09be \u09a6\u09bf\u09df\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u2018\u0986\u09b2\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09ac\u09c0 \u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6 (\u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09df\u09be\u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae) \u0995\u09c7 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09a4\u09c7 \u09aa\u09be\u09a0\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964","footnotes":null},{"id":"7","sura":"1","aya":"7","arabic_text":"\u0635\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0646\u06e1\u0639\u064e\u0645\u06e1\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u0650 \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0636\u064f\u0648\u0628\u0650 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"\u09ed. \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09c7 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u09aa\u09a5 \u09af\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0986\u09aa\u09a8\u09bf \u09b9\u09bf\u09a6\u09be\u09df\u09c7\u09a4\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u09af\u09c7\u09ae\u09a8: \u09a8\u09ac\u09c0, \u09b8\u09bf\u09a6\u09cd\u09a6\u09c0\u0995, \u09b6\u09b9\u09c0\u09a6 \u0993 \u09a8\u09c7\u0995\u0995\u09be\u09b0\u0997\u09a3\u0964 \u0995\u09a4\u09cb\u0987 \u09a8\u09be \u09a7\u09a8\u09cd\u09af \u0993 \u09aa\u09c1\u09a3\u09cd\u09af\u09ac\u09be\u09a8 \u09b8\u09be\u09a5\u09c0 \u09a4\u09be\u0981\u09b0\u09be\u0964 \u0993\u09a6\u09c7\u09b0 \u09aa\u09a5 \u09a8\u09df; \u09af\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u0986\u09aa\u09a8\u09bf \u0997\u09cb\u09b8\u09b8\u09be \u09b9\u09df\u09c7\u099b\u09c7\u09a8\u0964 \u09af\u09be\u09b0\u09be \u09b8\u09a4\u09cd\u09af \u099c\u09c7\u09a8\u09c7\u0993 \u09a4\u09be \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u09a8\u09bf\u0964 \u09af\u09c7\u09ae\u09a8: \u0987\u09b9\u09c2\u09a6\u09bf\u09b0\u09be\u0964 \u0993\u09a6\u09c7\u09b0 \u09aa\u09a5\u0993 \u09a8\u09df; \u09af\u09be\u09b0\u09be \u09b8\u09a4\u09cd\u09af\u09ad\u09cd\u09b0\u09b7\u09cd\u099f \u09b9\u09df\u09c7\u099b\u09c7\u0964 \u09af\u09be\u09b0\u09be \u09b8\u09a0\u09bf\u0995 \u09aa\u09a5\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u09aa\u09be\u09df\u09a8\u09bf\u0964 \u0995\u09be\u09b0\u09a3, \u09a4\u09be\u09b0\u09be \u09b8\u09a0\u09bf\u0995 \u09aa\u09a5 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0993 \u09a4\u09be \u09aa\u09be\u0993\u09df\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u09a4\u09cd\u09b0\u00e6\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u09af\u09c7\u09ae\u09a8: \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09a8\u09b0\u09be\u0964","footnotes":null}]}