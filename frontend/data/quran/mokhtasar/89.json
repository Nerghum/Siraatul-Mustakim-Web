:"15","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0647\u064f\u06e5 \u0648\u064e\u0646\u064e\u0639\u0651\u064e\u0645\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0646\u0650","translation":"\u09e7\u09eb. \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09b8\u09cd\u09ac\u09ad\u09be\u09ac \u09b9\u09b2\u09cb \u098f\u0987 \u09af\u09c7, \u09a4\u09be\u0995\u09c7 \u09af\u0996\u09a8 \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u09ae\u09c2\u09b2\u0995\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u09a8 \u098f\u09ac\u0982 \u09a4\u09be\u0995\u09c7 \u09b8\u09ae\u09cd\u09aa\u09a6, \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09be\u09a6\u09bf \u0993 \u09ae\u09b0\u09cd\u09af\u09be\u09a6\u09be \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b8\u09ae\u09c3\u09a6\u09cd\u09a7 \u0995\u09b0\u09c7\u09a8 \u09a4\u0996\u09a8 \u09b8\u09c7 \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7, \u098f\u099f\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09be\u09b0 \u09ac\u09bf\u09b6\u09c7\u09b7 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09c7\u09b0 \u09a6\u09b0\u09c1\u09a8 \u09b9\u09df\u09c7\u099b\u09c7\u0964 \u09ab\u09b2\u09c7 \u09b8\u09c7 \u09ac\u09b2\u09c7: \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u0986\u09ae\u09be\u0995\u09c7 \u0986\u09ae\u09be\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0\u09c7\u09b0 \u09ac\u09b2\u09c7 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964","footnotes":null},{"id":"6009","sura":"89","aya":"16","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0641\u064e\u0642\u064e\u062f\u064e\u0631\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0631\u0650\u0632\u06e1\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0647\u064e\u0670\u0646\u064e\u0646\u0650","translation":"\u09e7\u09ec. \u09aa\u0995\u09cd\u09b7\u09be\u09a8\u09cd\u09a4\u09b0\u09c7 \u09a4\u09be\u0995\u09c7 \u09af\u0996\u09a8 \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u09ae\u09c2\u09b2\u0995\u09ad\u09be\u09ac\u09c7 \u099c\u09c0\u09ac\u09bf\u0995\u09be\u09df \u0985\u09ad\u09be\u09ac \u09a6\u09c7\u09a8 \u09a4\u0996\u09a8 \u09b8\u09c7 \u09a7\u09be\u09b0\u09a3\u09be \u0995\u09b0\u09c7, \u098f\u099f\u09bf \u09a4\u09be\u0981\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09a4\u09be\u0995\u09c7 \u0985\u09ac\u09b9\u09c7\u09b2\u09be\u09b0 \u0986\u099a\u09b0\u09a3\u0964 \u09a4\u09be\u0987 \u09b8\u09c7 \u09ac\u09b2\u09c7: \u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u0986\u09ae\u09be\u0995\u09c7 \u0985\u09aa\u09ae\u09be\u09a8 \u0995\u09b0\u09b2\u09c7\u09a8\u0964","footnotes":null},{"id":"6010","sura":"89","aya":"17","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u062a\u064f\u0643\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u064a\u064e\u062a\u0650\u064a\u0645\u064e","translation":"\u09e7\u09ed. \u0986\u09a6\u09cc \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u098f \u09a7\u09be\u09b0\u09a3\u09be \u09a4\u09a5\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u0995\u09c7 \u09a8\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09c7\u09df\u09be \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09ae\u09c2\u09b2\u0995 \u098f\u09ac\u0982 \u09ac\u099e\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09be \u0985\u09aa\u09ae\u09be\u09a8\u09ae\u09c2\u09b2\u0995 \u09a4\u09be \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09b8\u09a0\u09bf\u0995 \u09a8\u09df\u0964 \u09ac\u09be\u09b8\u09cd\u09a4\u09ac \u0995\u09a5\u09be \u09b9\u09b2\u09cb \u098f\u0987 \u09af\u09c7, \u09a4\u09cb\u09ae\u09b0\u09be \u09aa\u09bf\u09a4\u09c3\u09b9\u09c0\u09a8\u0995\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09aa\u09cd\u09b0\u09a6\u09a4\u09cd\u09a4 \u099c\u09c0\u09ac\u09bf\u0995\u09be \u09a5\u09c7\u0995\u09c7 \u09a6\u09be\u09a8 \u0995\u09b0\u09cb \u09a8\u09be\u0964","footnotes":null},{"id":"6011","sura":"89","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062d\u064e\u0670\u0653\u0636\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"\u09e7\u09ee. \u0985\u09ad\u09c1\u0995\u09cd\u09a4\u0995\u09c7 \u0996\u09be\u09a6\u09cd\u09af \u09a6\u09be\u09a8\u09c7 \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0\u0995\u09c7 \u0989\u09ce\u09b8\u09be\u09b9\u09bf\u09a4 \u0995\u09b0\u09cb \u09a8\u09be\u0964","footnotes":null},{"id":"6012","sura":"89","aya":"19","arabic_text":"\u0648\u064e\u062a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0648\u0646\u064e \u0671\u0644\u062a\u0651\u064f\u0631\u064e\u0627\u062b\u064e \u0623\u064e\u0643\u06e1\u0644\u0657\u0627 \u0644\u0651\u064e\u0645\u0651\u0657\u0627","translation":"\u09e7\u09ef. \u0986\u09b0 \u09a4\u09cb\u09ae\u09b0\u09be \u09a6\u09c1\u09b0\u09cd\u09ac\u09b2 \u09a8\u09be\u09b0\u09c0 \u0993 \u098f\u09a4\u09c0\u09ae\u09a6\u09c7\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0 \u09b9\u09be\u09b0\u09be\u09ae\u09c7\u09b0 \u09aa\u09b0\u0993\u09df\u09be \u09a8\u09be \u0995\u09b0\u09c7 \u09a6\u09c7\u09a6\u09be\u09b0 \u09ad\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09cb\u0964","footnotes":null},{"id":"6013","sura":"89","aya":"20","arabic_text":"\u0648\u064e\u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0627\u0644\u064e \u062d\u064f\u0628\u0651\u0657\u0627 \u062c\u064e\u0645\u0651\u0657\u0627","translation":"\u09e8\u09e6. \u09a4\u09cb\u09ae\u09b0\u09be \u09b8\u09ae\u09cd\u09aa\u09a6\u0995\u09c7 \u0995\u09a0\u09bf\u09a8\u09ad\u09be\u09ac\u09c7 \u09ad\u09be\u09b2\u09cb\u09ac\u09be\u09b8\u09cb\u0964 \u09ab\u09b2\u09c7 \u098f\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b2\u09cb\u09ad\u09c7\u09b0 \u09ac\u09b6\u09c0\u09ad\u09c2\u09a4 \u09b9\u09df\u09c7 \u09a4\u09be \u09ac\u09cd\u09af\u09df \u0995\u09b0\u09a4\u09c7 \u0995\u09be\u09b0\u09cd\u09aa\u09a3\u09cd\u09af \u0995\u09b0\u09cb\u0964","footnotes":null},{"id":"6014","sura":"89","aya":"21","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0630\u064e\u0627 \u062f\u064f\u0643\u0651\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u062f\u064e\u0643\u0651\u0657\u0627 \u062f\u064e\u0643\u0651\u0657\u0627","translation":"\u09e8\u09e7. \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u0995\u09cd\u09b7\u09c7 \u098f\u09ae\u09a8\u099f\u09bf \u0995\u09b0\u09be \u0989\u099a\u09bf\u09ce \u09a8\u09df\u0964 \u09a4\u09cb\u09ae\u09b0\u09be \u09b8\u09c7 \u09b8\u09ae\u09df\u09c7\u09b0 \u0995\u09a5\u09be \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09cb \u09af\u0996\u09a8 \u09af\u09ae\u09c0\u09a8 \u0995\u09a0\u09bf\u09a8\u09ad\u09be\u09ac\u09c7 \u09a8\u09be\u09dc\u09be \u09a6\u09bf\u09ac\u09c7 \u0993 \u09aa\u09cd\u09b0\u0995\u09ae\u09cd\u09aa\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964","footnotes":null},{"id":"6015","sura":"89","aya":"22","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0643\u064f \u0635\u064e\u0641\u0651\u0657\u0627 \u0635\u064e\u0641\u0651\u0657\u0627","translation":"\u09e8\u09e8. \u0986\u09b0 \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995 \u09b8\u09cd\u09ac\u09c0\u09df \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u09ae\u09be\u099d\u09c7 \u09ab\u09be\u09df\u09b8\u09be\u09b2\u09be\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u0986\u0997\u09ae\u09a8 \u0995\u09b0\u09ac\u09c7\u09a8 \u098f\u09ac\u0982 \u09a4\u09be\u0981\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09b0\u09bf \u09ac\u09c7\u0981\u09a7\u09c7 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09b0\u09be\u0993 \u0986\u0997\u09ae\u09a8 \u0995\u09b0\u09ac\u09c7\u09a8\u0964","footnotes":null},{"id":"6016","sura":"89","aya":"23","arabic_text":"\u0648\u064e\u062c\u0650\u0627\u0652\u064a\u0653\u0621\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e\u06da \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u0644\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670","translation":"\u09e8\u09e9. \u098f \u09a6\u09bf\u09a8\u09c7 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u0995\u09c7 \u09a8\u09bf\u09df\u09c7 \u0986\u09b8\u09be \u09b9\u09ac\u09c7\u0964 \u09af\u09be\u09b0 \u09b8\u09a4\u09cd\u09a4\u09b0 \u09b9\u09be\u099c\u09be\u09b0 \u09b2\u09be\u0997\u09be\u09ae \u09a5\u09be\u0995\u09ac\u09c7 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u09b2\u09be\u0997\u09be\u09ae \u09a7\u09b0\u09c7 \u099f\u09be\u09a8\u09ac\u09c7 \u09b8\u09a4\u09cd\u09a4\u09b0 \u09b9\u09be\u099c\u09be\u09b0 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u0964 \u09b8\u09c7 \u09a6\u09bf\u09a8 \u09ae\u09be\u09a8\u09c1\u09b7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0\u09c7 \u09af\u09c7 \u09b8\u09ac \u09a4\u09cd\u09b0\u00e6\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7 \u09a4\u09be \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09ac\u09c7\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09b8\u09c7 \u09b8\u09ae\u09df \u09a4\u09be\u09b0 \u098f \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09cb\u09a8 \u0989\u09aa\u0995\u09be\u09b0\u09c7 \u0986\u09b8\u09ac\u09c7 \u09a8\u09be\u0964 \u0995\u09c7\u09a8\u09a8\u09be, \u09b8\u09c7 \u09a6\u09bf\u09a8 \u09b9\u09b2\u09cb \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8\u09c7\u09b0 \u09a6\u09bf\u09a8; \u0986\u09ae\u09b2\u09c7\u09b0 \u09a6\u09bf\u09a8 \u09a8\u09df?!","footnotes":null},{"id":"6017","sura":"89","aya":"24","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0642\u064e\u062f\u0651\u064e\u0645\u06e1\u062a\u064f \u0644\u0650\u062d\u064e\u064a\u064e\u0627\u062a\u0650\u064a","translation":"\u09e8\u09ea. \u09b8\u09c7 \u09a6\u09bf\u09a8 \u0995\u09a0\u09bf\u09a8 \u0985\u09a8\u09c1\u09b6\u09cb\u099a\u09a8\u09be\u09b0 \u09ab\u09b2\u09c7 \u09ae\u09be\u09a8\u09c1\u09b7 \u09ac\u09b2\u09ac\u09c7: \u09b9\u09be\u09df, \u0986\u09ae\u09be\u09b0 \u0986\u0995\u09cd\u09b7\u09c7\u09aa! \u0986\u09ae\u09bf \u09af\u09a6\u09bf \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u099c\u09c0\u09ac\u09a8 \u09a4\u09a5\u09be \u09aa\u09b0\u0995\u09be\u09b2\u09c7\u09b0 \u099c\u09c0\u09ac\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u09a8\u09c7\u0995 \u0986\u09ae\u09b2 \u0985\u0997\u09cd\u09b0\u09c7 \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09a4\u09be\u09ae\u0964","footnotes":null},{"id":"6018","sura":"89","aya":"25","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f \u0639\u064e\u0630\u064e\u0