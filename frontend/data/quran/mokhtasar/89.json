u09cd\u09a4 \u0986\u09a4\u09cd\u09ae\u09be!","footnotes":null},{"id":"6021","sura":"89","aya":"28","arabic_text":"\u0671\u0631\u06e1\u062c\u0650\u0639\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u0650 \u0631\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0657 \u0645\u0651\u064e\u0631\u06e1\u0636\u0650\u064a\u0651\u064e\u0629\u0657","translation":"\u09e8\u09ee. \u09a4\u09c1\u09ae\u09bf \u09a8\u09bf\u099c \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09be\u0981\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u09ae\u09b9\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09b9\u09df\u09c7 \u098f\u09ac\u0982 \u09a4\u09cb\u09ae\u09be\u09b0 \u09a8\u09c7\u0995 \u0986\u09ae\u09b2\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09a4\u09be\u0981\u09b0 \u09a8\u09bf\u0995\u099f \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f\u09bf\u09b0 \u09aa\u09be\u09a4\u09cd\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u09ab\u09bf\u09b0\u09c7 \u098f\u09b8\u09cb\u0964","footnotes":null},{"id":"6022","sura":"89","aya":"29","arabic_text":"\u0641\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u0641\u0650\u064a \u0639\u0650\u0628\u064e\u0670\u062f\u0650\u064a","translation":"\u09e8\u09ef. \u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09c1\u09ae\u09bf \u0986\u09ae\u09be\u09b0 \u09b8\u09ce \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b9\u0993\u0964","footnotes":null},{"id":"6023","sura":"89","aya":"30","arabic_text":"\u0648\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u062a\u0650\u064a","translation":"\u09e9\u09e6. \u0986\u09b0 \u09a4\u09be\u09a6\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u0