95\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u09b0\u09c7\u0996\u09c7\u099b\u09c7 \u09a4\u09be\u09b0 \u0986\u09b6\u09cd\u09b0\u09df\u09b8\u09cd\u09a5\u09b2 \u09b9\u09ac\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u0964","footnotes":null},{"id":"5753","sura":"79","aya":"41","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"\u09ea\u09e6-\u09ea\u09e7. \u09aa\u0995\u09cd\u09b7\u09be\u09a8\u09cd\u09a4\u09b0\u09c7 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09b8\u09cd\u09ac\u09c0\u09df \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995\u09c7\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u09a6\u00d0\u09be\u09df\u09ae\u09be\u09a8 \u09b9\u0993\u09df\u09be\u09b0 \u0995\u09a5\u09be \u09ad\u09df \u0995\u09b0\u09c7 \u09b8\u09cd\u09ac\u09c0\u09df \u0986\u09a4\u09cd\u09ae\u09be\u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09b9\u09be\u09b0\u09be\u09ae\u0995\u09c3\u09a4 \u09ae\u09a8\u09cb\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf \u099a\u09b0\u09bf\u09a4\u09be\u09b0\u09cd\u09a5 \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u09b0\u09c7\u0996\u09c7\u099b\u09c7 \u09a4\u09be\u09b0 \u0986\u09b6\u09cd\u09b0\u09df\u09b8\u09cd\u09a5\u09b2 \u09b9\u09ac\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u0964","footnotes":null},{"id":"5754","sura":"79","aya":"42","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0648\u0646\u064e\u0643\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u0645\u064f\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u09ea\u09e8. \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u098f \u09b8\u09ac \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8\u09c7 \u0985\