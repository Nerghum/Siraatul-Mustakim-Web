0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u09ea\u09eb. \u0986\u09aa\u09a8\u09bf \u0995\u09c7\u09ac\u09b2 \u09a4\u09be\u0995\u09c7\u0987 \u09ad\u09c0\u09a4\u09bf \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09af\u09c7 \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09ad\u09c0\u09a4-\u09b8\u09a8\u09cd\u09a4\u09cd\u09b0\u09b8\u09cd\u09a4\u0964 \u0995\u09c7\u09a8\u09a8\u09be, \u09b8\u09c7\u0987 \u098f \u09ad\u09c0\u09a4\u09bf \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\u09c7 \u0989\u09aa\u0995\u09c3\u09a4 \u09b9\u09ac\u09c7\u0964","footnotes":null},{"id":"5758","sura":"79","aya":"46","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0644\u06e1\u0628\u064e\u062b\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0634\u0650\u064a\u0651\u064e\u0629\u064b \u0623\u064e\u0648\u06e1 \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u09ea\u09ec. \u09a4\u09be\u09b0\u09be \u09af\u09c7 \u09a6\u09bf\u09a8 \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u0995\u09c7 \u099a\u09be\u0995\u09cd\u09b7\u09c1\u09b7 \u09a6\u09c7\u0996\u09ac\u09c7 \u09b8\u09c7 \u09a6\u09bf\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09ae\u09a8\u09c7 \u09b9\u09ac\u09c7, \u09a4\u09be\u09b0\u09be \u09af\u09c7\u09a8 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u099c\u09c0\u09ac\u09a8\u09c7 \u0995\u09c7\u09ac\u09b2 \u098f\u0995 \u09b8\u0995\u09be\u09b2 \u0995\u09bf\u0982\u09ac\u09be \u098f\u0995 \u09ac\u09bf\u0995\u09be\u09b2 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09cb\u0964","footnotes":null}]