0987 \u09b9\u09b2\u09cb \u09b8\u09b0\u09b2 \u09a6\u09c0\u09a8\u0964 \u09af\u09be\u09a4\u09c7 \u0995\u09cb\u09a8\u09b0\u09c2\u09aa \u09ac\u0995\u09cd\u09b0\u09a4\u09be \u09a8\u09c7\u0987\u0964","footnotes":null},{"id":"6136","sura":"98","aya":"6","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0647\u06e1\u0644\u0650 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0634\u06e1\u0631\u0650\u0643\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0646\u064e\u0627\u0631\u0650 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u0653\u06da \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u06e1 \u0634\u064e\u0631\u0651\u064f \u0671\u0644\u06e1\u0628\u064e\u0631\u0650\u064a\u0651\u064e\u0629\u0650","translation":"\u09ec. \u09a8\u09bf\u09b6\u09cd\u099a\u09df\u0987 \u0987\u09b9\u09c1\u09a6\u09bf, \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09a8 \u0993 \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u0995\u09be\u09b0 \u09af\u09be\u09b0\u09be \u0995\u09c1\u09ab\u09b0\u09c0 \u0995\u09b0\u09c7\u099b\u09c7 \u09a4\u09be\u09b0\u09be \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7 \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0\u09ad\u09be\u09ac\u09c7 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09ac\u09c7\u0964 \u098f\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0995\u09c7 \u0985\u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0993 \u09a4\u09a6\u09c0\u09df \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09b0\u09cb\u09aa \u0995\u09b0\u09be\u09b0 \u09a6\u09b