u064e\u0646\u06e1\u0647\u064f\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0644\u0650\u0645\u064e\u0646\u06e1 \u062e\u064e\u0634\u0650\u064a\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u06e5","translation":"\u09ee. \u09a4\u09be\u09a6\u09c7\u09b0 \u09ae\u09b9\u09be\u09a8 \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09b9\u09ac\u09c7 \u0989\u09a6\u09cd\u09af\u09be\u09a8\u09b8\u09ae\u09c2\u09b9\u0964 \u09af\u09c7\u0997\u09c1\u09b2\u09cb\u09b0 \u0985\u099f\u09cd\u099f\u09be\u09b2\u09bf\u0995\u09be \u0993 \u09ac\u09c3\u0995\u09cd\u09b7\u09b0\u09be\u099c\u09bf\u09b0 \u09a4\u09b2\u09a6\u09c7\u09b6 \u09a6\u09bf\u09df\u09c7 \u09a8\u09a6\u09c0\u09a8\u09be\u09b2\u09be \u09aa\u09cd\u09b0\u09ac\u09be\u09b9\u09bf\u09a4\u0964 \u09a4\u09be\u09b0\u09be \u09a4\u09a5\u09be\u09df \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0\u09ad\u09be\u09ac\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u0995\u09b0\u09ac\u09c7\u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09b9\u09df\u09c7\u099b\u09c7\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09a4\u09be\u0981\u09b0 \u0989\u09aa\u09b0 \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09df\u09a8 \u0993 \u09a4\u09be\u0981\u09b0 \u0986\u09a8\u09c1\u0997\u09a4\u09cd\u09af\u09c7\u09b0 \u09ab\u09b2 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u098f\u09ac\u0982 \u09a4\u09be\u09b0\u09be\u0993 \u09a4\u09be\u0981\u09b0 \u0989\u09aa\u09b0 \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09a4\u09be\u0981\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09b0\u09b9\u09ae\u09a4 \u09b2\u09be\u09ad\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7\u0964 \u098f \u09b0\u09b9\u09ae\u09a4 \u0995\u09c7\u09ac\u09b2 \u09b8\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0987 \u09b2\u09be\u09ad \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09c7 \u09af\u09c7 \u09b8\u09cd\u09ac\u09c0\u09df \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u09be\u09b2\u0995\u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u0986\u09a6\u09c7\u09b6-\u09a8\u09bf\u09b7\u09c7\u09a7 \u09ae\u09be\u09a8\u09cd\u09af \u0995\u09b0\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09ad\u09df \u0995\u09b0\u09c7\u0964","footnotes":null}]}