{"result":[{"id":"5200","sura":"64","aya":"1","arabic_text":"\u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06d6 \u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u0645\u064f\u0644\u06e1\u0643\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u062d\u064e\u0645\u06e1\u062f\u064f\u06d6 \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0656 \u0642\u064e\u062f\u0650\u064a\u0631\u064c","translation":"\u0986\u09b8\u09ae\u09be\u09a8\u09b8\u09ae\u09c2\u09b9\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7 \u098f\u09ac\u0982 \u099c\u09ae\u09bf\u09a8\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7, \u09b8\u09ac\u0987 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0\u09a4\u09be \u0998\u09cb\u09b7\u09a3\u09be \u0995\u09b0\u09c7\u0964 \u09b8\u09be\u09b0\u09cd\u09ac\u09ad\u09cc\u09ae\u09a4\u09cd\u09ac \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09b0 \u09a4\u09be\u0981\u09b0\u0987 \u098f\u09ac\u0982 \u09b8\u0995\u09b2 \u09aa\u09cd\u09b0\u09b6\u0982\u09b8\u09be \u09a4\u09be\u0981\u09b0\u0987\u0964 \u09a4\u09bf\u09a8\u09bf \u09b8\u09b0\u09cd\u09ac \u09ac\u09bf\u09b7\u09df\u09c7 \u09b8\u09b0\u09cd\u09ac\u09b6\u0995\u09cd\u09a4\u09bf\u09ae\u09be\u09a8\u0964","footnotes":""},{"id":"5201","sura":"64","aya":"2","arabic_text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064f\u0645\u06e1 \u0641\u064e\u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0643\u064e\u0627\u0641\u0650\u0631\u065e \u0648\u064e\u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0624\u06e1\u0645\u0650\u0646\u065e