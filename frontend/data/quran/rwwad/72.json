u09be\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09a8\u09be\u0995\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u09b0\u09ac \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ce\u09aa\u09a5\u09c7\u09b0 \u0987\u099a\u09cd\u099b\u09be \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964","footnotes":""},{"id":"5458","sura":"72","aya":"11","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u0650\u0646\u0651\u064e\u0627 \u062f\u064f\u0648\u0646\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e\u06d6 \u0643\u064f\u0646\u0651\u064e\u0627 \u0637\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0642\u0650\u062f\u064e\u062f\u0657\u0627","translation":"\u2018\u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u0995\u09a4\u09bf\u09aa\u09df \u09b8\u09ce\u0995\u09b0\u09cd\u09ae\u09b6\u09c0\u09b2 \u098f\u09ac\u0982 \u0995\u09a4\u09bf\u09aa\u09df \u098f\u09b0 \u09ac\u09cd\u09af\u09a4\u09bf\u0995\u09cd\u09b0\u09ae (\u09aa\u09be\u09aa\u09bf\u09b7\u09cd\u09a0 \u0995\u09be\u09ab\u09bf\u09b0)\u0964 \u0986\u09ae\u09b0\u09be \u099b\u09bf\u09b2\u09be\u09ae \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09ae\u09a4 \u0993 \u09aa\u09a5\u09c7\u09b0 \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c0\u0964\u2019","footnotes":""},{"id":"5459","sura":"72","aya":"12","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0638\u064e\u0646\u064e\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u0646\u0651\u064f\u0639\u06e1\u062c\u0650\u0632\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0644\u064e\u0646 \u0646\u0651\u064f\u0639\u06e1\u062c\u0650\u0632\u064e\u0647\u064f\u06e5 \u0647\u064e\u0631\u064e\u0628\u0657\u0627","translation":"\u2018\u0986\u09b0 \u0986\u09ae\u09b0\u09be \u098f \u09a6\u09c3\u09dd \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u09b0\u09be\u0996\u09bf \u09af\u09c7, \u0986\u09ae\u09b0\u09be \u0995\u09bf\u099b\u09c1\u09a4\u09c7\u0987 \u099c\u09ae\u09bf\u09a8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0995\u09c7 \u0985\u09aa\u09be\u09b0\u0997 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac \u09a8\u09be \u098f\u09ac\u0982 \u09aa\u09be\u09b2\u09bf\u09df\u09c7\u0993 \u0995\u0996\u09a8\u09cb \u09a4\u09be\u0995\u09c7 \u0985\u09aa\u09be\u09b0\u0997 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac \u09a8\u09be\u0964\u2019","footnotes":""},{"id":"5460","sura":"72","aya":"13","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653 \u0621\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6\u06d6 \u0641\u064e\u0645\u064e\u0646 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u06e2 \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f \u0628\u064e\u062e\u06e1\u0633\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0631\u064e\u0647\u064e\u0642\u0657\u0627","translation":"\u2018\u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09b0\u09be \u09af\u0996\u09a8 \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4\u09c7\u09b0 \u09ac\u09be\u09a3\u09c0 (\u0986\u09b2-\u0995\u09c1\u09b0\u0986\u09a8) \u09b6\u09c1\u09a8\u09b2\u09be\u09ae, \u09a4\u0996\u09a8 \u098f\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09b2\u09be\u09ae\u0964 \u0986\u09b0 \u09af\u09c7 \u09a4\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09c7, \u09b8\u09c7 \u09a8\u09be \u0995\u09cb\u09a8 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u0986\u09b6\u0999\u09cd\u0995\u09be \u0995\u09b0\u09ac\u09c7 \u098f\u09ac\u0982 (\u09aa\u09be\u09aa \u09ac\u09be\u09dc\u09bf\u09df\u09c7) \u09a8\u09be \u0995\u09cb\u09a8 \u0985\u09a8\u09cd\u09af\u09be\u09df\u09c7\u09b0\u0964\u2019","footnotes":""},{"id":"5461","sura":"72","aya":"14","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u0644\u0650\u0645\u064f\u0648\u0646\u064e \u0648\u064e\u0645\u0650\u0646\u0651\u064e\u0627 \u0671\u0644\u06e1\u0642\u064e\u0670\u0633\u0650\u0637\u064f\u0648\u0646\u064e\u06d6 \u0641\u064e\u0645\u064e\u0646\u06e1 \u0623\u064e\u0633\u06e1\u0644\u064e\u0645\u064e \u0641\u064e\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u062a\u064e\u062d\u064e\u0631\u0651\u064e\u0648\u06e1\u0627\u0652 \u0631\u064e\u0634\u064e\u062f\u0657\u0627","translation":"\u2018\u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0995\u09bf\u099b\u09c1 \u09b8\u0982\u0996\u09cd\u09af\u0995 \u0986\u099b\u09c7 (\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0985\u09a8\u09c1\u0997\u09a4) \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0995\u09bf\u099b\u09c1 \u09b8\u0982\u0996\u09cd\u09af\u0995 \u09b8\u09c0\u09ae\u09be\u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0 (\u0995\u09be\u09ab\u09bf\u09b0)\u0964 \u0995\u09be\u099c\u09c7\u0987 \u09af\u09be\u09b0\u09be \u0987\u09b8\u09b2\u09be\u09ae \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7\u099b\u09c7, \u09a4\u09be\u09b0\u09be\u0987 \u09b8\u09b0\u09b2-\u09b8\u09a0\u09bf\u0995 \u09aa\u09a5 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09df\u09c7\u099b\u09c7\u0964\u2019","footnotes":""},{"id":"5462","sura":"72","aya":"15","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u06e1\u0642\u064e\u0670\u0633\u0650\u0637\u064f\u0648\u0646\u064e \u0641\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0644\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u062d\u064e\u0637\u064e\u0628\u0657\u0627","translation":"\u0986\u09b0 \u09af\u09be\u09b0\u09be \u09b8\u09c0\u09ae\u09be\u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0 (\u09b8\u09a4\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u099a\u09cd\u09af\u09c1\u09a4), \u09a4\u09be\u09b0\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u09b0 \u099c\u09cd\u09ac\u09be\u09b2\u09be\u09a8\u09bf \u09b9\u09ac\u09c7\u0964","footnotes":""},{"id":"5463","sura":"72","aya":"16","arabic_text":"\u0648\u064e\u0623\u064e\u0644\u0651\u064e\u0648\u0650 \u0671\u0633\u06e1\u062a\u064e\u0642\u064e\u0670\u0645\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0637\u0651\u064e\u0631\u0650\u064a\u0642\u064e\u0629\u0650 \u0644\u064e\u0623\u064e\u0633\u06e1\u0642\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u064e\u0627\u0653\u0621\u064b \u063a\u064e\u062f\u064e\u0642\u0657\u0627","translation":"\u2018\u0986\u09b0 \u09a4\u09be\u09b0\u09be \u09af\u09a6\u09bf (\u0987\u09b8\u09b2\u09be\u09ae\u09c7\u09b0) \u09b8\u09a0\u09bf\u0995 \u09aa\u09a5\u09c7 \u0985\u09ac\u09bf\u099a\u09b2 \u09a5\u09be\u0995\u09a4, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09ae\u09bf \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7 \u09aa\u09be\u09a8\u09bf \u09aa\u09be\u09a8 \u0995\u09b0\u09be\u09a4\u09be\u09ae\u0964\u2019","footnotes":""},{"id":"5464","sura":"72","aya":"17","arabic_text":"\u0644\u0651\u0650\u0646\u064e\u0641\u06e1\u062a\u0650\u0646\u064e\u0647\u064f\u0645\u06e1 \u0641\u0650\u064a\u0647\u0650\u06da \u0648\u064e\u0645\u064e\u0646 \u064a\u064f\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u064a\u064e\u0633\u06e1\u0644\u064f\u0643\u06e1\u0647\u064f \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0635\u064e\u0639\u064e\u062f\u0657\u0627","translation":"\u09af\u09be\u09a4\u09c7 \u0986\u09ae\u09bf \u09a4\u09be \u09a6\u09bf\u09df\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964 \u0986\u09b0 \u09af\u09c7 \u09a4\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 (\u0986\u09b2-\u0995\u09c1\u09b0\u0986\u09a8) \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u0996 \u09ab\u09bf\u09b0\u09bf\u09df\u09c7 \u09a8\u09c7\u09df, \u09a4\u09be\u0995\u09c7 \u09a4\u09bf\u09a8\u09bf \u0995\u09a0\u09bf\u09a8 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09a4\u09c7 (\u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7) \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be\u09ac\u09c7\u09a8\u0964","footnotes":""},{"id":"5465","sura":"72","aya":"18","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064e\u0633\u064e\u0670\u062c\u0650\u062f\u064e \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u0645\u064e\u0639\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u062d\u064e\u062f\u0657\u0627","translation":"\u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09ae\u09b8\u099c\u09bf\u09a6\u0997\u09c1\u09b2\u09cb \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u099c\u09a8\u09cd\u09af\u0987 (\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f)\u0964 \u0995\u09be\u099c\u09c7\u0987 (\u09b8\u09c7\u0996\u09be\u09a8\u09c7) \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a8\u09cd\u09af \u0995\u09be\u0989\u0995\u09c7 \u09a1\u09c7\u0995\u09cb \u09a8\u09be\u0964","footnotes":""},{"id":"5466","sura":"72","aya":"19","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0645\u0651\u064e\u0627 \u0642\u064e\u0627\u0645\u064e \u0639\u064e\u0628\u06e1\u062f\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u064a\u064e\u062f\u06e1\u0639\u064f\u0648\u0647\u064f \u0643\u064e\u0627\u062f\u064f\u0648\u0627\u0652 \u064a\u064e\u0643\u064f\u0648\u0646\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0644\u0650\u0628\u064e\u062f\u0657\u0627","translation":"\u0986\u09b0 \u09af\u0996\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be \u09a4\u09be\u0981\u0995\u09c7 \u0986\u09b9\u09cd\u09ac\u09be\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af (\u09b8\u09be\u09b2\u09be\u09a4\u09c7) \u09a6\u09be\u0981\u09a1\u09bc\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u09b2, \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u09a4\u09be\u09b0 \u0993\u09aa\u09b0 \u0997\u09be\u09a6\u09be\u0997\u09be\u09a6\u09bf \u0995\u09b0\u09c7 \u09ad\u09bf\u09a1\u09bc \u0995\u09b0\u09be\u09b0 \u0989\u09aa\u0995\u09cd\u09b0\u09ae \u09b9\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u0964","footnotes":""},{"id":"5467","sura":"72","aya":"20","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u0631\u064e\u0628\u0651\u0650\u064a \u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0634\u06e1\u0631\u0650\u0643\u064f \u0628\u0650\u0647\u0650\u06e6\u0653 \u0623\u064e\u062d\u064e\u062f\u0657\u0627","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09a4\u09c1\u09ae\u09bf (\u098f\u09b8\u09ac \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09a6\u09c7\u09b0\u0995\u09c7) \u09ac\u09b2\u09cb: \u2018\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09bf \u0986\u09ae\u09be\u09b0 \u09b0\u09ac\u0995\u09c7\u0987 \u09a1\u09be\u0995\u09bf \u098f\u09ac\u0982 \u09a4\u09be\u0981\u09b0 \u09b8\u09be\u09a5\u09c7 \u0995\u09be\u0989\u0995\u09c7 \u09b6\u09b0\u09c0\u0995 \u0995\u09b0\u09bf \u09a8\u09be\u0964\u2019","footnotes":""},{"id":"5468","sura":"72","aya":"21","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u0650\u064a \u0644\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1\u0644\u0650\u0643\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0636\u064e\u0631\u0651\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0631\u064e\u0634\u064e\u062f\u0657\u0627","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09a4\u09c1\u09ae\u09bf (\u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7) \u09ac\u09b2\u09cb: \u2018\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09be \u0995\u09cb\u09a8 \u0985\u0995\u09b2\u09cd\u09af\u09be\u09a3 \u0995\u09b0\u09be\u09b0 \u0995\u09cd\u09b7\u09ae\u09a4\u09be \u09b0\u09be\u0996\u09bf \u098f\u09ac\u0982 \u09a8\u09be \u0995\u09cb\u09a8 \u0995\u09b2\u09cd\u09af\u09be\u09a3 \u0995\u09b0\u09be\u09b0\u0964\u2019","footnotes":""},{"id":"5469","sura":"72","aya":"22","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u0650\u064a \u0644\u064e\u0646 \u064a\u064f\u062c\u0650\u064a\u0631\u064e\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u062d\u064e\u062f\u065e \u0648\u064e\u0644\u064e\u0646\u06e1 \u0623\u064e\u062c\u0650\u062f\u064e \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650\u0647\u0650\u06e6 \u0645\u064f\u0644\u06e1\u062a\u064e\u062d\u064e\u062f\u064b\u0627","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09ac\u09b2\u09cb: \u2018(\u0986\u09ae\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0985\u09ac\u09be\u09a7\u09cd\u09af \u09b9\u09b2\u09c7)\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u0995\u09c7\u0989 \u0986\u09ae\u09be\u0995\u09c7 \u09b0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7 \u09a8\u09be \u098f\u09ac\u0982 \u09a4\u09bf\u09a8\u09bf \u099b\u09be\u09dc\u09be \u0995\u0996\u09a8\u09cb \u0986\u09ae\u09bf \u0995\u09cb\u09a8 \u0986\u09b6\u09cd\u09b0\u09df\u0993 \u09aa\u09be\u09ac\u09cb \u09a8\u09be\u0964\u2019","footnotes":""},{"id":"5470","sura":"72","aya":"23","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u064e\u0670\u063a\u0657\u0627 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u0650\u0633\u064e\u0670\u0644\u064e\u0670\u062a\u0650\u0647\u0650\u06e6\u06da \u0648\u064e\u0645\u064e\u0646 \u064a\u064e\u0639\u06e1\u0635\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5 \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0647\u064f\u06e5 \u0646\u064e\u0627\u0631\u064e \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u062e\u064e\u0670\u0644\u0650\u062f\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u0653 \u0623\u064e\u0628\u064e\u062f\u064b\u0627","translation":"\u2018\u0995\u09c7\u09ac\u09b2 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09ac\u09be\u09a3\u09c0 \u0993 \u09a4\u09be\u0981\u09b0 \u09b0\u09bf\u09b8\u09be\u09b2\u09be\u09a4 \u09aa\u09cc\u0981\u099b\u09be\u09a8\u09cb\u0987 \u0986\u09ae\u09be\u09b0 \u09a6\u09be\u09df\u09bf\u09a4\u09cd\u09ac\u0964 \u0986\u09b0 \u09af\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0993 \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u0995\u09c7 \u0985\u09ae\u09be\u09a8\u09cd\u09af \u0995\u09b0\u09c7, \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09df\u09c7\u099b\u09c7 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u09b0 \u0986\u0997\u09c1\u09a8\u0964 \u09a4\u09be\u09a4\u09c7 \u09a4\u09be\u09b0\u09be \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0 \u09b9\u09ac\u09c7\u0964\u2019","footnotes":""},{"id":"5471","sura":"72","aya":"24","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0627\u0652 \u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0641\u064e\u0633\u064e\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0646\u06e1 \u0623\u064e\u0636\u06e1\u0639\u064e\u0641\u064f \u0646\u064e\u0627\u0635\u0650\u0631\u0657\u0627 \u0648\u064e\u0623\u064e\u0642\u064e\u0644\u0651\u064f \u0639\u064e\u062f\u064e\u062f\u0657\u0627","translation":"\u0985\u09ac\u09b6\u09c7\u09b7\u09c7 \u09af\u0996\u09a8 \u09a4\u09be\u09b0\u09be (\u0995\u09bf\u09af\u09bc\u09be\u09ae\u09a4\u09c7\u09b0) \u09b8\u09c7\u0987 \u09ac\u09bf\u09b7\u09af\u09bc\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u0995\u09cd\u09b7 \u0995\u09b0\u09ac\u09c7, \u09af\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u099c\u09be\u09a8\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7, \u0995\u09be\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u0995\u09be\u09b0\u09c0 \u0985\u09a7\u09bf\u0995 \u09a6\u09c1\u09b0\u09cd\u09ac\u09b2 \u098f\u09ac\u0982 \u0995\u09be\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u0995\u09ae\u0964","footnotes":""},{"id":"5472","sura":"72","aya":"25","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u062f\u06e1\u0631\u0650\u064a\u0653 \u0623\u064e\u0642\u064e\u0631\u0650\u064a\u0628\u065e \u0645\u0651\u064e\u0627 \u062a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0623\u064e\u0645\u06e1 \u064a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f \u0644\u064e\u0647\u064f\u06e5 \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0645\u064e\u062f\u064b\u0627","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2!\u09ac\u09b2\u09cb: \u2018\u0986\u09ae\u09bf (\u09a8\u09bf\u099c\u09c7\u0987) \u099c\u09be\u09a8\u09bf \u09a8\u09be, \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09af\u09be\u09b0 (\u0995\u09bf\u09df\u09be\u09ae\u09a4\u09c7\u09b0) \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf \u09a6\u09c7\u09df\u09be \u09b9\u09df\u09c7\u099b\u09c7, \u09a4\u09be \u0995\u09bf \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0, \u09a8\u09be\u0995\u09bf \u098f\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09b0 \u09b0\u09ac \u0995\u09cb\u09a8 \u09a6\u09c0\u09b0\u09cd\u0998 \u09ae\u09c7\u09df\u09be\u09a6 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09ac\u09c7\u09a8?(\u09e8)","footnotes":"(\u09e8) \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u0995\u0996\u09a8 \u09b8\u0982\u0998\u099f\u09bf\u09a4 \u09b9\u09ac\u09c7, \u09a4\u09be \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09b0 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0987 \u099c\u09be\u09a8\u09c7\u09a8\u0964"},{"id":"5473","sura":"72","aya":"26","arabic_text":"\u0639\u064e\u0670\u0644\u0650\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0644\u064e\u0627 \u064a\u064f\u0638\u06e1\u0647\u0650\u0631\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u063a\u064e\u064a\u06e1\u0628\u0650\u0647\u0650\u06e6\u0653 \u0623\u064e\u062d\u064e\u062f\u064b\u0627","translation":"\u09a4\u09bf\u09a8\u09bf \u09b8\u09ae\u09b8\u09cd\u09a4 \u0985\u09a6\u09c3\u09b6\u09cd\u09af\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8\u09c0, \u0986\u09b0 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u0981\u09b0 \u0985\u09a6\u09c3\u09b6\u09cd\u09af\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u0995\u09be\u09b0\u09cb \u0995\u09be\u099b\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":""},{"id":"5474","sura":"72","aya":"27","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u0650 \u0671\u0631\u06e1\u062a\u064e\u0636\u064e\u0649\u0670 \u0645\u0650\u0646 \u0631\u0651\u064e\u0633\u064f\u0648\u0644\u0656 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u064a\u064e\u0633\u06e1\u0644\u064f\u0643\u064f \u0645\u0650\u0646\u06e2 \u0628\u064e\u064a\u06e1\u0646\u0650 \u064a\u064e\u062f\u064e\u064a\u06e1\u0647\u0650 \u0648\u064e\u0645\u0650\u0646\u06e1 \u062e\u064e\u0644\u06e1\u0641\u0650\u0647\u0650\u06e6 \u0631\u064e\u0635\u064e\u062f\u0657\u0627","translation":"\u09a4\u09ac\u09c7 \u09a4\u09be\u0981\u09b0 \u09ae\u09a8\u09cb\u09a8\u09c0\u09a4 \u09b0\u09be\u09b8\u09c2\u09b2 \u099b\u09be\u09dc\u09be\u0964(\u09e9) \u0986\u09b0 \u09a4\u09bf\u09a8\u09bf \u09a4\u0996\u09a8 \u09a4\u09be\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u0993 \u09a4\u09be\u09b0 \u09aa\u09bf\u099b\u09a8\u09c7 \u09aa\u09cd\u09b0\u09b9\u09b0\u09c0 (\u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be) \u09a8\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c7\u09a8\u0964","footnotes":"(\u09e9) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u09a6\u09c7\u09b0\u0995\u09c7 \u0995\u09cb\u09a8\u09cb \u0995\u09cb\u09a8\u09cb \u0997\u09be\u09df\u09bf\u09ac\u09c7\u09b0 \u09b8\u0982\u09ac\u09be\u09a6 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09c7\u09a8\u0964"},{"id":"5475","sura":"72","aya":"28","arabic_text":"\u0644\u0651\u0650\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064e \u0623\u064e\u0646 \u0642\u064e\u062f\u06e1 \u0623\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0648\u0627\u0652 \u0631\u0650\u0633\u064e\u0670\u0644\u064e\u0670\u062a\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0623\u064e\u062d\u064e\u0627\u0637\u064e \u0628\u0650\u0645\u064e\u0627 \u0644\u064e\u062f\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0648\u064e\u0623\u064e\u062d\u06e1\u0635\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u064e \u0634\u064e\u064a\u06e1\u0621\u064d \u0639\u064e\u062f\u064e\u062f\u064e\u06e2\u0627","translation":"\u09af\u09be\u09a4\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u09aa\u09be\u09af\u09bc \u09af\u09c7, \u09a4\u09be\u09b0\u09be (\u09b0\u09be\u09b8\u09c2\u09b2\u0997\u09a3) \u09a4\u09be\u09a6\u09c7\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u09b8\u09ae\u09c2\u09b9 \u09aa\u09cc\u0981\u099b\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09b0 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09af\u09be \u0986\u099b\u09c7, \u09a4\u09be \u09a4\u09bf\u09a8\u09bf \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3\u09b0\u09c2\u09aa\u09c7 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b7\u09cd\u099f\u09a8 \u0995\u09b0\u09c7 \u09b0\u09c7\u0996\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u09a4\u09bf\u09a8\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u099c\u09bf\u09a8\u09bf\u09b8\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09a8\u09bf\u0996\u09c1\u0981\u09a4\u09ad\u09be\u09ac\u09c7 \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09c7 \u09b0\u09c7\u0996\u09c7\u099b\u09c7\u09a8\u0964","footnotes":""}]}