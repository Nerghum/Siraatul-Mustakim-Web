09a5\u09bf\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964\u2019","footnotes":""},{"id":"5455","sura":"72","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0633\u06e1\u0646\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0641\u064e\u0648\u064e\u062c\u064e\u062f\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u0645\u064f\u0644\u0650\u0626\u064e\u062a\u06e1 \u062d\u064e\u0631\u064e\u0633\u0657\u0627 \u0634\u064e\u062f\u0650\u064a\u062f\u0657\u0627 \u0648\u064e\u0634\u064f\u0647\u064f\u0628\u0657\u0627","translation":"\u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc\u0987 \u0986\u09ae\u09b0\u09be (\u098a\u09b0\u09cd\u09a7\u09cd\u09ac\u099c\u0997\u09a4\u09c7\u09b0 \u09b8\u0982\u09ac\u09be\u09a6 \u099c\u09be\u09a8\u09a4\u09c7 \u099a\u09cb\u09b0\u09be\u0987 \u09aa\u09a5\u09c7) \u0986\u09b8\u09ae\u09be\u09a8\u09c7 \u09aa\u09cc\u0981\u099b\u09be\u09a4\u09c7 \u099a\u09c7\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u09be\u09ae; \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a6\u09c7\u0996\u09b2\u09be\u09ae, \u09a4\u09be \u0995\u09a0\u09cb\u09b0 \u09aa\u09cd\u09b0\u09b9\u09b0\u09c0 \u0993 \u0989\u09b2\u09cd\u0995\u09be\u09aa\u09bf\u09a3\u09cd\u09a1\u09c7 \u09aa\u09b0\u09bf\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09c7 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"5456","sura":"72","aya":"9","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u0642\u06e1\u0639\u064f\u062f\u064f \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0645\u064e\u0642\u064e\u0670\u0639\u0650\u062f\u064e \u0644\u0650\u0644\u0633\u0651\u064e\u0645\u06e1\u0639\u0650\u06d6 \u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0633\u06e1\u062a\u064e\u0645\u0650\u0639\u0650 \u0671\u0644\u06e1\u0623\u0653\u0646\u064e \u064a\u064e\u062c\u0650\u062f\u06e1 \u0644\u064e\u0647\u064f\u06e5 \u0634\u0650\u0647\u064e\u0627\u0628\u06