09b7\u09cd\u099f\u09bf \u09ab\u09c7\u09b0\u09be\u0993, \u0995\u09cb\u09a8\u09cb \u09a4\u09cd\u09b0\u09c1\u099f\u09bf (\u09ab\u09be\u099f\u09b2) \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u0993 \u0995\u09bf?","footnotes":"(\u09e7) \u098f\u0995\u099f\u09bf\u09b0 \u0993\u09aa\u09b0 \u0985\u09aa\u09b0\u099f\u09bf \u09b0\u09c7\u0996\u09c7\u0964"},{"id":"5245","sura":"67","aya":"4","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0631\u06e1\u062c\u0650\u0639\u0650 \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064e \u0643\u064e\u0631\u0651\u064e\u062a\u064e\u064a\u06e1\u0646\u0650 \u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u06e1 \u0625\u0650\u0644\u064e\u064a\u06e1\u0643\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f \u062e\u064e\u0627\u0633\u0650\u0626\u0657\u0627 \u0648\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0633\u0650\u064a\u0631\u065e","translation":"\u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09c1\u09ae\u09bf \u09ac\u09be\u09b0\u09ac\u09be\u09b0 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf \u09ab\u09c7\u09b0\u09be\u0993, \u09b8\u09c7\u0987 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf \u09b2\u09be\u099e\u09cd\u099b\u09bf\u09a4 \u0993 \u0995\u09cd\u09b2\u09be\u09a8\u09cd\u09a4 \u09b9\u09df\u09c7 (\u09e8) \u09a4\u09cb\u09ae\u09be\u09b0 \u09a6\u09bf\u0995\u09c7\u0987 \u09ab\u09bf\u09b0\u09c7 \u0986\u09b8\u09ac\u09c7 \u0964","footnotes":"(\u09e8) \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf\u09a4\u09c7 \u0995\u09cb\u09a8\u09b0\u09c2\u09aa \u09a6\u09cb\u09b7-\u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u09a6\u09c7\u0996\u09be \u09ac\u09cd\u09af\u09a4\u09bf\u09b0\u09c7\u0995\u09c7"},{"id":"5246","sura":"67","aya":"5","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0632\u064e\u064a\u0651\u064e\u0646\u0651\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627 \u0628\u0650\u0645\u064e\u0635\u064e\u0670\u0628\u0650\u064a\u062d\u064e \u