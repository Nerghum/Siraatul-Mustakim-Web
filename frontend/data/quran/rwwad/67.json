{"result":[{"id":"5242","sura":"67","aya":"1","arabic_text":"\u062a\u064e\u0628\u064e\u0670\u0631\u064e\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0628\u0650\u064a\u064e\u062f\u0650\u0647\u0650 \u0671\u0644\u06e1\u0645\u064f\u0644\u06e1\u0643\u064f \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0656 \u0642\u064e\u062f\u0650\u064a\u0631\u064c","translation":"\u09ac\u09b0\u0995\u09a4\u09ae\u09df \u0993 \u09ae\u09b9\u09bf\u09ae\u09be\u09a8\u09cd\u09ac\u09bf\u09a4 \u09b8\u09c7\u0987 \u09b8\u09a4\u09cd\u09a4\u09cd\u09ac\u09be (\u0986\u09b2\u09cd\u09b2\u09be\u09b9), \u09af\u09be\u0981\u09b0 \u09b9\u09be\u09a4\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u09b8\u09b0\u09cd\u09ac\u09ae\u09df \u0995\u09b0\u09cd\u09a4\u09c3\u09a4\u09cd\u09ac \u0993 \u09b0\u09be\u099c\u09a4\u09cd\u09ac\u0964 \u0986\u09b0 \u09a4\u09bf\u09a8\u09bf \u09b8\u09ac \u0995\u09bf\u099b\u09c1\u09b0 \u0993\u09aa\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u0995\u09cd\u09a4\u09bf\u09ae\u09be\u09a8\u0964","footnotes":""},{"id":"5243","sura":"67","aya":"2","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0644\u0650\u064a\u064e\u0628\u06e1\u0644\u064f\u0648\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0643\u064f\u0645\u06e1 \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f \u0639\u064e\u0645\u064e\u0644\u0657\u0627\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u064f \u0671\u0644\u06e1\u063a\u064e\u0641\u064f\u0648\u0631\u064f","translation":"\u09af\u09bf\u09a8\u09bf \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u0993 \u099c\u09c0\u09ac\u09a8 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u09af\u09be\u09a4\u09c7 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\