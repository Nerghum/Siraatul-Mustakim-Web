9\u06e1\u0644\u064e\u0649\u0670","translation":"(\u09b8\u09c7 \u09b8\u09cd\u09ac\u09c0\u09df \u09b8\u09ae\u09cd\u09aa\u09a6 \u09ac\u09cd\u09af\u09df \u0995\u09b0\u09c7) \u0995\u09c7\u09ac\u09b2 \u09a4\u09be\u09b0 \u09ae\u09b9\u09be\u09a8 \u09b0\u09ac\u09c7\u09b0 \u099a\u09c7\u09b9\u09be\u09b0\u09be \u09a6\u09c7\u0996\u09be\u09b0 (\u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f\u09bf\u09b0) \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b6\u09be\u09df\u0964","footnotes":""},{"id":"6079","sura":"92","aya":"21","arabic_text":"\u0648\u064e\u0644\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670","translation":"\u0986\u09b0 \u0985\u099a\u09bf\u09b0\u09c7\u0987 \u09b8\u09c7 (\u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u099c\u09a8\u0995 \u098f \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u09b2\u09be\u09ad\u09c7) \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09b9\u09ac\u09c7\u0964","footnotes":""}]}