 \u09aa\u09b0\u09cd\u09ac\u09a4\u09ae\u09be\u09b2\u09be \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c7\u099b\u09bf(\u09eb) \u098f\u09ac\u0982 \u09a4\u09be\u09a4\u09c7 \u0986\u09ae\u09bf \u0989\u09a6\u09cd\u200c\u0997\u09a4 \u0995\u09b0\u09c7\u099b\u09bf \u09b8\u09ac \u09a7\u09b0\u09a8\u09c7\u09b0 \u099a\u09cb\u0996 \u099c\u09c1\u09dc\u09be\u09a8\u09cb \u0989\u09a6\u09cd\u09ad\u09bf\u09a6\u0964","footnotes":"(\u09eb) \u09af\u09be\u09a4\u09c7 \u099c\u09ae\u09bf\u09a8 \u09a8\u09dc\u09be\u099a\u09dc\u09be \u09a8\u09be \u0995\u09b0\u09c7\u0964"},{"id":"4638","sura":"50","aya":"8","arabic_text":"\u062a\u064e\u0628\u06e1\u0635\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0639\u064e\u0628\u06e1\u062f\u0656 \u0645\u0651\u064f\u0646\u0650\u064a\u0628\u0656","translation":"(\u0986\u09ae\u09bf \u098f \u09b8\u09ac \u098f \u099c\u09a8\u09cd\u09af \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf) \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0985\u09ad\u09bf\u09ae\u09c1\u0996\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u099c\u09cd\u099e\u09be\u09a8 \u0993 \u0989\u09aa\u09a6\u09c7\u09b6 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7\u0964","footnotes":""},{"id":"4639","sura":"50","aya":"9","arabic_text":"\u0648\u064e\u0646\u064e\u0632\u0651\u064e\u0644\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0645\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u064f\u0628\u064e\u0670\u0631\u064e\u0643\u0657\u0627 \u0641\u064e\u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u06e1\u0646\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u0648\u064e\u062d\u064e\u0628\u0651\u064e \u0671\u0644\u06e1\u062d\u064e\u0635\u0650\u064a\u062f\u0650","translation":"\u0986\u09b0 \u0986\u09ae\u09bf \u0986\u09b8\u09ae\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09ac\u09b0\u0995\u09a4\u09ae\u09df (\u09ac\u09c3\u09b7\u09cd\u099f\u09bf\u09b0) \u09aa\u09be\u09a8\u09bf \u09a8\u09be\u09af\u09bf\u09b2 \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09be \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0986\u09ae\u09bf \u0989\u09ce\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09bf \u09ac\u09be\u0997-\u09ac\u09be\u0997\u09bf\u099a\u09be \u0993 \u0995\u09b0\u09cd\u09a4\u09a8\u09af\u09cb\u0997\u09cd\u09af \u09b6\u09b8\u09cd\u09af\u09a6\u09be\u09a8\u09be\u0964","footnotes":""},{"id":"4640","sura":"50","aya":"10","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u062e\u06e1\u0644\u064e \u0628\u064e\u0627\u0633\u0650\u0642\u064e\u0670\u062a\u0656 \u0644\u0651\u064e\u0647\u064e\u0627 \u0637\u064e\u0644\u06e1\u0639\u065e \u0646\u0651\u064e\u0636\u0650\u064a\u062f\u065e","translation":"(\u0986\u09b0\u09cb \u0989\u09ce\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09bf) \u0989\u0981\u099a\u09c1 \u0989\u0981\u099a\u09c1 \u0996\u09c7\u099c\u09c1\u09b0\u0997\u09be\u099b, \u09af\u09be\u09a4\u09c7 \u0986\u099b\u09c7 \u0997\u09c1\u099a\u09cd\u099b \u0997\u09c1\u099a\u09cd\u099b \u0996\u09c7\u099c\u09c1\u09b0 \u099b\u09dc\u09be,","footnotes":""},{"id":"4641","sura":"50","aya":"11","arabic_text":"\u0631\u0651\u0650\u0632\u06e1\u0642\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0639\u0650\u0628\u064e\u0627\u062f\u0650\u06d6 \u0648\u064e\u0623\u064e\u062d\u06e1\u064a\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0628\u064e\u0644\u06e1\u062f\u064e\u0629\u0657 \u0645\u0651\u064e\u064a\u06e1\u062a\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u062e\u064f\u0631\u064f\u0648\u062c\u064f","translation":"(\u0986\u09ae\u09bf \u098f\u0997\u09c1\u09b2\u09cb \u0989\u09ce\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09bf) \u0986\u09ae\u09be\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09bf\u09af\u0995\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa\u0964 \u0986\u09b0 \u0986\u09ae\u09bf \u09aa\u09be\u09a8\u09bf \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09ae\u09c3\u09a4 \u09b6\u09b9\u09b0 \u09b8\u099e\u09cd\u099c\u09c0\u09ac\u09bf\u09a4 \u0995\u09b0\u09bf\u0964 \u098f\u09ad\u09be\u09ac\u09c7\u0987 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8 \u0998\u099f\u09ac\u09c7\u0964","footnotes":""},{"id":"4642","sura":"50","aya":"12","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0642\u064e\u0648\u06e1\u0645\u064f \u0646\u064f\u0648\u062d\u0656 \u0648\u064e\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0631\u0651\u064e\u0633\u0651\u0650 \u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064f","translation":"\u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 (\u09a8\u09ac\u09c0\u09a6\u09c7\u09b0\u0995\u09c7) \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09b0\u09cb\u09aa \u0995\u09b0\u09c7\u099b\u09bf\u09b2 \u09a8\u09c2\u09b9\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df, \u09b0\u09be\u09b8\u09cd \u098f\u09b0 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c0 \u0993 \u09b8\u09be\u09ae\u09c2\u09a6 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0964","footnotes":""},{"id":"4643","sura":"50","aya":"13","arabic_text":"\u0648\u064e\u0639\u064e\u0627\u062f\u065e \u0648\u064e\u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064f \u0648\u064e\u0625\u0650\u062e\u06e1\u0648\u064e\u0670\u0646\u064f \u0644\u064f\u0648\u0637\u0656","translation":"(\u0985\u09a8\u09c1\u09b0\u09c2\u09aa\u09ad\u09be\u09ac\u09c7) \u2018\u0986\u09a6, \u09ab\u09bf\u09b0\u2018\u0986\u0989\u09a8 \u0993 \u09b2\u09c2\u09a4 \u099c\u09be\u09a4\u09bf (\u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09b0\u09cb\u09aa \u0995\u09b0\u09c7\u099b\u09c7)\u0964","footnotes":""},{"id":"4644","sura":"50","aya":"14","arabic_text":"\u0648\u064e\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u06e1\u0623\u064e\u064a\u06e1\u0643\u064e\u0629\u0650 \u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064f \u062a\u064f\u0628\u0651\u064e\u0639\u0656\u06da \u0643\u064f\u0644\u0651\u065e \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0671\u0644\u0631\u0651\u064f\u0633\u064f\u0644\u064e \u0641\u064e\u062d\u064e\u0642\u0651\u064e \u0648\u064e\u0639\u0650\u064a\u062f\u0650","translation":"\u0986\u0987\u0995\u09be\u09b0 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c0 \u0993 \u09a4\u09c1\u09ac\u09ac\u09be\u2018 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0964 \u09b8\u0995\u09b2\u09c7\u0987 \u09b0\u09be\u09b8\u09c2\u09b2\u09a6\u09c7\u09b0\u0995\u09c7 \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09ac\u09be\u09a6\u09c0 \u09ac\u09b2\u09c7\u099b\u09bf\u09b2\u0964 \u09ab\u09b2\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0993\u09aa\u09b0 \u0986\u09ae\u09be\u09b0 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09af\u09a5\u09be\u09b0\u09cd\u09a5\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a4\u09bf\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"4645","sura":"50","aya":"15","arabic_text":"\u0623\u064e\u0641\u064e\u0639\u064e\u064a\u0650\u064a\u0646\u064e\u0627 \u0628\u0650\u0671\u0644\u06e1\u062e\u064e\u0644\u06e1\u0642\u0650 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u06da \u0628\u064e\u0644\u06e1 \u0647\u064f\u0645\u06e1 \u0641\u0650\u064a \u0644\u064e\u0628\u06e1\u0633\u0656 \u0645\u0651\u0650\u0646\u06e1 \u062e\u064e\u0644\u06e1\u0642\u0656 \u062c\u064e\u062f\u0650\u064a\u062f\u0656","translation":"\u0986\u09ae\u09bf \u0995\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u0987 \u0995\u09cd\u09b2\u09be\u09a8\u09cd\u09a4 \u09b9\u09df\u09c7 \u09aa\u09dc\u09c7\u099b\u09bf?(\u09ec) \u09ac\u09b0\u0982 \u09a4\u09be\u09b0\u09be \u09a8\u09a4\u09c1\u09a8 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf\u09b0 \u09ac\u09bf\u09b7\u09df\u09c7 \u09b8\u09a8\u09cd\u09a6\u09c7\u09b9\u09c7 \u09a8\u09bf\u09aa\u09a4\u09bf\u09a4\u0964","footnotes":"(\u09ec) \u09ab\u09b2\u09c7 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8\u09c7 \u0986\u09ae\u09bf \u0995\u09bf \u0985\u09aa\u09be\u09b0\u0997 \u09b9\u09ac\u09cb!"},{"id":"4646","sura":"50","aya":"16","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0648\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0627 \u062a\u064f\u0648\u064e\u0633\u06e1\u0648\u0650\u0633\u064f \u0628\u0650\u0647\u0650\u06e6 \u0646\u064e\u0641\u06e1\u0633\u064f\u0647\u064f\u06e5\u06d6 \u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u06e1 \u062d\u064e\u0628\u06e1\u0644\u0650 \u0671\u0644\u06e1\u0648\u064e\u0631\u0650\u064a\u062f\u0650","translation":"\u0986\u09b0 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0986\u09ae\u09bf \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf \u09a4\u09be\u0995\u09c7 \u09af\u09c7 \u0995\u09c1\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be \u09a6\u09c7\u09df \u09a4\u09be\u0993 \u0986\u09ae\u09bf \u099c\u09be\u09a8\u09bf\u0964 \u0986\u09b0 \u0986\u09ae\u09bf \u09a4\u09be\u09b0 \u0997\u09b2\u09be\u09b0 \u09a7\u09ae\u09a8\u09bf \u09b9\u09a4\u09c7\u0993 \u0985\u09a7\u09bf\u0995 \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0\u0964(\u09ed)","footnotes":"(\u09ed) \u098f\u0996\u09be\u09a8\u09c7 \u0646\u062d\u0646 \u09ac\u09be \u2018\u0986\u09ae\u09b0\u09be\u2019 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a8\u09bf\u099c\u09c7\u0995\u09c7 \u09ac\u09be \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09c1\u099d\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09b9\u09b2\u09c7 \u0985\u09b0\u09cd\u09a5, \u09ae\u09b9\u09be\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u099c\u09cd\u099e\u09be\u09a8\u09c7\u09b0 \u09ac\u09cd\u09af\u09aa\u09cd\u09a4\u09bf \u098f\u09a4 \u09ac\u09c7\u09b6\u09bf \u09af\u09c7, \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09b0 \u0997\u09b2\u09be\u09b0 \u09a7\u09ae\u09a8\u09c0 \u09b9\u09a4\u09c7\u0993 \u0985\u09a7\u09bf\u0995 \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b9\u09df\u09c7\u0987 \u09a4\u09be\u0995\u09c7 \u09aa\u09b0\u09cd\u09af\u09ac\u09c7\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c7\u09a8\u0964 \u0986\u09b0 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be \u09b9\u09b2\u09c7 \u09a4\u09be\u09b0\u09be \u09a4\u09cb \u09b8\u09a6\u09be\u09b8\u09b0\u09cd\u09ac\u09a6\u09be \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7\u0987 \u09a5\u09be\u0995\u09c7\u09a8\u0964[\u0987\u09ac\u09a8\u09c1 \u0995\u09be\u09b8\u09c0\u09b0]"},{"id":"4647","sura":"50","aya":"17","arabic_text":"\u0625\u0650\u0630\u06e1 \u064a\u064e\u062a\u064e\u0644\u064e\u0642\u0651\u064e\u0649 \u0671\u0644\u06e1\u0645\u064f\u062a\u064e\u0644\u064e\u0642\u0651\u0650\u064a\u064e\u0627\u0646\u0650 \u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0642\u064e\u0639\u0650\u064a\u062f\u065e","translation":"\u09af\u0996\u09a8 \u09a1\u09be\u09a8\u09c7 \u0993 \u09ac\u09be\u09ae\u09c7 \u09ac\u09b8\u09be \u09a6\u09c1\u2019\u099c\u09a8 \u09b2\u09bf\u09aa\u09bf\u09ac\u09a6\u09cd\u09a7\u0995\u09be\u09b0\u09c0 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0 (\u09a4\u09be\u09b0 \u0986\u09ae\u09b2\u09a8\u09be\u09ae\u09be) \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09ac\u09c7\u0964","footnotes":""},{"id":"4648","sura":"50","aya":"18","arabic_text":"\u0645\u0651\u064e\u0627 \u064a\u064e\u0644\u06e1\u0641\u0650\u0638\u064f \u0645\u0650\u0646 \u0642\u064e\u0648\u06e1\u0644\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0644\u064e\u062f\u064e\u064a\u06e1\u0647\u0650 \u0631\u064e\u0642\u0650\u064a\u0628\u064c \u0639\u064e\u062a\u0650\u064a\u062f\u065e","translation":"\u09b8\u09c7 \u09af\u09c7 \u0995\u09a5\u09be\u0987 \u0989\u099a\u09cd\u099a\u09be\u09b0\u09a3 \u0995\u09b0\u09c7 \u09a4\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09b8\u09a6\u09be \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3\u0995\u09be\u09b0\u09c0 (\u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be) \u09b0\u09df\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"4649","sura":"50","aya":"19","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e\u062a\u06e1 \u0633\u064e\u0643\u06e1\u0631\u064e\u0629\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u0650 \u0628\u0650\u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650\u06d6 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062a\u064e\u062d\u0650\u064a\u062f\u064f","translation":"\u0986\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09af\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be \u09b8\u09a4\u09cd\u09af\u09b8\u09b9 \u098f\u09b8\u09c7 \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964 (\u09a4\u0996\u09a8 \u09ac\u09b2\u09be \u09b9\u09ac\u09c7,) \u2018\u098f\u099f\u09be\u0987 \u09a4\u09cb, \u09af\u09be \u09a5\u09c7\u0995\u09c7 \u09a4\u09c1\u09ae\u09bf \u09aa\u09b2\u09be\u09af\u09bc\u09a8 \u0995\u09b0\u09c7 \u09ac\u09c7\u09a1\u09bc\u09be\u09a4\u09c7\u0964\u2019","footnotes":""},{"id":"4650","sura":"50","aya":"20","arabic_text":"\u0648\u064e\u0646\u064f\u0641\u0650\u062e\u064e \u0641\u0650\u064a \u0671\u0644\u0635\u0651\u064f\u0648\u0631\u0650\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0648\u064e\u0639\u0650\u064a\u062f\u0650","translation":"\u0986\u09b0 \u09b6\u09bf\u0982\u0997\u09be\u09df \u09ab\u09c1\u0981\u0995 \u09a6\u09c7\u09df\u09be \u09b9\u09ac\u09c7\u0964 \u098f\u099f\u09be\u0987 \u09b9\u09b2 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0 \u09a6\u09bf\u09a8\u0964","footnotes":""},{"id":"4651","sura":"50","aya":"21","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e\u062a\u06e1 \u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0656 \u0645\u0651\u064e\u0639\u064e\u0647\u064e\u0627 \u0633\u064e\u0627\u0653\u0626\u0650\u0642\u065e \u0648\u064e\u0634\u064e\u0647\u0650\u064a\u062f\u065e","translation":"\u0986\u09b0 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0987 \u09b8\u09c7\u09a6\u09bf\u09a8 \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b9\u09ac\u09c7, \u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a5\u09be\u0995\u09ac\u09c7 \u099a\u09be\u09b2\u0995 \u098f\u0995\u099c\u09a8 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be \u0993 \u098f\u0995\u099c\u09a8 \u09b8\u09be\u0995\u09cd\u09b7\u09c0\u0964","footnotes":""},{"id":"4652","sura":"50","aya":"22","arabic_text":"\u0644\u0651\u064e\u0642\u064e\u062f\u06e1 \u0643\u064f\u0646\u062a\u064e \u0641\u0650\u064a \u063a\u064e\u0641\u06e1\u0644\u064e\u0629\u0656 \u0645\u0651\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0641\u064e\u0643\u064e\u0634\u064e\u0641\u06e1\u0646\u064e\u0627 \u0639\u064e\u0646\u0643\u064e \u063a\u0650\u0637\u064e\u0627\u0653\u0621\u064e\u0643\u064e \u0641\u064e\u0628\u064e\u0635\u064e\u0631\u064f\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u062d\u064e\u062f\u0650\u064a\u062f\u065e","translation":"(\u09ee)\u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09a4\u09c1\u09ae\u09bf \u098f \u09a6\u09bf\u09ac\u09b8 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u0989\u09a6\u09be\u09b8\u09c0\u09a8 \u099b\u09bf\u09b2\u09c7\u0964 \u0985\u09a4\u098f\u09ac \u0986\u09ae\u09bf \u09a4\u09cb\u09ae\u09be\u09b0 (\u0989\u09a6\u09be\u09b8\u09c0\u09a8\u09a4\u09be\u09b0) \u09aa\u09b0\u09cd\u09a6\u09be \u09a4\u09cb\u09ae\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u0989\u09a8\u09cd\u09ae\u09cb\u099a\u09a8 \u0995\u09b0\u09c7 \u09a6\u09bf\u09b2\u09be\u09ae\u0964 \u09ab\u09b2\u09c7 \u0986\u099c \u09a4\u09cb\u09ae\u09be\u09b0 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf \u0996\u09c1\u09ac \u09aa\u09cd\u09b0\u0996\u09b0\u0964","footnotes":"(\u09ee) \u09a4\u09be\u0995\u09c7 \u09ac\u09b2\u09be \u09b9\u09ac\u09c7: \u09ac\u09bf\u09ad\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09bf, \u09ae\u09a8\u09cb\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf \u0993 \u09ad\u09cb\u0997-\u09ac\u09bf\u09b2\u09be\u09b8\u09c7 \u09b2\u09bf\u09aa\u09cd\u09a4 \u09a5\u09c7\u0995\u09c7\u0964"},{"id":"4653","sura":"50","aya":"23","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0642\u064e\u0631\u0650\u064a\u0646\u064f\u0647\u064f\u06e5 \u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u0627 \u0644\u064e\u062f\u064e\u064a\u0651\u064e \u0639\u064e\u062a\u0650\u064a\u062f\u064c","translation":"\u0986\u09b0 \u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c0 (\u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be) \u09ac\u09b2\u09ac\u09c7, \u098f\u0987 \u09a4\u09cb \u0986\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 (\u09a4\u09cb\u09ae\u09be\u09b0 \u0986\u09ae\u09b2\u09a8\u09be\u09ae\u09be) \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u0964","footnotes":""},{"id":"4654","sura":"50","aya":"24","arabic_text":"\u0623\u064e\u0644\u06e1\u0642\u0650\u064a\u064e\u0627 \u0641\u0650\u064a \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0643\u064f\u0644\u0651\u064e \u0643\u064e\u0641\u0651\u064e\u0627\u0631\u064d \u0639\u064e\u0646\u0650\u064a\u062f\u0656","translation":"(\u09ef)\u09a4\u09cb\u09ae\u09b0\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7 \u09a8\u09bf\u0995\u09cd\u09b7\u09c7\u09aa \u0995\u09b0\u09cb \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u0989\u09a6\u09cd\u09a7\u09a4 \u0995\u09be\u09ab\u09bf\u09b0\u0995\u09c7,","footnotes":"(\u09ef) \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u099a\u09be\u09b2\u09a8\u09be\u0995\u09be\u09b0\u09c0 \u0993 \u09b8\u09be\u0995\u09cd\u09b7\u09cd\u09af\u09a6\u09be\u09a4\u09be \u0989\u09ad\u09df \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u0995\u09c7 \u09ac\u09b2\u09ac\u09c7\u09a8:"},{"id":"4655","sura":"50","aya":"25","arabic_text":"\u0645\u0651\u064e\u0646\u0651\u064e\u0627\u0639\u0656 \u0644\u0651\u0650\u0644\u06e1\u062e\u064e\u064a\u06e1\u0631\u0650 \u0645\u064f\u0639\u06e1\u062a\u064e\u062f\u0656 \u0645\u0651\u064f\u0631\u0650\u064a\u0628\u064d","translation":"\u0995\u09b2\u09cd\u09af\u09be\u09a3\u0995\u09b0 \u0995\u09be\u099c\u09c7 \u09aa\u09cd\u09b0\u09ac\u09b2 \u09ac\u09be\u09a7\u09be\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0 \u09b8\u09c0\u09ae\u09be\u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0, \u09b8\u09a8\u09cd\u09a6\u09c7\u09b9 \u09aa\u09cb\u09b7\u09a3\u0995\u09be\u09b0\u09c0\u0995\u09c7\u0964","footnotes":""},{"id":"4656","sura":"50","aya":"26","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062c\u064e\u0639\u064e\u0644\u064e \u0645\u064e\u0639\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0644\u064e\u0670\u0647\u064b\u0627 \u0621\u064e\u0627\u062e\u064e\u0631\u064e \u0641\u064e\u0623\u064e\u0644\u06e1\u0642\u0650\u064a\u064e\u0627\u0647\u064f \u0641\u0650\u064a \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0671\u0644\u0634\u0651\u064e\u062f\u0650\u064a\u062f\u0650","translation":"\u09af\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a8\u09cd\u09af \u0987\u09b2\u09be\u09b9 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7\u099b\u09bf\u09b2, \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be\u0995\u09c7 \u0995\u09a0\u09bf\u09a8 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09a4\u09c7 \u09a8\u09bf\u0995\u09cd\u09b7\u09c7\u09aa \u0995\u09b0\u09cb\u0964","footnotes":""},{"id":"4657","sura":"50","aya":"27","arabic_text":"\u06de\u00a0\u0642\u064e\u0627\u0644\u064e \u0642\u064e\u0631\u0650\u064a\u0646\u064f\u0647\u064f\u06e5 \u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627 \u0645\u064e\u0627\u0653 \u0623\u064e\u0637\u06e1\u063a\u064e\u064a\u06e1\u062a\u064f\u0647\u064f\u06e5 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0650\u06ed \u0628\u064e\u0639\u0650\u064a\u062f\u0656","translation":"\u09a4\u09be\u09b0 \u09b8\u0999\u09cd\u0997\u09c0 (\u09b6\u09df\u09a4\u09be\u09a8) \u09ac\u09b2\u09ac\u09c7: \u2018\u09b9\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b0\u09ac! \u0986\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u09ac\u09bf\u09a6\u09cd\u09b0\u09cb\u09b9\u09c0 \u0995\u09b0\u09c7 \u09a4\u09c1\u09b2\u09bf\u09a8\u09bf; \u09ac\u09b0\u0982 \u09b8\u09c7 \u09a8\u09bf\u099c\u09c7\u0987 \u099b\u09bf\u09b2 \u09b8\u09c1\u09a6\u09c2\u09b0 \u09aa\u09a5\u09ad\u09cd\u09b0\u09b7\u09cd\u099f\u09a4\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7\u0964\u2019","footnotes":""},{"id":"4658","sura":"50","aya":"28","arabic_text":"\u0642\u064e\u0627\u0644\u064e \u0644\u064e\u0627 \u062a\u064e\u062e\u06e1\u062a\u064e\u0635\u0650\u0645\u064f\u0648\u0627\u0652 \u0644\u064e\u062f\u064e\u064a\u0651\u064e \u0648\u064e\u0642\u064e\u062f\u06e1 \u0642\u064e\u062f\u0651\u064e\u0645\u06e1\u062a\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0643\u064f\u0645 \u0628\u0650\u0671\u0644\u06e1\u0648\u064e\u0639\u0650\u064a\u062f\u0650","translation":"\u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09ac\u09b2\u09ac\u09c7\u09a8: \u2018\u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09ac\u09be\u0995-\u09ac\u09bf\u09a4\u09a3\u09cd\u09a1\u09be \u0995\u09b0\u09cb \u09a8\u09be\u0964 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0986\u09ae\u09bf \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7\u0987 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09a4\u09b0\u09cd\u0995 \u0995\u09b0\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09bf\u09b2\u09be\u09ae\u0964\u2019","footnotes":""},{"id":"4659","sura":"50","aya":"29","arabic_text":"\u0645\u064e\u0627 \u064a\u064f\u0628\u064e\u062f\u0651\u064e\u0644\u064f \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0644\u064f \u0644\u064e\u062f\u064e\u064a\u0651\u064e \u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u064e\u0627\u06e0 \u0628\u0650\u0638\u064e\u0644\u0651\u064e\u0670\u0645\u0656 \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0628\u0650\u064a\u062f\u0650","translation":"\u2018\u0986\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u0995\u09a5\u09be (\u0993 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0) \u09b0\u09a6\u09ac\u09a6\u09b2 \u09b9\u09df \u09a8\u09be\u0964 \u0986\u09b0 \u0986\u09ae\u09bf (\u09e7\u09e6) \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09af\u09c1\u09b2\u09c1\u09ae\u0995\u09be\u09b0\u09c0\u0993 \u09a8\u0987\u0964\u2019","footnotes":"(\u09e7\u09e6) \u0995\u09be\u09b0\u09cb \u09aa\u09c1\u09a3\u09cd\u09af \u0995\u09ae\u09bf\u09df\u09c7 \u0995\u09bf\u0982\u09ac\u09be \u09aa\u09be\u09aa \u09ac\u09be\u09dc\u09bf\u09df\u09c7\u0964"},{"id":"4660","sura":"50","aya":"30","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u0646\u064e\u0642\u064f\u0648\u0644\u064f \u0644\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0647\u064e\u0644\u0650 \u0671\u0645\u06e1\u062a\u064e\u0644\u064e\u0623\u06e1\u062a\u0650 \u0648\u064e\u062a\u064e\u0642\u064f\u0648\u0644\u064f \u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064e\u0632\u0650\u064a\u062f\u0656","translation":"\u09b8\u09c7\u09a6\u09bf\u09a8 \u0986\u09ae\u09bf \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u0995\u09c7 \u09ac\u09b2\u09ac\u09cb: \u2018\u09a4\u09c1\u09ae\u09bf \u0995\u09bf \u09aa\u09b0\u09bf\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b9\u09df\u09c7\u099b?\u2019 \u0986\u09b0 \u09b8\u09c7 \u09ac\u09b2\u09ac\u09c7: \u2018\u0986\u09b0\u09cb \u09ac\u09c7\u09b6\u09bf \u0986\u099b\u09c7 \u0995\u09bf?\u2019","footnotes":""},{"id":"4661","sura":"50","aya":"31","arabic_text":"\u0648\u064e\u0623\u064f\u0632\u06e1\u0644\u0650\u0641\u064e\u062a\u0650 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u063a\u064e\u064a\u06e1\u0631\u064e \u0628\u064e\u0639\u0650\u064a\u062f\u064d","translation":"\u0986\u09b0 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u0995\u09c7 \u09ae\u09c1\u09a4\u09cd\u09a4\u09be\u0995\u09c0\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7, (\u09b8\u09c7\u09a6\u09bf\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u09c7 \u09a4\u09be) \u09ae\u09cb\u099f\u09c7\u0987 \u09a6\u09c2\u09b0\u09c7 \u09a5\u09be\u0995\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":""},{"id":"4662","sura":"50","aya":"32","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u0627 \u062a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0623\u064e\u0648\u0651\u064e\u0627\u0628\u064d \u062d\u064e\u0641\u0650\u064a\u0638\u0656","translation":"\u098f\u099f\u09be\u0987, \u09af\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c7\u09df\u09be \u09b9\u09df\u09c7\u099b\u09bf\u09b2, \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0985\u09ad\u09bf\u09ae\u09c1\u0996\u09c0 (\u09a4\u09be\u0981\u09b0 \u09ac\u09bf\u09a7\u09be\u09a8\u09c7\u09b0) \u0985\u09a7\u09bf\u0995 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3\u09b6\u09c0\u09b2\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u0964","footnotes":""},{"id":"4663","sura":"50","aya":"33","arabic_text":"\u0645\u0651\u064e\u0646\u06e1 \u062e\u064e\u0634\u0650\u064a\u064e \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0628\u0650\u0642\u064e\u0644\u06e1\u0628\u0656 \u0645\u0651\u064f\u0646\u0650\u064a\u0628\u064d","translation":"\u09af\u09c7 \u09a8\u09be \u09a6\u09c7\u0996\u09c7\u0987 \u09b0\u09b9\u09ae\u09be\u09a8\u0995\u09c7 \u09ad\u09df \u0995\u09b0\u09a4 \u098f\u09ac\u0982 \u09ac\u09bf\u09a8\u09c0\u09a4 \u09b9\u09c3\u09a6\u09df\u09c7 (\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09be\u099b\u09c7) \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4 \u09b9\u09a4\u09cb\u0964","footnotes":""},{"id":"4664","sura":"50","aya":"34","arabic_text":"\u0671\u062f\u06e1\u062e\u064f\u0644\u064f\u0648\u0647\u064e\u0627 \u0628\u0650\u0633\u064e\u0644\u064e\u0670\u0645\u0656\u06d6 \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062e\u064f\u0644\u064f\u0648\u062f\u0650","translation":"(\u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09be \u09b9\u09ac\u09c7,) \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09be\u09a4\u09c7 \u09b6\u09be\u09a8\u09cd\u09a4\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09cb\u0964 \u098f\u099f\u09be \u0985\u09a8\u09a8\u09cd\u09a4 \u099c\u09c0\u09ac\u09a8\u09c7\u09b0 \u09a6\u09bf\u09a8\u0964\u2019","footnotes":""},{"id":"4665","sura":"50","aya":"35","arabic_text":"\u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064e\u064a\u06e1\u0646\u064e\u0627 \u0645\u064e\u0632\u0650\u064a\u062f\u065e","translation":"\u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u09a4\u09be\u09b0\u09be \u09af\u09be \u099a\u09be\u0987\u09ac\u09c7, \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a4\u09be\u0987 \u09a5\u09be\u0995\u09ac\u09c7 \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u0986\u09b0\u0993 \u0985\u09a7\u09bf\u0995\u0964(\u09e7\u09e7)","footnotes":"(\u09e7\u09e7) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u0986\u09b0 \u0986\u09ae\u09be\u09b0 \u09a8\u09bf\u0995\u099f \u09b0\u09df\u09c7\u099b\u09c7 \u098f\u09ae\u09a8 \u09b8\u09ac \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a8\u09bf\u2018\u0986\u09ae\u09a4 \u09af\u09be \u0995\u09cb\u09a8 \u099a\u0995\u09cd\u09b7\u09c1 \u09a6\u09c7\u0996\u09c7\u09a8\u09bf, \u0995\u09cb\u09a8 \u0995\u09be\u09a8 \u09b6\u09cd\u09b0\u09ac\u09a3 \u0995\u09b0\u09c7\u09a8\u09bf, \u0986\u09b0 \u09a8\u09be \u0995\u09cb\u09a8 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0 \u09a4\u09be \u09b9\u09c3\u09a6\u09df\u0999\u09cd\u0997\u09ae \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u09a4\u09a8\u09cd\u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09b9\u09be\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a6\u09b0\u09cd\u09b6\u09a8 \u0985\u09a8\u09cd\u09af\u09a4\u09ae\u0964"},{"id":"4666","sura":"50","aya":"36","arabic_text":"\u0648\u064e\u0643\u064e\u0645\u06e1 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u06e1\u0646\u064e\u0627 \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0642\u064e\u0631\u06e1\u0646\u064d \u0647\u064f\u0645\u06e1 \u0623\u064e\u0634\u064e\u062f\u0651\u064f \u0645\u0650\u0646\u06e1\u0647\u064f\u0645 \u0628\u064e\u0637\u06e1\u0634\u0657\u0627 \u0641\u064e\u0646\u064e\u0642\u0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0671\u0644\u06e1\u0628\u0650\u0644\u064e\u0670\u062f\u0650 \u0647\u064e\u0644\u06e1 \u0645\u0650\u0646 \u0645\u0651\u064e\u062d\u0650\u064a\u0635\u064d","translation":"\u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 (\u09e7\u09e8) \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09ac\u09b9\u09c1 \u09aa\u09cd\u09b0\u099c\u09a8\u09cd\u09ae\u0995\u09c7 \u09a7\u09cd\u09ac\u0982\u09b8 \u0995\u09b0\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09bf, \u09af\u09be\u09b0\u09be \u09b6\u0995\u09cd\u09a4\u09bf-\u09b8\u09be\u09ae\u09b0\u09cd\u09a5\u09c7 \u098f\u09a6\u09c7\u09b0 \u099a\u09c7\u09df\u09c7 \u0985\u09a7\u09bf\u0995 \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u099b\u09bf\u09b2, \u09a4\u09be\u09b0\u09be \u09a6\u09c7\u09b6-\u09ac\u09bf\u09a6\u09c7\u09b6 \u099a\u09b7\u09c7 \u09ac\u09c7\u09dc\u09be\u09a4\u0964 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09bf (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09a5\u09c7\u0995\u09c7) \u0995\u09cb\u09a8 \u09aa\u09b2\u09be\u09df\u09a8\u09b8\u09cd\u09a5\u09b2 \u099b\u09bf\u09b2?","footnotes":"(\u09e7\u09e8) \u09ae\u0995\u09cd\u0995\u09be\u09ac\u09be\u09b8\u09c0 \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09a6\u09c7\u09b0\u0964"},{"id":"4667","sura":"50","aya":"37","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0641\u0650\u064a \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0645\u064e\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0647\u064f\u06e5 \u0642\u064e\u0644\u06e1\u0628\u064c \u0623\u064e\u0648\u06e1 \u0623\u064e\u0644\u06e1\u0642\u064e\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u06e1\u0639\u064e \u0648\u064e\u0647\u064f\u0648\u064e \u0634\u064e\u0647\u0650\u064a\u062f\u065e","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u098f\u09a4\u09c7 \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09aa\u09a6\u09c7\u09b6 \u09b0\u09df\u09c7\u099b\u09c7, \u09af\u09be\u09b0 \u09b9\u09c3\u09a6\u09df \u0986\u099b\u09c7 \u0985\u09a5\u09ac\u09be \u09af\u09c7 \u09ae\u09a8\u09cb\u09af\u09cb\u0997\u09b8\u09b9\u0995\u09be\u09b0\u09c7 \u0995\u09b0\u09cd\u09a3\u09aa\u09be\u09a4 \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u0989\u09aa\u09b8\u09cd\u09a5\u09bf\u09a4\u099a\u09bf\u09a4\u09cd\u09a4 \u09a5\u09be\u0995\u09c7\u0964","footnotes":""},{"id":"4668","sura":"50","aya":"38","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0641\u0650\u064a \u0633\u0650\u062a\u0651\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0645\u0656 \u0648\u064e\u0645\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0646\u064e\u0627 \u0645\u0650\u0646 \u0644\u0651\u064f\u063a\u064f\u0648\u0628\u0656","translation":"\u0986\u09b0 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0986\u09ae\u09bf \u0986\u09b8\u09ae\u09be\u09a8\u09b8\u09ae\u09c2\u09b9 \u0993 \u099c\u09ae\u09bf\u09a8 \u098f\u09ac\u0982 \u098f\u09a4\u09a6\u09c1\u09ad\u09df\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b8\u09ac\u0995\u09bf\u099b\u09c1 \u099b\u09df \u09a6\u09bf\u09a8\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u0986\u09b0 \u098f\u09a4\u09c7 \u0986\u09ae\u09be\u0995\u09c7 \u0995\u09cb\u09a8\u09b0\u09c2\u09aa \u0995\u09cd\u09b2\u09be\u09a8\u09cd\u09a4\u09bf \u09b8\u09cd\u09aa\u09b0\u09cd\u09b6 \u0995\u09b0\u09c7\u09a8\u09bf\u0964(\u09e7\u09e9)","footnotes":"(\u09e7\u09e9) \u0987\u09df\u09be\u09b9\u09c2\u09a6\u09c0\u09b0\u09be \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09b0\u09c7\u09be\u09aa \u0995\u09b0\u09c7 \u09ac\u09b2\u09c7 \u09af\u09c7, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u099b\u09df \u09a6\u09bf\u09a8\u09c7 \u0986\u09b8\u09ae\u09be\u09a8-\u099c\u09ae\u09bf\u09a8 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u09b8\u09aa\u09cd\u09a4\u09ae \u09a6\u09bf\u09a8 \u09b6\u09a8\u09bf\u09ac\u09be\u09b0 \u09a4\u09bf\u09a8\u09bf \u09ac\u09bf\u09b6\u09cd\u09b0\u09be\u09ae \u09a8\u09bf\u09df\u09c7\u099b\u09c7\u09a8\u0964"},{"id":"4669","sura":"50","aya":"39","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0648\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u062d\u064e\u0645\u06e1\u062f\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0642\u064e\u0628\u06e1\u0644\u064e \u0637\u064f\u0644\u064f\u0648\u0639\u0650 \u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u0650 \u0648\u064e\u0642\u064e\u0628\u06e1\u0644\u064e \u0671\u0644\u06e1\u063a\u064f\u0631\u064f\u0648\u0628\u0650","translation":"\u0985\u09a4\u098f\u09ac \u098f\u09b0\u09be \u09af\u09be (\u09af\u09c7 \u09ae\u09bf\u09a5\u09cd\u09af\u09be) \u09ac\u09b2\u09c7, \u09a4\u09be\u09a4\u09c7 \u09a4\u09c1\u09ae\u09bf \u09a7\u09c8\u09b0\u09cd\u09af\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09cb \u098f\u09ac\u0982 \u09b8\u09c2\u09b0\u09cd\u09af\u09cb\u09a6\u09af\u09bc\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u0993 \u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4\u09c7\u09b0 \u0986\u0997\u09c7 \u09a4\u09c1\u09ae\u09bf \u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b6\u0982\u09b8\u09be\u09b8\u09b9 \u09a4\u09be\u09b8\u09ac\u09c0\u09b9 \u09aa\u09be\u09a0 \u0995\u09b0\u09cb\u0964","footnotes":""},{"id":"4670","sura":"50","aya":"40","arabic_text":"\u0648\u064e\u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1\u0647\u064f \u0648\u064e\u0623\u064e\u062f\u06e1\u0628\u064e\u0670\u0631\u064e \u0671\u0644\u0633\u0651\u064f\u062c\u064f\u0648\u062f\u0650","translation":"\u098f\u09ac\u0982 \u09b0\u09be\u09a4\u09c7\u09b0 \u098f\u0995\u09be\u0982\u09b6\u09c7\u0993 \u09a4\u09c1\u09ae\u09bf \u09a4\u09be\u0981\u09b0 \u09a4\u09be\u09b8\u09ac\u09c0\u09b9 \u09aa\u09be\u09a0 \u0995\u09b0\u09cb(\u09e7\u09ea) \u098f\u09ac\u0982 (\u09ab\u09b0\u09af) \u09b8\u09be\u09b2\u09be\u09a4\u09c7\u09b0 \u09aa\u09b0\u09c7\u0993\u0964","footnotes":"(\u09e7\u09ea) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u09a4\u09be\u09b9\u09be\u099c\u09cd\u099c\u09c1\u09a6\u09c7\u09b0 \u09b8\u09be\u09b2\u09be\u09a4 \u0986\u09a6\u09be\u09df \u0995\u09b0\u09cb\u0964"},{"id":"4671","sura":"50","aya":"41","arabic_text":"\u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u0645\u0650\u0639\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064f\u0646\u064e\u0627\u062f\u0650 \u0671\u0644\u06e1\u0645\u064f\u0646\u064e\u0627\u062f\u0650 \u0645\u0650\u0646 \u0645\u0651\u064e\u0643\u064e\u0627\u0646\u0656 \u0642\u064e\u0631\u0650\u064a\u0628\u0656","translation":"\u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09b8\u09b9\u0995\u09be\u09b0\u09c7 \u09b6\u09cd\u09b0\u09ac\u09a3 \u0995\u09b0\u09cb \u09b8\u09c7 \u09a6\u09bf\u09a8\u09c7\u09b0 \u0995\u09a5\u09be, \u09af\u09c7\u09a6\u09bf\u09a8 \u098f\u0995\u099c\u09a8 \u0998\u09cb\u09b7\u0995 (\u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be) \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u0995\u09cb\u09a8 \u09b8\u09cd\u09a5\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09a1\u09be\u0995\u09a4\u09c7 \u09a5\u09be\u0995\u09ac\u09c7\u0964","footnotes":""},{"id":"4672","sura":"50","aya":"42","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0671\u0644\u0635\u0651\u064e\u064a\u06e1\u062d\u064e\u0629\u064e \u0628\u0650\u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062e\u064f\u0631\u064f\u0648\u062c\u0650","translation":"\u09b8\u09c7\u09a6\u09bf\u09a8 \u09a4\u09be\u09b0\u09be \u09b8\u09a4\u09cd\u09af\u09bf\u09b8\u09a4\u09cd\u09af\u09bf\u0987 (\u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8\u09c7\u09b0) \u09ae\u09b9\u09be\u099a\u09bf\u09ce\u0995\u09be\u09b0 \u09b6\u09c1\u09a8\u09ac\u09c7\u0964 \u09b8\u09c7\u099f\u09bf\u0987 (\u09e7\u09eb) \u09ac\u09c7\u09b0 \u09b9\u09ac\u09be\u09b0 \u09a6\u09bf\u09a8\u0964","footnotes":"(\u09e7\u09eb) \u09b9\u09bf\u09b8\u09be\u09ac \u0993 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09ae\u09c3\u09a4\u09a6\u09c7\u09b0\u0964"},{"id":"4673","sura":"50","aya":"43","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0646\u064f\u062d\u06e1\u064a\u0650\u06e6 \u0648\u064e\u0646\u064f\u0645\u0650\u064a\u062a\u064f \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0635\u0650\u064a\u0631\u064f","translation":"\u0986\u09ae\u09bf\u0987 \u099c\u09c0\u09ac\u09a8 \u09a6\u09be\u09a8 \u0995\u09b0\u09bf \u098f\u09ac\u0982 \u0986\u09ae\u09bf\u0987 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u0998\u099f\u09be\u0987, \u0986\u09b0 \u0986\u09ae\u09be\u09b0 \u09a6\u09bf\u0995\u09c7\u0987 (\u09b8\u0995\u09b2\u09c7\u09b0) \u099a\u09c2\u09dc\u09be\u09a8\u09cd\u09a4 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09ac\u09b0\u09cd\u09a4\u09a8\u0964","footnotes":""},{"id":"4674","sura":"50","aya":"44","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u062a\u064e\u0634\u064e\u0642\u0651\u064e\u0642\u064f \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u0639\u064e\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u062d\u064e\u0634\u06e1\u0631\u064c \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u064a\u064e\u0633\u0650\u064a\u0631\u065e","translation":"\u09af\u09c7\u09a6\u09bf\u09a8 \u09af\u09ae\u09bf\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0 \u0993\u09aa\u09b0 \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09a6\u09c0\u09b0\u09cd\u09a3 \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u09ac\u09c7, \u0986\u09b0 \u09a4\u09be\u09b0\u09be \u09a6\u09cd\u09b0\u09c1\u09a4 (\u0995\u09ac\u09b0 \u09a5\u09c7\u0995\u09c7) \u09ac\u09c7\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09b8\u09ac\u09c7\u0964 \u098f\u09ad\u09be\u09ac\u09c7 (\u09b8\u09ac\u09be\u0987\u0995\u09c7) \u098f\u0995\u09a4\u09cd\u09b0 \u09b8\u09ae\u09ac\u09c7\u09a4 \u0995\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09b9\u099c\u0964","footnotes":""},{"id":"4675","sura":"50","aya":"45","arabic_text":"\u0646\u0651\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e\u06d6 \u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645 \u0628\u0650\u062c\u064e\u0628\u0651\u064e\u0627\u0631\u0656\u06d6 \u0641\u064e\u0630\u064e\u0643\u0651\u0650\u0631\u06e1 \u0628\u0650\u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u0650 \u0645\u064e\u0646 \u064a\u064e\u062e\u064e\u0627\u0641\u064f \u0648\u064e\u0639\u0650\u064a\u062f\u0650","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u098f\u09b0\u09be \u09af\u09be \u09ac\u09b2\u09c7 \u0986\u09ae\u09bf \u09b8\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09ae\u09cd\u09af\u0995 \u0985\u09ac\u0997\u09a4 \u0986\u099b\u09bf\u0964 \u0986\u09b0 \u09a4\u09c1\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0993\u09aa\u09b0 \u0995\u09cb\u09a8 \u099c\u09cb\u09b0-\u099c\u09ac\u09b0\u09a6\u09b8\u09cd\u09a4\u09bf\u0995\u09be\u09b0\u09c0 \u09a8\u0993\u0964 \u09b8\u09c1\u09a4\u09b0\u09be\u0982 \u09af\u09c7 \u0986\u09ae\u09be\u09b0 (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0) \u09a7\u09ae\u0995\u0995\u09c7 \u09ad\u09df \u0995\u09b0\u09c7 \u09a4\u09be\u0995\u09c7 \u0986\u09b2-\u0995\u09c1\u09b0\u0986\u09a8\u09c7\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u09c7 \u0989\u09aa\u09a6\u09c7\u09b6 \u09a6\u09be\u0993\u0964","footnotes":""}]}