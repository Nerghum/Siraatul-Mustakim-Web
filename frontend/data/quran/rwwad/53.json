062f\u064e\u0647\u064e\u0627 \u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670\u0653","translation":"\u09af\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09c1\u09b2 \u09ae\u09be\u2019\u0993\u09df\u09be \u0985\u09ac\u09b8\u09cd\u09a5\u09bf\u09a4\u0964","footnotes":""},{"id":"4800","sura":"53","aya":"16","arabic_text":"\u0625\u0650\u0630\u06e1 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649 \u0671\u0644\u0633\u0651\u0650\u062f\u06e1\u0631\u064e\u0629\u064e \u0645\u064e\u0627 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649\u0670","translation":"\u09af\u0996\u09a8 (\u0986\u09b2\u09cd\u09b2\u09be\u09b9) \u0995\u09c1\u09b2 \u0997\u09be\u099b\u099f\u09bf\u0995\u09c7 \u09af\u09be \u0986\u099a\u09cd\u099b\u09be\u09a6\u09bf\u09a4 \u0995\u09b0\u09be\u09b0 \u09a4\u09be \u0986\u099a\u09cd\u099b\u09be\u09a6\u09bf\u09a4 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u0964","footnotes":""},{"id":"4801","sura":"53","aya":"17","arabic_text":"\u0645\u064e\u0627 \u0632\u064e\u0627\u063a\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f \u0648\u064e\u0645\u064e\u0627 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"\u09a4\u09be\u09b0 (\u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6\u09c7\u09b0) \u09a6\u09c3\u09b7\u09cd\u099f\u09bf \u09ac\u09bf\u09ad\u09cd\u09b0\u09ae \u09b9\u09df\u09a8\u09bf \u098f\u09ac\u0982 (\u09a4\u09be\u09b0 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf) \u09b8\u09c0\u09ae\u09be\u0993 \u0985\u09a4\u09bf\u0995\u09cd\u09b0\u09ae \u0995\u09b0\u09c7\u09a8\u09bf\u0964(\u09e7\u09ee)","footnotes":"(\u09e7\u09ee) \u09b8\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u09a6\u09c7\u0996\u09c7\u099b\u09c7, \u09af\u09a5\u09be\u09af\u09a5\u09ad\u09be\u09ac\u09c7\u0987 \u09a6\u09c7\u0996\u09c7\u099b\u09c7\u0964"},{"id":"4802","sura":"53","aya":"18","arabic_text":"\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0623\u064e\u0649\u0670 \u0645\u0650\u0646\u06e1 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09b8\u09c7 (\u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6) \u09a4\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09ac\u09dc \u09ac\u09dc \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9 \u09a5\u09c7\u0995\u09c7 \u09a6\u09c7\u0996\u09c7\u099b\u09c7\u0964(\u09e7\u09ef)\n \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc \u09b8\u09c7(\u09e7\u09ef) \u09a4\u09be\u0981\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09ae\u09b9\u09be\u09a8 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9\u09c7\u09b0 \u0995\u09bf\u099b\u09c1 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u0995\u09cd\u09b7 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09be\u0964","footnotes":"(\u09e7\u09ef) \u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b0\u09be\u09b9\u09c1 \u2018\u0986\u09b2\u09be\u09df\u09b9\u09bf\u09b8 \u09b8\u09be\u09b2\u09be\u09ae \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09ac\u09be\u09b9\u09c0 \u09ac\u09b9\u09c1 \u09ae\u09b9\u09be \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8\u09be\u09ac\u09b2\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u0995\u09cd\u09b7 \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u09a4\u09a8\u09cd\u09ae\u09a7\u09cd\u09af\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u0993 \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae \u0985\u09a8\u09cd\u09af\u09a4\u09ae\u0964"},{"id":"4803","sura":"53","aya":"19","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0670\u062a\u064e \u0648\u064e\u0671\u0644\u06e1\u0639\u064f\u0632\u0651\u064e\u0649\u0670","translation":"(\u09b9\u09c7 \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09b0\u09be!) \u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09bf \u09b2\u09be\u09a4 \u0993 \u2018\u0989\u09af\u09af\u09be \u09a6\u09c7\u09ac\u09a4\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09ad\u09c7\u09ac\u09c7 \u09a6\u09c7\u0996\u09c7\u099b?\u2019","footnotes":""},{"id":"4804","sura":"53","aya":"20","arabic_text":"\u0648\u064e\u0645\u064e\u0646\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062b\u0651\u064e\u0627\u0644\u0650\u062b\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"\u098f\u09ac\u0982 \u09a4\u09c3\u09a4\u09c0\u09df \u0986\u09b0\u09c7\u0995\u099f\u09bf (\u09a6\u09c7\u09ac\u09a4\u09be) \u09ae\u09be\u09a8\u09be\u09a4 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7?(\u09e8\u09e6)","footnotes":"(\u09e8\u09e6) \u098f\u0997\u09c1\u09b2\u09cb \u0995\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09cb\u09a8 \u0989\u09aa\u0995\u09be\u09b0 \u0995\u09bf\u0982\u09ac\u09be \u0995\u09cd\u09b7\u09a4\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7?"},{"id":"4805","sura":"53","aya":"21","arabic_text":"\u0623\u064e\u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"\u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09bf \u09aa\u09c1\u09a4\u09cd\u09b0 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8, \u0986\u09b0 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09a8\u09cd\u09af\u09be \u09b8\u09a8\u09cd\u09a4\u09be\u09a8?","footnotes":""},{"id":"4806","sura":"53","aya":"22","arabic_text":"\u062a\u0650\u0644\u06e1\u0643\u064e \u0625\u0650\u0630\u0657\u0627 \u0642\u0650\u0633\u06e1\u0645\u064e\u0629\u065e \u0636\u0650\u064a\u0632\u064e\u0649\u0670\u0653","translation":"\u098f\u099f\u09be\u09a4\u09cb \u098f\u0995 \u0985\u09b8\u0999\u09cd\u0997\u09a4 \u09ac\u09a3\u09cd\u099f\u09a8!","footnotes":""},{"id":"4807","sura":"53","aya":"23","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0645\u064e\u0627\u0653\u0621\u065e \u0633\u064e\u0645\u0651\u064e\u064a\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0643\u064f\u0645 \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0632\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646 \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u064d\u06da \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0647\u06e1\u0648\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0646\u0641\u064f\u0633\u064f\u06d6 \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"\u098f\u0997\u09c1\u09b2\u09cb \u09a4\u09cb \u0995\u09a4\u09bf\u09aa\u09df (\u0985\u09b0\u09cd\u09a5\u09b9\u09c0\u09a8) \u09a8\u09be\u09ae, \u09af\u09c7 \u09a8\u09be\u09ae\u0997\u09c1\u09b2\u09cb \u09a4\u09cb\u09ae\u09b0\u09be \u0993 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09bf\u09a4\u09c3\u09aa\u09c1\u09b0\u09c1\u09b7\u09c7\u09b0\u09be \u09b0\u09c7\u0996\u09c7\u099b\u0964 \u098f \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u0995\u09cb\u09a8 \u09a6\u09b2\u09bf\u09b2-\u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09a8\u09be\u09af\u09bf\u09b2 \u0995\u09b0\u09c7\u09a8\u09a8\u09bf\u0964 \u09a4\u09be\u09b0\u09be \u09a4\u09cb \u0995\u09c7\u09ac\u09b2 \u0985\u09a8\u09c1\u09ae\u09be\u09a8 \u098f\u09ac\u0982 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0995\u09c1\u09aa\u09cd\u09b0\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf\u09b0 \u09af\u09be \u099a\u09be\u09df, \u09a4\u09be\u09b0 \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u0964 \u0985\u09a5\u099a \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 (\u09a8\u09ac\u09c0\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7) \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4 \u098f\u09b8\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"4808","sura":"53","aya":"24","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0645\u064e\u0627 \u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0649\u0670","translation":"\u09ae\u09be\u09a8\u09c1\u09b7 \u09af\u09be \u099a\u09be\u09df, \u09a4\u09be\u0987 \u0995\u09bf \u09b8\u09c7 \u09aa\u09be\u09df?","footnotes":""},{"id":"4809","sura":"53","aya":"25","arabic_text":"\u0641\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"\u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u0983 \u0986\u0996\u09bf\u09b0\u09be\u09a4 \u0993 \u09a6\u09c1\u09a8\u09bf\u09df\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0\u0987\u0964(\u09e8\u09e7)","footnotes":"(\u09e8\u09e7) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u09ae\u09be\u09a8\u09c1\u09b7 \u09af\u09be \u0995\u09be\u09ae\u09a8\u09be \u0995\u09b0\u09c7 \u09a4\u09be \u09b8\u09c7 \u09aa\u09be\u09df \u09a8\u09be\u0964 \u09ac\u09b0\u0982 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09be \u0987\u099a\u09cd\u099b\u09be \u09a4\u09be\u0995\u09c7 \u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u09a8, \u09af\u09be \u0987\u099a\u09cd\u099b\u09be \u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u09a5\u09be\u0995\u09c7\u09a8\u0964"},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"\u0986\u09b0 \u0986\u0995\u09be\u09b6\u09ae\u09a3\u09cd\u09a1\u09b2\u09c0\u09a4\u09c7 \u098f\u09ae\u09a8 \u0995\u09a4 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7, \u09af\u09be\u09a6\u09c7\u09b0 \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09cb\u09a8\u09cb \u0989\u09aa\u0995\u09be\u09b0\u09c7\u0987 \u0986\u09b8\u09ac\u09c7 \u09a8\u09be, \u09af\u09a4\u0995\u09cd\u09b7\u09a3 \u09a8\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09af\u09be\u0995\u09c7 \u0987\u099a\u09cd\u099b\u09be \u0993 \u09af\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f \u09b9\u09a8, \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u09a8\u0964","footnotes":""},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09af\u09be\u09b0\u09be \u0986\u0996\u09bf\u09b0\u09be\u09a4\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09c7 \u09a8\u09be, \u09a4\u09be\u09b0\u09be\u0987 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a8\u09be\u09b0\u09c0\u09ac\u09be\u099a\u0995 \u09a8\u09be\u09ae\u09c7 \u09a8\u09be\u09ae\u0995\u09b0\u09a3 \u0995\u09b0\u09c7 \u09a5\u09be\u0995\u09c7\u0964(\u09e8\u09e8)","footnotes":"(\u09e8\u09e8) \u09a4\u09be\u09b0\u09be \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09a4\u09cb \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09a8\u09cd\u09af\u09be \u09b8\u09a8\u09cd\u09a4\u09be\u09a8; \u0985\u09a5\u099a \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0 \u098f\u09b8\u09ac \u09a7\u09be\u09b0\u09a3\u09be \u09a5\u09c7\u0995\u09c7 \u09aa\u09c1\u09a4-\u09aa\u09ac\u09bf\u09a4\u09cd\u09b0\u0964"},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"\u0985\u09a5\u099a (\u09e8\u09e9) \u098f \u09ac\u09bf\u09b7\u09df\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09cb\u09a8 \u099c\u09cd\u099e\u09be\u09a8\u0987 \u09a8\u09c7\u0987\u0964 \u09a4\u09be\u09b0\u09be \u09a4\u09cb \u09b6\u09c1\u09a7\u09c1 \u0985\u09a8\u09c1\u09ae\u09be\u09a8\u09c7\u09b0\u0987 \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u0964 \u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0985\u09a8\u09c1\u09ae\u09be\u09a8 \u09b8\u09a4\u09cd\u09af\u09c7\u09b0 \u09ae\u09cb\u0995\u09be\u09ac\u09c7\u09b2\u09be\u09df \u0995\u09cb\u09a8\u0987 \u0995\u09be\u099c\u09c7 \u0986\u09b8\u09c7 \u09a8\u09be\u0964","footnotes":"(\u09e8\u09e9) \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09be\u09b0\u09c0\u09ac\u09be\u099a\u0995 \u09a8\u09be\u09ae\u0995\u09b0\u09a3\u09c7\u09b0\u0964"},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"\u0985\u09a4\u098f\u09ac, \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09a4\u09c1\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u0989\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c7 \u099a\u09b2, \u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09ae\u09c1\u0996 \u09b9\u09df \u098f\u09ac\u0982 \u0995\u09c7\u09ac\u09b2 \u09a6\u09c1\u09a8\u09bf\u09df\u09be\u09b0 \u099c\u09c0\u09ac\u09a8\u0987 \u0995\u09be\u09ae\u09a8\u09be \u0995\u09b0\u09c7\u0964","footnotes":""},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"\u098f\u099f\u09be\u0987 \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8\u09c7\u09b0 \u09b6\u09c7\u09b7\u09b8\u09c0\u09ae\u09be\u0964 \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac\u0987 \u09b8\u09ac\u099a\u09c7\u09df\u09c7 \u09ad\u09be\u09b2\u09cb \u099c\u09be\u09a8\u09c7\u09a8, \u0995\u09c7 \u09a4\u09be\u0981\u09b0 \u09aa\u09a5 \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u099a\u09cd\u09af\u09c1\u09a4 \u09b9\u09df\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09a4\u09bf\u09a8\u09bf\u0987 \u09b8\u09ac\u099a\u09c7\u09df\u09c7 \u09ad\u09be\u09b2\u09cb \u099c\u09be\u09a8\u09c7\u09a8 \u0995\u09c7 \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u09b9\u09df\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"\u0986\u09b0 \u0986\u09b8\u09ae\u09be\u09a8\u09b8\u09ae\u09c2\u09b9\u09c7 \u0993 \u099c\u09ae\u09bf\u09a8\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7 \u09b8\u09ac \u0995\u09bf\u099b\u09c1\u09b0 \u09ae\u09be\u09b2\u09bf\u0995\u09be\u09a8\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0\u0987\u0964 \u09af\u09be\u09a4\u09c7 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ab\u09b2 (\u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae) \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09af\u09be\u09b0\u09be \u09ae\u09a8\u09cd\u09a6 \u0995\u09be\u099c \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a4\u09bf\u09a8\u09bf \u0989\u09a4\u09cd\u09a4\u09ae \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0 (\u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4) \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09af\u09be\u09b0\u09be \u09b8\u09ce\u0995\u09b0\u09cd\u09ae \u0995\u09b0\u09c7\u0964","footnotes":""},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"\u09af\u09be\u09b0\u09be \u099b\u09cb\u099f \u0996\u09be\u099f\u09cb \u09a6\u09cb\u09b7-\u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u099b\u09be\u09dc\u09be \u09ac\u09dc \u09ac\u09dc \u09aa\u09be\u09aa \u0993 \u0985\u09b6\u09cd\u09b2\u09c0\u09b2 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b2\u09be\u09aa \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u09a5\u09be\u0995\u09c7, \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac (\u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7) \u0995\u09cd\u09b7\u09ae\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u0989\u09a6\u09be\u09b0\u0964 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 (\u09a4\u0996\u09a8 \u09a5\u09c7\u0995\u09c7\u0987) \u09ad\u09be\u09b2\u09cb \u0995\u09b0\u09c7 \u099c\u09be\u09a8\u09c7\u09a8, \u09af\u0996\u09a8 \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ae\u09be\u099f\u09bf \u09a5\u09c7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u09af\u0996\u09a8 \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09be\u09a4\u09c3\u0997\u09b0\u09cd\u09ad\u09c7 \u09ad\u09cd\u09b0\u09c2\u09a3\u09b0\u09c2\u09aa\u09c7 \u099b\u09bf\u09b2\u09c7\u0964 \u0995\u09be\u099c\u09c7\u0987 \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09a4\u09cd\u09ae\u09aa\u09cd\u09b0\u09b6\u0982\u09b8\u09be \u0995\u09b0\u09cb \u09a8\u09be\u0964 \u09a4\u09bf\u09a8\u09bf\u0987 \u09b8\u09ae\u09cd\u09af\u0995 \u0985\u09ac\u0997\u09a4 \u0995\u09c7 \u09a4\u09be\u0995\u0993\u09df\u09be \u0985\u09ac\u09b2\u09ae\u09cd\u09ac\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u0964","footnotes":""},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"(\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2!) \u09a4\u09ac\u09c7 \u09a4\u09c1\u09ae\u09bf \u0995\u09bf \u09b8\u09c7\u0987 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0995\u09c7 \u09a6\u09c7\u0996\u09c7\u099b, \u09af\u09c7 \u09ae\u09c1\u0996 \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7\u099b\u09c7?(\u09e8\u09ea)","footnotes":"(\u09e8\u09ea) \u0986\u09df\u09be\u09a4\u099f\u09bf \u0993\u09df\u09be\u09b2\u09bf\u09a6 \u0987\u09ac\u09a8 \u09ae\u09c1\u0997\u09c0\u09b0\u09be\u09b9 \u09a8\u09be\u09ae\u0995 \u0995\u09be\u09ab\u09bf\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09a8\u09be\u09af\u09bf\u09b2 \u09b9\u09df\u09c7\u099b\u09c7 , \u09af\u09c7 \u0987\u09b8\u09b2\u09be\u09ae\u09c7\u09b0 \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b9\u09df\u09c7\u0993 \u09a4\u09be \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u0996 \u09ab\u09bf\u09b0\u09bf\u09df\u09c7 \u09a8\u09bf\u09df\u09c7\u099b\u09c7\u0964"},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"\u0986\u09b0 \u09b8\u09be\u09ae\u09be\u09a8\u09cd\u09af \u09a6\u09be\u09a8 \u0995\u09b0\u09c7, \u09aa\u09b0\u09c7 (\u09b8\u09c7\u099f\u09c1\u0995\u09c1\u0993) \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c7 \u09a6\u09c7\u09df?","footnotes":""},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"\u09a4\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u0995\u09bf \u0997\u09be\u09df\u09bf\u09ac\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u0986\u099b\u09c7 \u09af\u09c7, \u09b8\u09c7 \u09a6\u09c7\u0996\u099b\u09c7?","footnotes":""},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"\u09a8\u09be\u0995\u09bf \u09a4\u09be\u0995\u09c7 \u099c\u09be\u09a8\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09a8\u09bf, \u09af\u09be \u0986\u099b\u09c7 \u09ae\u09c2\u09b8\u09be\u09b0 \u09b8\u09b9\u09c0\u09ab\u09be\u09b8\u09ae\u09c2\u09b9\u09c7 ,","footnotes":""},{"id":"4821","sura":"53","aya":"37","arabic_text":"\u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0648\u064e\u0641\u0651\u064e\u0649\u0670\u0653","translation":"\u098f\u09ac\u0982 \u09af\u09be \u09b0\u09df\u09c7\u099b\u09c7 \u0987\u09ac\u09b0\u09be\u09b9\u09c0\u09ae\u09c7\u09b0 \u09b8\u09b9\u09c0\u09ab\u09be\u09b8\u09ae\u09c2\u09b9\u09c7, \u09af\u09c7 \u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09be (\u09a4\u09be\u09b0 \u0985\u0999\u09cd\u0997\u09c0\u0995\u09be\u09b0)\u0964","footnotes":""},{"id":"4822","sura":"53","aya":"38","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0632\u0650\u0631\u064f \u0648\u064e\u0627\u0632\u0650\u0631\u064e\u0629\u065e \u0648\u0650\u0632\u06e1\u0631\u064e \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"\u0995\u09cb\u09a8 \u09ac\u09cb\u099d\u09be \u09ac\u09b9\u09a8\u0995\u09be\u09b0\u09c0 \u0985\u09a8\u09cd\u09af\u09c7\u09b0 (\u09aa\u09be\u09aa\u09c7\u09b0) \u09ac\u09cb\u099d\u09be \u09ac\u09b9\u09a8 \u0995\u09b0\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":""},{"id":"4823","sura":"53","aya":"39","arabic_text":"\u0648\u064e\u0623\u064e\u0646 \u0644\u0651\u064e\u064a\u06e1\u0633\u064e \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"\u0986\u09b0 \u09ae\u09be\u09a8\u09c1\u09b7 \u09af\u09be \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c7, \u09a4\u09be\u0987 \u09b8\u09c7 \u09aa\u09be\u09df\u0964","footnotes":""},{"id":"4824","sura":"53","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0647\u064f\u06e5 \u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u0631\u064e\u0649\u0670","translation":"\u0986\u09b0 \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u099a\u09c7\u09b7\u09cd\u099f\u09be\u09b0 \u09ab\u09b2 \u09b6\u09c0\u0998\u09cd\u09b0\u0987 \u09a4\u09be\u0995\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09ac\u09c7\u0964","footnotes":""},{"id":"4825","sura":"53","aya":"41","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0641\u064e\u0649\u0670","translation":"\u09a4\u09be\u09b0\u09aa\u09b0 \u09a4\u09be\u0995\u09c7 \u09aa\u09c2\u09b0\u09cd\u09a3 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ab\u09b2 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964","footnotes":""},{"id":"4826","sura":"53","aya":"42","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u06