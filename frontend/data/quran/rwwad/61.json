{"result":[{"id":"5164","sura":"61","aya":"1","arabic_text":"\u0633\u064e\u0628\u0651\u064e\u062d\u064e \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06d6 \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u0639\u064e\u0632\u0650\u064a\u0632\u064f \u0671\u0644\u06e1\u062d\u064e\u0643\u0650\u064a\u0645\u064f","translation":"\u0986\u09b8\u09ae\u09be\u09a8\u09b8\u09ae\u09c2\u09b9\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7 \u098f\u09ac\u0982 \u099c\u09ae\u09bf\u09a8\u09c7 \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0986\u099b\u09c7, \u09b8\u09ac\u0987 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0\u09a4\u09be \u0998\u09cb\u09b7\u09a3\u09be \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u0986\u09b0 \u09a4\u09bf\u09a8\u09bf \u09aa\u09b0\u09be\u0995\u09cd\u09b0\u09ae\u09b6\u09be\u09b2\u09c0, \u09aa\u09cd\u09b0\u099c\u09cd\u099e\u09be\u09ae\u09af\u09bc\u0964","footnotes":""},{"id":"5165","sura":"61","aya":"2","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0644\u0650\u0645\u064e \u062a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u09b9\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u098f\u09a8\u09c7\u099b! \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be \u0995\u09b0\u09cb \u09a8\u09be, \u09a4\u09be \u0995\u09c7\u09a8 \u09a4\u09cb\u09ae\u09b0\u09be \u09ac\u09b2\u09cb?","footnotes":""},{"id":"5166","sura":"61","aya":"3","arabic_text":"\u0643\u064e\u0628\u064f\u0631\u064e \u0645\u064e\u0642\u06e1\u062a\u064b\u0627 \u0639\u0650\u0646\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0646 \u062a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0627\u0652 \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be \u0995\u09b0\u09cb \u09a8\u09be, \u09a4\u09be \u09ac\u09b2\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09bf\u0995\u099f \u0996\u09c1\u09ac\u0987 \u0997\u09b0\u09cd\u09b9\u09bf\u09a4 \u0995\u09be\u099c\u0964","footnotes":""},{"id":"5167","sura":"61","aya":"4","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064f\u062d\u0650\u0628\u0651\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0642\u064e\u0670\u062a\u0650\u0644\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0635\u064e\u0641\u0651\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645 \u0628\u064f\u0646\u06e1\u064a\u064e\u0670\u0646\u065e \u0645\u0651\u064e\u0631\u06e1\u0635\u064f\u0648\u0635\u065e","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ad\u09be\u09b2\u09cb\u09ac\u09be\u09b8\u09c7\u09a8, \u09af\u09be\u09b0\u09be \u09a4\u09be\u0981\u09b0 \u09aa\u09a5\u09c7 \u09b8\u09be\u09b0\u09bf\u09ac\u09a6\u09cd\u09a7 \u09b9\u09df\u09c7 \u09af\u09c1\u09a6\u09cd\u09a7 \u0995\u09b0\u09c7, \u09af\u09c7\u09a8 \u09a4\u09be\u09b0\u09be \u09b8\u09c0\u09b8\u09be \u09a2\u09be\u09b2\u09be \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09b0\u0964","footnotes":""},{"id":"5168","sura":"61","aya":"5","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u06e1 \u0642\u064e\u0627\u0644\u064e \u0645\u064f\u0648\u0633\u064e\u0649\u0670 \u0644\u0650\u0642\u064e\u0648\u06e1\u0645\u0650\u0647\u0650\u06e6 \u064a\u064e\u0670\u0642\u064e\u0648\u06e1\u0645\u0650 \u0644\u0650\u0645\u064e \u062a\u064f\u0624\u06e1\u0630\u064f\u0648\u0646\u064e\u0646\u0650\u064a \u0648\u064e\u0642\u064e\u062f \u062a\u0651\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0623\u064e\u0646\u0651\u0650\u064a \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0632\u064e\u0627\u063a\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0632\u064e\u0627\u063a\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0642\u064f\u0644\u064f\u0648\u0628\u064e\u0647\u064f\u0645\u06e1\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u06e1\u0641\u064e\u0670\u0633\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09cb \u09b8\u09c7 \u09b8\u09ae\u09df\u09c7\u09b0 \u0995\u09a5\u09be \u09af\u0996\u09a8 \u09ae\u09c2\u09b8\u09be \u09a4\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0995\u09c7 \u09ac\u09b2\u09c7\u099b\u09bf\u09b2: \u2018\u09b9\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df! \u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09c7\u09a8 (\u09e7) \u0986\u09ae\u09be\u0995\u09c7 \u0995\u09b7\u09cd\u099f \u09a6\u09bf\u099a\u09cd\u099b? \u0985\u09a5\u099a \u09a4\u09cb\u09ae\u09b0\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u099c\u09be\u09a8 \u09af\u09c7, \u0986\u09ae\u09bf \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u0964\u2019 \u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09be\u09b0\u09be \u09af\u0996\u09a8 (\u09b8\u09a4\u09cd\u09af \u099b\u09c7\u09dc\u09c7) \u09ac\u09be\u0981\u0995\u09be \u09aa\u09a5 \u0985\u09ac\u09b2\u09ae\u09cd\u09ac\u09a8 \u0995\u09b0\u09b2, \u09a4\u0996\u09a8 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b9\u09c3\u09a6\u09df\u0997\u09c1\u09b2\u09cb\u0995\u09c7 \u09ac\u09be\u0981\u0995\u09be \u0995\u09b0\u09c7 \u09a6\u09bf\u09b2\u09c7\u09a8\u0964 \u0986\u09b0 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09aa\u09be\u09aa\u09be\u099a\u09be\u09b0\u09c0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0995\u09c7 \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4 \u0995\u09b0\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":"(\u09e7) \u0986\u09ae\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09c7\u09b0 \u09ac\u09bf\u09b0\u09cb\u09a7\u09bf\u09a4\u09be \u0995\u09b0\u09c7\u0964"},{"id":"5169","sura":"61","aya":"6","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u06e1 \u0642\u064e\u0627\u0644\u064e \u0639\u0650\u064a\u0633\u064e\u0649 \u0671\u0628\u06e1\u0646\u064f \u0645\u064e\u0631\u06e1\u064a\u064e\u0645\u064e \u064a\u064e\u0670\u0628\u064e\u0646\u0650\u064a\u0653 \u0625\u0650\u0633\u06e1\u0631\u064e\u0670\u0653\u0621\u0650\u064a\u0644\u064e \u0625\u0650\u0646\u0651\u0650\u064a \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0644\u064e\u064a\u06e1\u0643\u064f\u0645 \u0645\u0651\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u0657\u0627 \u0644\u0651\u0650\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e \u064a\u064e\u062f\u064e\u064a\u0651\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u062a\u0651\u064e\u0648\u06e1\u0631\u064e\u0649\u0670\u0629\u0650 \u0648\u064e\u0645\u064f\u0628\u064e\u0634\u0651\u0650\u0631\u064e\u06e2\u0627 \u0628\u0650\u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u064a\u064e\u0623\u06e1\u062a\u0650\u064a \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650\u064a \u0671\u0633\u06e1\u0645\u064f\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u06e1\u0645\u064e\u062f\u064f\u06d6 \u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u06e1\u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0670\u062a\u0650 \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0647\u064e\u0670\u0630\u064e\u0627 \u0633\u0650\u062d\u06e1\u0631\u065e \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u065e","translation":"\u0986\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09cb \u09af\u0996\u09a8 \u09ae\u09be\u09b0\u0987\u09df\u09be\u09ae \u09aa\u09c1\u09a4\u09cd\u09b0 \u2018\u0988\u09b8\u09be \u09ac\u09b2\u09c7\u099b\u09bf\u09b2: \u2018\u09b9\u09c7 \u09ac\u09be\u09a8\u09c2 \u0987\u09b8\u09b0\u09be\u0988\u09b2, \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 (\u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4) \u09b0\u09be\u09b8\u09c2\u09b2\u0964 \u0986\u09ae\u09bf \u0986\u09ae\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0 \u09a4\u09be\u0993\u09b0\u09be\u09a4\u09c7\u09b0 \u09b8\u09a4\u09cd\u09af\u09be\u09df\u09a8\u0995\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u098f\u0995\u099c\u09a8 \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u09b8\u09c1\u09b8\u0982\u09ac\u09be\u09a6\u09a6\u09be\u09a4\u09be, \u09af\u09bf\u09a8\u09bf \u0986\u09ae\u09be\u09b0 \u09aa\u09b0\u09c7 \u0986\u09b8\u09ac\u09c7\u09a8, \u09af\u09be\u09b0 \u09a8\u09be\u09ae \u0986\u09b9\u09ae\u09be\u09a6\u0964\u2019 \u0985\u09a4\u0983\u09aa\u09b0 \u09b8\u09c7 (\u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6 ) \u09af\u0996\u09a8 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8\u09b8\u09ae\u09c2\u09b9 ( \u0986\u09b2-\u0995\u09c1\u09b0\u0986\u09a8 ) \u09a8\u09bf\u09df\u09c7 \u0986\u0997\u09ae\u09a8 \u0995\u09b0\u09b2(\u09e8), \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09b2\u09cb: \u2018\u098f\u099f\u09be\u09a4\u09cb \u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09af\u09be\u09a6\u09c1\u0964\u2019","footnotes":"(\u09e8) \u0995\u09cb\u09a8\u09cb \u0995\u09cb\u09a8\u09cb \u09a4\u09be\u09ab\u09b8\u09c0\u09b0\u09ac\u09bf\u09a6\u09c7\u09b0 \u09ae\u09a4\u09c7, \u098f\u0996\u09be\u09a8\u09c7 \u2018\u0988\u09b8\u09be \u0995\u09c7 \u0986\u09b0 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0987\u09a8\u09cd\u099c\u09c0\u09b2\u0995\u09c7 \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09b9\u09df\u09c7\u099b\u09c7\u0964"},{"id":"5170","sura":"61","aya":"7","arabic_text":"\u0648\u064e\u0645\u064e\u0646\u06e1 \u0623\u064e\u0638\u06e1\u0644\u064e\u0645\u064f \u0645\u0650\u0645\u0651\u064e\u0646\u0650 \u0671\u0641\u06e1\u062a\u064e\u0631\u064e\u0649\u0670 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0643\u064e\u0630\u0650\u0628\u064e \u0648\u064e\u0647\u064f\u0648\u064e \u064a\u064f\u062f\u06e1\u0639\u064e\u0649\u0670\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u06e1\u0625\u0650\u0633\u06e1\u0644\u064e\u0670\u0645\u0650\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0627 \u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09ae\u09bf\u09a5\u09cd\u09af\u09be \u0986\u09b0\u09cb\u09aa \u0995\u09b0\u09c7, \u0985\u09a5\u099a \u09a4\u09be\u0995\u09c7 \u0987\u09b8\u09b2\u09be\u09ae\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u0986\u09b9\u09cd\u09ac\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7, \u09a4\u09be\u09b0 \u099a\u09c7\u09df\u09c7 \u09ac\u09dc \u099c\u09be\u09b2\u09bf\u09ae \u0986\u09b0 \u0995\u09c7 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7? \u0986\u09b0 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u099c\u09be\u09b2\u09bf\u09ae \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0995\u09c7 \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4 \u09a6\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":""},{"id":"5171","sura":"61","aya":"8","arabic_text":"\u064a\u064f\u0631\u0650\u064a\u062f\u064f\u0648\u0646\u064e \u0644\u0650\u064a\u064f\u0637\u06e1\u0641\u0650\u0640\u0654\u064f\u0648\u0627\u0652 \u0646\u064f\u0648\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0628\u0650\u0623\u064e\u0641\u06e1\u0648\u064e\u0670\u0647\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064f\u062a\u0650\u0645\u0651\u064f \u0646\u064f\u0648\u0631\u0650\u0647\u0650\u06e6 \u0648\u064e\u0644\u064e\u0648\u06e1 \u0643\u064e\u0631\u0650\u0647\u064e \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u09a4\u09be\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09ae\u09c1\u0996\u09c7\u09b0 \u09ab\u09c1\u09ce\u0995\u09be\u09b0\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a8\u09c2\u09b0\u0995\u09c7 \u09a8\u09bf\u09ad\u09bf\u09df\u09c7 \u09a6\u09bf\u09a4\u09c7 \u099a\u09be\u09df; \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u0981\u09b0 \u09a8\u09c2\u09b0\u0995\u09c7 \u09aa\u09c2\u09b0\u09cd\u09a3\u09a4\u09be\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0\u0964 \u09af\u09a6\u09bf\u0993 \u0995\u09be\u09ab\u09bf\u09b0\u09b0\u09be \u09a4\u09be \u0985\u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09c7\u0964","footnotes":""},{"id":"5172","sura":"61","aya":"9","arabic_text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064e\u0647\u064f\u06e5 \u0628\u0650\u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670 \u0648\u064e\u062f\u0650\u064a\u0646\u0650 \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0644\u0650\u064a\u064f\u0638\u06e1\u0647\u0650\u0631\u064e\u0647\u064f\u06e5 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650 \u0643\u064f\u0644\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0644\u064e\u0648\u06e1 \u0643\u064e\u0631\u0650\u0647\u064e \u0671\u0644\u06e1\u0645\u064f\u0634\u06e1\u0631\u0650\u0643\u064f\u0648\u0646\u064e","translation":"\u09a4\u09bf\u09a8\u09bf\u0987 \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2 (\u09ae\u09c1\u09b9\u09be\u09ae\u09cd\u09ae\u09be\u09a6)\u0995\u09c7 \u09b9\u09bf\u09a6\u09be\u09df\u09be\u09a4 \u0993 \u09b8\u09a4\u09cd\u09af \u09a6\u09cd\u09ac\u09c0\u09a8 (\u0987\u09b8\u09b2\u09be\u09ae) \u09a6\u09bf\u09df\u09c7 \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u09af\u09be\u09a4\u09c7 \u09a4\u09bf\u09a8\u09bf \u09b8\u0995\u09b2 \u09a6\u09cd\u09ac\u09c0\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a4\u09be \u09ac\u09bf\u099c\u09df\u09c0 \u0995\u09b0\u09c7 \u09a6\u09c7\u09a8\u0964 \u09af\u09a6\u09bf\u0993 \u09ae\u09c1\u09b6\u09b0\u09bf\u0995\u09b0\u09be \u09a4\u09be \u0985\u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09c7\u0964","footnotes":""},{"id":"5173","sura":"61","aya":"10","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0647\u064e\u0644\u06e1 \u0623\u064e\u062f\u064f\u0644\u0651\u064f\u0643\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u062a\u0650\u062c\u064e\u0670\u0631\u064e\u0629\u0656 \u062a\u064f\u0646\u062c\u0650\u064a\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u0656","translation":"\u09b9\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u098f\u09a8\u09c7\u099b!! \u0986\u09ae\u09bf \u0995\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u098f\u09ae\u09a8 \u098f\u0995 \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09df\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u09a6\u09bf\u09ac\u09cb, \u09af\u09be \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09af\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09a6\u09be\u09df\u0995 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09a5\u09c7\u0995\u09c7 \u09b0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09ac\u09c7?","footnotes":""},{"id":"5174","sura":"61","aya":"11","arabic_text":"\u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u062a\u064f\u062c\u064e\u0670\u0647\u0650\u062f\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0628\u0650\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u0648\u064e\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u06e1\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u062e\u064e\u064a\u06e1\u0631\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"(\u09e9) \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0993 \u09a4\u09be\u0981\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09ac\u09c7 \u098f\u09ac\u0982 \u09a4\u09cb\u09ae\u09b0\u09be \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09a6 \u0993 \u099c\u09c0\u09ac\u09a8 \u09a6\u09bf\u09df\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09a5\u09c7 \u099c\u09bf\u09b9\u09be\u09a6 \u0995\u09b0\u09ac\u09c7\u0964 \u098f\u099f\u09be\u0987 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09b2\u09cd\u09af\u09be\u09a3\u0995\u09b0, \u09af\u09a6\u09bf \u09a4\u09cb\u09ae\u09b0\u09be \u099c\u09be\u09a8\u09a4\u09c7\u0964","footnotes":"(\u09e9) \u098f \u09b2\u09be\u09ad\u099c\u09a8\u0995 \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u099f\u09bf \u09b9\u09b2\u09cb\u0983"},{"id":"5175","sura":"61","aya":"12","arabic_text":"\u064a\u064e\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u064e\u0643\u064f\u0645\u06e1 \u0630\u064f\u0646\u064f\u0648\u0628\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u064a\u064f\u062f\u06e1\u062e\u0650\u0644\u06e1\u0643\u064f\u0645\u06e1 \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a \u0645\u0650\u0646 \u062a\u064e\u062d\u06e1\u062a\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0646\u06e1\u0647\u064e\u0670\u0631\u064f \u0648\u064e\u0645\u064e\u0633\u064e\u0670\u0643\u0650\u0646\u064e \u0637\u064e\u064a\u0651\u0650\u0628\u064e\u0629\u0657 \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0650 \u0639\u064e\u062f\u06e1\u0646\u0656\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u0641\u064e\u0648\u06e1\u0632\u064f \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u064f","translation":"(\u098f \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09b0 \u09ab\u09b2\u09c7) \u09a4\u09bf\u09a8\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09be\u09aa\u09b8\u09ae\u09c2\u09b9 \u0995\u09cd\u09b7\u09ae\u09be \u0995\u09b0\u09c7 \u09a6\u09bf\u09ac\u09c7\u09a8\u0964 \u0986\u09b0 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u098f\u09ae\u09a8 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09b8\u09ae\u09c2\u09b9\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be\u09ac\u09c7\u09a8 \u09af\u09be\u09b0 \u09a4\u09b2\u09a6\u09c7\u09b6\u09c7 \u09a8\u09b9\u09b0\u09b8\u09ae\u09c2\u09b9 \u09aa\u09cd\u09b0\u09ac\u09be\u09b9\u09bf\u09a4 \u098f\u09ac\u0982 \u099a\u09bf\u09b0\u09b8\u09cd\u09a5\u09be\u09df\u09c0 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4\u09b8\u09ae\u09c2\u09b9\u09c7\u09b0 \u0989\u09a4\u09cd\u09a4\u09ae \u0986\u09ac\u09be\u09b8\u0997\u09c1\u09b2\u09cb\u09a4\u09c7\u0993 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be\u09ac\u09c7\u09a8\u0964 \u098f\u099f\u09be\u0987 \u09ae\u09b9\u09be\u09b8\u09be\u09ab\u09b2\u09cd\u09af\u0964","footnotes":""},{"id":"5176","sura":"61","aya":"13","arabic_text":"\u0648\u064e\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u06d6 \u0646\u064e\u0635\u06e1\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0641\u064e\u062a\u06e1\u062d\u065e \u0642\u064e\u0631\u0650\u064a\u0628\u065e\u06d7 \u0648\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u0650 \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e","translation":"\u098f\u09ac\u0982 (\u0989\u0995\u09cd\u09a4 \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09b0) \u0986\u09b0\u09cb \u098f\u0995\u099f\u09bf (\u09b2\u09be\u09ad) \u09af\u09be \u09a4\u09cb\u09ae\u09b0\u09be \u0996\u09c1\u09ac \u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09cb (\u09a4\u09be \u09b9\u09b2\u09cb\u0983) \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0993 \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 (\u09ae\u0995\u09cd\u0995\u09be) \u09ac\u09bf\u099c\u09df\u0964 \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09ae\u09c1\u2019\u09ae\u09bf\u09a8\u09a6\u09c7\u09b0\u0995\u09c7 \u09a4\u09c1\u09ae\u09bf (\u09ea) \u09b8\u09c1\u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09be\u0993\u0964","footnotes":"(\u09ea) \u0987\u09b9\u0995\u09be\u09b2\u09c7\u09b0 \u09ac\u09bf\u099c\u09df \u098f\u09ac\u0982 \u09aa\u09b0\u0995\u09be\u09b2\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u09b2\u09be\u09ad\u09c7 \u09a7\u09a8\u09cd\u09af \u09b9\u0993\u09df\u09be\u09b0\u0964"},{"id":"5177","sura":"61","aya":"14","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0643\u064f\u0648\u0646\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0645\u064e\u0627 \u0642\u064e\u0627\u0644\u064e \u0639\u0650\u064a\u0633\u064e\u0649 \u0671\u0628\u06e1\u0646\u064f \u0645\u064e\u0631\u06e1\u064a\u064e\u0645\u064e \u0644\u0650\u0644\u06e1\u062d\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0651\u0650\u0640\u06e7\u0646\u064e \u0645\u064e\u0646\u06e1 \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d6 \u0642\u064e\u0627\u0644\u064e \u0671\u0644\u06e1\u062d\u064e\u0648\u064e\u0627\u0631\u0650\u064a\u0651\u064f\u0648\u0646\u064e \u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0646\u0635\u064e\u0627\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d6 \u0641\u064e\u0640\u0654\u064e\u0627\u0645\u064e\u0646\u064e\u062a \u0637\u0651\u064e\u0627\u0653\u0626\u0650\u0641\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u06e2 \u0628\u064e\u0646\u0650\u064a\u0653 \u0625\u0650\u0633\u06e1\u0631\u064e\u0670\u0653\u0621\u0650\u064a\u0644\u064e \u0648\u064e\u0643\u064e\u0641\u064e\u0631\u064e\u062a \u0637\u0651\u064e\u0627\u0653\u0626\u0650\u0641\u064e\u0629\u065e\u06d6 \u0641\u064e\u0623\u064e\u064a\u0651\u064e\u062f\u06e1\u0646\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0639\u064e\u062f\u064f\u0648\u0651\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0623\u064e\u0635\u06e1\u0628\u064e\u062d\u064f\u0648\u0627\u0652 \u0638\u064e\u0670\u0647\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u09b9\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u098f\u09a8\u09c7\u099b! \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u0995\u09be\u09b0\u09c0 \u09b9\u0993, \u09af\u09c7\u09ae\u09a8 \u09ae\u09be\u09b0\u0987\u09df\u09be\u09ae \u09aa\u09c1\u09a4\u09cd\u09b0 \u2018\u0988\u09b8\u09be \u09b9\u09be\u0993\u09df\u09be\u09b0\u09c0\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09c7\u099b\u09bf\u09b2: \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09aa\u09a5\u09c7 \u0995\u09be\u09b0\u09be \u0986\u09ae\u09be\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u0995\u09be\u09b0\u09c0 \u09b9\u09ac\u09c7? \u09b9\u09be\u0993\u09df\u09be\u09b0\u09c0\u0997\u09a3 \u09ac\u09b2\u09c7\u099b\u09bf\u09b2\u09cb: \u0986\u09ae\u09b0\u09be\u0987 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u0995\u09be\u09b0\u09c0\u0964 \u09a4\u09be\u09b0\u09aa\u09b0 \u09ac\u09be\u09a8\u09c2-\u0988\u09b8\u09b0\u09be\u0987\u09b2\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u098f\u0995\u09a6\u09b2 \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09b2 \u098f\u09ac\u0982 \u0985\u09aa\u09b0 \u098f\u0995 \u09a6\u09b2 \u0995\u09c1\u09ab\u09b0\u09c0 \u0995\u09b0\u09b2\u09cb\u0964 \u0985\u09a4\u0983\u09aa\u09b0 \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09b2 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b6\u09a4\u09cd\u09b0\u09c1\u09ac\u09be\u09b9\u09bf\u09a8\u09c0\u09b0 \u0993\u09aa\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09b2\u09be\u09ae\u0964 \u09ab\u09b2\u09c7 \u09a4\u09be\u09b0\u09be (\u0993\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0) \u09ac\u09bf\u099c\u09df\u09c0 \u09b9\u09b2\u09cb\u0964","footnotes":""}]}