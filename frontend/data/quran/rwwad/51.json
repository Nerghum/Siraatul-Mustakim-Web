u09ad\u09bf\u09a6 \u0993 \u09aa\u09cd\u09b0\u09be\u09a3\u09c0\u0995\u09c1\u09b2 \u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf\u0964"},{"id":"4696","sura":"51","aya":"21","arabic_text":"\u0648\u064e\u0641\u0650\u064a\u0653 \u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u06e1\u06da \u0623\u064e\u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u098f\u09ac\u0982 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7\u0993 (\u09e9) \u0985\u09a8\u09c7\u0995 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u09b0\u09df\u09c7\u099b\u09c7\u0964\u09a4\u09ac\u09c1\u0993 \u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09bf \u099a\u0995\u09cd\u09b7\u09c1\u09b7\u09cd\u09ae\u09be\u09a8 \u09b9\u09ac\u09c7 \u09a8\u09be?","footnotes":"(\u09e9) \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u0995\u09c1\u09a6\u09b0\u09a4\u09c7\u09b0\u0964"},{"id":"4697","sura":"51","aya":"22","arabic_text":"\u0648\u064e\u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0631\u0650\u0632\u06e1\u0642\u064f\u0643\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u062a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u0986\u0995\u09be\u09b6\u09c7 \u09b0\u09df\u09c7\u099b\u09c7 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u09b0\u09bf\u09af\u0995 \u0993 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4 \u09b8\u09ac \u0995\u09bf\u099b\u09c1\u0964(\u09ea)","footnotes":"(\u09ea) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u0986\u0995\u09be\u09b6\u09c7 \u09a5\u09be\u0995\u09be \u0985\u09b0\u09cd\u09a5 \u09b9\u09b2\u09cb, \u0986\u09b2-\u09b2\u09be\u0993\u09b9\u09c1\u09b2-\u09ae\u09be\u09b9\u09ab\u09c2\u09af\u09c7 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09b0\u09bf\u09af\u0995 \u0993 \u09ad\u09be\u09b2\u09cb-\u09ae\u09a8\u09cd\u09a6, \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 \u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf \u09b2\u09bf\u09aa\u09bf\u09ac\u09a6\u09cd\u09a7 \u09b0\u09df\u09c7\u099b\u09c7\u0964"},{"id":"4698","sura":"51","aya":"23","arabic_text":"\u0641\u064e\u0648\u064e\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u065e \u0645\u0651\u0650\u062b\u06e1\u0644\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"\u0985\u09a4\u098f\u09ac \u0986\u09b8\u09ae\u09be\u09a8 \u0993 \u099c\u09ae\u09bf\u09a8\u09c7\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09b6\u09aa\u09a5! \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc\u0987 \u098f\u099f\u09bf (\u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8) \u09a4\u09c7\u09ae\u09a8\u09bf \u09b8\u09a4\u09cd\u09af, \u09af\u09c7\u09ae\u09a8 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09a5\u09be \u09ac\u09b2\u09be \u09b8\u09a4\u09cd\u09af\u0964","footnotes":""},{"id":"4699","sura":"51","aya":"24","arabic_text":"\u0647\u064e\u0644\u06e1 \u0623\u064e\u062a\u064e\u0649\u0670\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u062b\u064f \u0636\u064e\u064a\u06e1\u0641\u0650 \u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u06e1\u0631\u064e\u0645\u0650\u064a\u0646\u064e","translation":"\u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09a4\u09cb\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u0995\u09bf \u0987\u09ac\u09b0\u09be\u09b9\u09c0\u09ae\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09bf\u09a4 \u09ae\u09c7\u09b9\u09ae\u09be\u09a8\u09a6\u09c7\u09b0 \u09ac\u09c3\u09a4\u09cd\u09a4\u09be\u09a8\u09cd\u09a4 \u098f\u09b8\u09c7\u099b\u09c7?","footnotes":""},{"id":"4700","sura":"51","aya":"25","arabic_text":"\u0625\u0650\u0630\u06e1 \u062f\u064e\u062e\u064e\u0644\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0641\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0633\u064e\u0644\u064e\u0670\u0645\u0657\u0627\u06d6 \u0642\u064e\u0627\u0644\u064e \u0633\u064e\u0644\u064e\u0670\u0645\u065e \u0642\u064e\u0648\u06e1\u0645\u065e \u0645\u0651\u064f\u0646\u0643\u064e\u0631\u064f\u0648\u0646\u064e","translation":"\u09af\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u09a4\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u098f\u09b8\u09c7 \u09ac\u09b2\u09b2: \u2018\u09b8\u09be\u09b2\u09be\u09ae\u2019, \u0989\u09a4\u09cd\u09a4\u09b0\u09c7 \u09b8\u09c7\u0993 \u09ac\u09b2\u09b2, \u2018\u09b8\u09be\u09b2\u09be\u09ae\u2019\u0964 \u098f\u09b0\u09be \u09a4\u09cb \u0985\u09aa\u09b0\u09bf\u099a\u09bf\u09a4 \u09b2\u09cb\u0995\u0964","footnotes":""},{"id":"4701","sura":"51","aya":"26","arabic_text":"\u0641\u064e\u0631\u064e\u0627\u063a\u064e \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u0641\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0628\u0650\u0639\u0650\u062c\u06e1\u0644\u0656 \u0633\u064e\u0645\u0650\u064a\u0646\u0656","translation":"\u0985\u09a4\u0983\u09aa\u09b0 \u09b8\u09c7 \u09a8\u09bf\u0983\u09b6\u09ac\u09cd\u09a6\u09c7 \u09a4\u09be\u0981\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0997\u09c7\u09b2\u09cb \u098f\u09ac\u0982 \u098f\u0995\u099f\u09bf \u09ae\u09cb\u099f\u09be\u09a4\u09be\u099c\u09be (\u09ad\u09be\u099c\u09be) \u09ac\u09be\u099b\u09c1\u09b0 \u09a8\u09bf\u09af\u09bc\u09c7 \u098f\u09b2\u09c7\u09be\u0964","footnotes":""},{"id":"4702","sura":"51","aya":"27","arabic_text":"\u0641\u064e\u0642\u064e\u0631\u0651\u064e\u0628\u064e\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0642\u064e\u0627\u0644\u064e \u0623\u064e\u0644\u064e\u0627 \u062a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0648\u0646\u064e","translation":"\u0985\u09a4\u0983\u09aa\u09b0 \u09b8\u09c7 \u09a4\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09a8 \u0995\u09b0\u09b2 \u098f\u09ac\u0982 \u09ac\u09b2\u09b2, \u2018\u09a4\u09cb\u09ae\u09b0\u09be \u0995\u09bf \u0986\u09b9\u09be\u09b0 \u0995\u09b0\u09ac\u09c7 \u09a8\u09be?\u2019","footnotes":""},{"id":"4703","sura":"51","aya":"28","arabic_text":"\u0641\u064e\u0623\u064e\u0648\u06e1\u062c\u064e\u0633\u064e \u0645\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u062e\u0650\u064a\u0641\u064e\u0629\u0657\u06d6 \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u062a\u064e\u062e\u064e\u0641\u06e1\u06d6 \u0648\u064e\u0628\u064e\u0634\u0651\u064e\u0631\u064f\u0648\u0647\u064f \u0628\u0650\u063a\u064f\u0644\u064e\u0670\u0645\u064d \u0639\u064e\u0644\u0650\u064a\u0645\u0656","translation":"\u098f\u09a4\u09c7(\u09eb) \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09c7 \u09ae\u09a8\u09c7 \u09ae\u09a8\u09c7 \u09ad\u09c0\u09a4 \u09b9\u09b2\u0964 \u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09b2\u09cb: \u2018\u09ad\u09df \u09aa\u09c7\u09df\u09cb \u09a8\u09be\u0964\u2019 \u09a4\u09be\u09b0\u09be \u09a4\u09be\u0995\u09c7 \u098f\u0995 \u09ac\u09bf\u09a6\u09cd\u09ac\u09be\u09a8 \u09aa\u09c1\u09a4\u09cd\u09b0 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09c7\u09b0 (\u0987\u09b8\u09b9\u09be\u0995\u09c7\u09b0) \u09b8\u09c1\u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09bf\u09b2\u0964","footnotes":"(\u09eb) \u09a4\u09be\u09b0\u09be \u0996\u09be\u09ac\u09be\u09b0 \u0997\u09cd\u09b0\u09b9\u09a3 \u09a8\u09be \u0995\u09b0\u09be\u09df\u0964"},{"id":"4704","sura":"51","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0644\u064e\u062a\u0650 \u0671\u0645\u06e1\u0631\u064e\u0623\u064e\u062a\u064f\u0647\u064f\u06e5 \u0641\u0650\u064a \u0635\u064e\u0631\u0651\u064e\u0629\u0656 \u0641\u064e\u0635\u064e\u0643\u0651\u064e\u062a\u06e1 \u0648\u064e\u062c\u06e1\u0647\u064e\u0647\u064e\u0627 \u0648\u064e\u0642\u064e\u0627\u0644\u064e\u062a\u06e1 \u0639\u064e\u062c\u064f\u0648\u0632\u064c \u0639\u064e\u0642\u0650\u064a\u0645\u065e","translation":"\u09a4\u0996\u09a8 \u09a4\u09be\u09b0 \u09b8\u09cd\u09a4\u09cd\u09b0\u09c0 \u099a\u09bf\u09ce\u0995\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u0995\u09b0\u09a4\u09c7 \u098f\u0997\u09bf\u09df\u09c7 \u0986\u09b8\u09b2 \u098f\u09ac\u0982 \u09a8\u09bf\u099c \u09ae\u09c1\u0996 \u099a\u09be\u09aa\u09dc\u09bf\u09df\u09c7 (\u0986\u09b6\u09cd\u099a\u09b0\u09cd\u09af \u09b9\u09df\u09c7) \u09ac\u09b2\u09b2\u09cb: ( \u0986\u09ae\u09bf \u09a4\u09cb) \u2018\u09ac\u09c3\u09a6\u09cd\u09a7\u09be, \u09ac\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u0964\u2019(\u09ec)","footnotes":"(\u09ec) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u0986\u09ae\u09bf \u09ac\u09c3\u09a6\u09cd\u09a7\u09be, \u098f\u09b0\u09aa\u09b0 \u09ac\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u0964 \u09af\u09cc\u09ac\u09a8\u09c7 \u0986\u09ae\u09bf \u09b8\u09a8\u09cd\u09a4\u09be\u09a8 \u09a7\u09be\u09b0\u09a3\u09c7\u09b0 \u09af\u09cb\u0997\u09cd\u09af \u099b\u09bf\u09b2\u09be\u09ae \u09a8\u09be, \u0986\u09b0 \u098f\u0996\u09a8 \u09a4\u09cb \u09ac\u09be\u09b0\u09cd\u09a7\u0995\u09cd\u09af\u09c7 \u0989\u09aa\u09a8\u09c0\u09a4 \u09b9\u09df\u09c7 \u0997\u09c7\u099b\u09bf\u0964"},{"id":"4705","sura":"51","aya":"30","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u0650 \u0642\u064e\u0627\u0644\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u0650\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0671\u0644\u06e1\u062d\u064e\u0643\u0650\u064a\u0645\u064f \u0671\u0644\u06e1\u0639\u064e\u0644\u0650\u064a\u0645\u064f","translation":"\u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09b2\u09cb: \u2018\u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac \u098f\u09b0\u09c2\u09aa\u0987 \u09ac\u09b2\u09c7\u099b\u09c7\u09a8\u0964 \u09a8\u09bf\u09b6\u09cd\u099a\u09df\u0987 \u09a4\u09bf\u09a8\u09bf \u09aa\u09cd\u09b0\u099c\u09cd\u099e\u09be\u09ae\u09df, \u09b8\u09b0\u09cd\u09ac\u099c\u09cd\u099e\u0964\u2019","footnotes":""},{"id":"4706","sura":"51","aya":"31","arabic_text":"\u06de\u00a0\u0642\u064e\u0627\u0644\u064e \u0641\u064e\u0645\u064e\u0627 \u062e\u064e\u0637\u06e1\u0628\u064f\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0631\u06e1\u0633\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u0987\u09ac\u09b0\u09be\u09b9\u09c0\u09ae \u09ac\u09b2\u09b2\u09cb: \u2018\u09b9\u09c7 \u09aa\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u0997\u09a3! \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 (\u0986\u0997\u09ae\u09a8\u09c7\u09b0 \u0986\u09b8\u09b2 ) \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af \u0995\u09bf?\u2019","footnotes":""},{"id":"4707","sura":"51","aya":"32","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064f\u0631\u06e1\u0633\u0650\u0644\u06e1\u0646\u064e\u0627\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0642\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09b2\u09cb: \u2018\u0986\u09ae\u09b0\u09be \u098f\u0995 \u0985\u09aa\u09b0\u09be\u09a7\u09c0 (\u09b2\u09c2\u09a4\u09c7\u09b0) \u099c\u09be\u09a4\u09bf\u09b0 \u09a8\u09bf\u0995\u099f \u09aa\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09bf\u0964\u2019","footnotes":""},{"id":"4708","sura":"51","aya":"33","arabic_text":"\u0644\u0650\u0646\u064f\u0631\u06e1\u0633\u0650\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u062d\u0650\u062c\u064e\u0627\u0631\u064e\u0629\u0657 \u0645\u0651\u0650\u0646 \u0637\u0650\u064a\u0646\u0656","translation":"\u2018\u09af\u09be\u09a4\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0989\u09aa\u09b0 \u09b6\u0995\u09cd\u09a4 \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09be\u09a5\u09b0 \u09a8\u09bf\u0995\u09cd\u09b7\u09c7\u09aa \u0995\u09b0\u09bf\u0964\u2019","footnotes":""},{"id":"4709","sura":"51","aya":"34","arabic_text":"\u0645\u0651\u064f\u0633\u064e\u0648\u0651\u064e\u0645\u064e\u0629\u064b \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u0633\u06e1\u0631\u0650\u0641\u0650\u064a\u0646\u064e","translation":"\u2018\u09af\u09be \u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u099a\u09bf\u09b9\u09cd\u09a8\u09bf\u09a4 (\u0995\u09b0\u09c7 \u09a6\u09c7\u0993\u09df\u09be \u09b9\u09df\u09c7\u099b\u09c7), \u09b8\u09c0\u09ae\u09be\u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa)\u0964\u2019","footnotes":""},{"id":"4710","sura":"51","aya":"35","arabic_text":"\u0641\u064e\u0623\u064e\u062e\u06e1\u0631\u064e\u062c\u06e1\u0646\u064e\u0627 \u0645\u064e\u0646 \u0643\u064e\u0627\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e","translation":"\u0985\u09a4\u0983\u09aa\u09b0 \u0986\u09ae\u09bf \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u09af\u09c7\u09b8\u09ac \u09ae\u09c1\u2019\u09ae\u09bf\u09a8 \u099b\u09bf\u09b2 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09c7\u09b0 \u0995\u09b0\u09c7 \u09a8\u09bf\u09df\u09c7 \u0986\u09b8\u09b2\u09be\u09ae\u0964(\u09ed)","footnotes":"(\u09ed) \u09af\u09be\u09a4\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u0985\u09aa\u09b0\u09be\u09a7\u09c0\u09a6\u09c7\u09b0 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09a8\u09be \u09aa\u09c7\u09df\u09c7 \u09ac\u09b8\u09c7\u0964"},{"id":"4711","sura":"51","aya":"36","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0648\u064e\u062c\u064e\u062f\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u063a\u064e\u064a\u06e1\u0631\u064e \u0628\u064e\u064a\u06e1\u062a\u0656 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u0644\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u09a4\u09ac\u09c7 \u0986\u09ae\u09bf \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u098f\u0995\u099f\u09bf \u09ac\u09be\u09dc\u09bf (\u09b2\u09c2\u09a4\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0) \u099b\u09be\u09dc\u09be \u0995\u09cb\u09a8 \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u09aa\u09be\u0987\u09a8\u09bf\u0964","footnotes":""},{"id":"4712","sura":"51","aya":"37","arabic_text":"\u0648\u064e\u062a\u064e\u0631\u064e\u0643\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627\u0653 \u0621\u064e\u0627\u064a\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0671\u0644\u06e1\u0623\u064e\u0644\u0650\u064a\u0645\u064e","translation":"\u0986\u09b0 \u09af\u09be\u09b0\u09be \u09af\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09a6\u09be\u09df\u0995 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u0995\u09c7 \u09ad\u09df \u0995\u09b0\u09c7 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u09b0\u09c7\u0996\u09c7\u099b\u09bf\u0964","footnotes":""},{"id":"4713","sura":"51","aya":"38","arabic_text":"\u0648\u064e\u0641\u0650\u064a \u0645\u064f\u0648\u0633\u064e\u0649\u0670\u0653 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656 \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u0656","translation":"\u0986\u09b0 \u09ae\u09c2\u09b8\u09be\u09b0 \u0995\u09be\u09b9\u09bf\u09a8\u09c0\u09a4\u09c7\u0993 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u09b0\u09df\u09c7\u099b\u09c7, \u09af\u0996\u09a8 \u0986\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09b8\u09b9 \u09ab\u09bf\u09b0\u2018\u0986\u0989\u09a8\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09be\u09a0\u09bf\u09df\u09c7\u099b\u09bf\u09b2\u09be\u09ae\u0964","footnotes":""},{"id":"4714","sura":"51","aya":"39","arabic_text":"\u0641\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0628\u0650\u0631\u064f\u0643\u06e1\u0646\u0650\u0647\u0650\u06e6 \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0633\u064e\u0670\u062d\u0650\u0631\u064c \u0623\u064e\u0648\u06e1 \u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u065e","translation":"\u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09ab\u09bf\u09b0\u2018\u0986\u0989\u09a8 \u09a4\u09be\u09b0 \u09a6\u09b2\u09ac\u09b2\u09b8\u09b9 \u09ae\u09c1\u0996 \u09ab\u09bf\u09b0\u09bf\u09df\u09c7 \u09a8\u09bf\u09b2 \u098f\u09ac\u0982 \u09ac\u09b2\u09b2\u09cb: \u2018\u098f \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09af\u09be\u09a6\u09c1\u0995\u09b0 \u0985\u09a5\u09ac\u09be \u09aa\u09be\u0997\u09b2\u0964\u2019","footnotes":""},{"id":"4715","sura":"51","aya":"40","arabic_text":"\u0641\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0670\u0647\u064f \u0648\u064e\u062c\u064f\u0646\u064f\u0648\u062f\u064e\u0647\u064f\u06e5 \u0641\u064e\u0646\u064e\u0628\u064e\u0630\u06e1\u0646\u064e\u0670\u0647\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u064a\u064e\u0645\u0651\u0650 \u0648\u064e\u0647\u064f\u0648\u064e \u0645\u064f\u0644\u0650\u064a\u0645\u065e","translation":"\u09ab\u09b2\u09c7 \u0986\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u0993 \u09a4\u09be\u09b0 \u09b8\u09c8\u09a8\u09cd\u09af\u09ac\u09be\u09b9\u09bf\u09a8\u09c0\u0995\u09c7 \u09aa\u09be\u0995\u09dc\u09be\u0993 \u0995\u09b0\u09b2\u09be\u09ae\u0964 \u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b8\u09ae\u09c1\u09a6\u09cd\u09b0\u09c7 \u09a8\u09bf\u0995\u09cd\u09b7\u09c7\u09aa \u0995\u09b0\u09b2\u09be\u09ae\u0964 \u09b8\u09c7 \u09a4\u09cb \u099b\u09bf\u09b2 \u09a4\u09bf\u09b0\u09b8\u09cd\u0995\u09c3\u09a4\u0964","footnotes":""},{"id":"4716","sura":"51","aya":"41","arabic_text":"\u0648\u064e\u0641\u0650\u064a \u0639\u064e\u0627\u062f\u064d \u0625\u0650\u0630\u06e1 \u0623\u064e\u0631\u06e1\u0633\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u0631\u0651\u0650\u064a\u062d\u064e \u0671\u0644\u06e1\u0639\u064e\u0642\u0650\u064a\u0645\u064e","translation":"\u0986\u09b0 \u2018\u0986\u09a6 \u099c\u09be\u09a4\u09bf\u09b0 \u0998\u099f\u09a8\u09be\u09df\u0993 (\u09ee) , \u09af\u0996\u09a8 \u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0993\u09aa\u09b0 \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09be\u09ae \u0985\u0995\u09b2\u09cd\u09af\u09be\u09a3\u0995\u09b0-\u09ac\u09a8\u09cd\u09a7\u09be \u09ac\u09be\u09df\u09c1\u0964","footnotes":"(\u09ee) \u09af\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09a6\u09be\u09df\u0995 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u0995\u09c7 \u09ad\u09df\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u09c7 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u09b0\u09df\u09c7\u099b\u09c7\u0964"},{"id":"4717","sura":"51","aya":"42","arabic_text":"\u0645\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f \u0645\u0650\u0646 \u0634\u064e\u064a\u06e1\u0621\u064d \u0623\u064e\u062a\u064e\u062a\u06e1 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u064e\u062a\u06e1\u0647\u064f \u0643\u064e\u0671\u0644\u0631\u0651\u064e\u0645\u0650\u064a\u0645\u0650","translation":"\u0990 (\u09ac\u09bf\u09a7\u09cd\u09ac\u0982\u09b8\u09c0) \u09ac\u09be\u09df\u09c1 \u09af\u09be\u09b0 \u0993\u09aa\u09b0 \u09a6\u09bf\u09df\u09c7 \u09aa\u09cd\u09b0\u09ac\u09be\u09b9\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09bf\u09b2 \u09a4\u09be\u0995\u09c7\u0987 \u099a\u09c2\u09b0\u09cd\u09a3-\u09ac\u09bf\u099a\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09bf\u09b2\u0964","footnotes":""},{"id":"4718","sura":"51","aya":"43","arabic_text":"\u0648\u064e\u0641\u0650\u064a \u062b\u064e\u0645\u064f\u0648\u062f\u064e \u0625\u0650\u0630\u06e1 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u06e1 \u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u062d\u0650\u064a\u0646\u0656","translation":"\u0986\u09b0 \u09b8\u09be\u09ae\u09c2\u09a6 \u099c\u09be\u09a4\u09bf\u09b0 \u0998\u099f\u09a8\u09be\u09df\u0993 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8 \u09b0\u09df\u09c7\u099b\u09c7, \u09af\u0996\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09b2\u09be \u09b9\u09df\u09c7\u099b\u09bf\u09b2: \u2018\u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u0995\u09be\u09b2 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 (\u0986\u09ae\u09be\u09b0 \u09a8\u09bf\u2018\u0986\u09ae\u09a4) \u09ad\u09cb\u0997 \u0995\u09b0\u09c7 \u09a8\u09be\u0993\u0964\u2019","footnotes":""},{"id":"4719","sura":"51","aya":"44","arabic_text":"\u0641\u064e\u0639\u064e\u062a\u064e\u0648\u06e1\u0627\u0652 \u0639\u064e\u0646\u06e1 \u0623\u064e\u0645\u06e1\u0631\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0623\u064e\u062e\u064e\u0630\u064e\u062a\u06e1\u0647\u064f\u0645\u064f \u0671\u0644\u0635\u0651\u064e\u0670\u0639\u0650\u0642\u064e\u0629\u064f \u0648\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"\u0985\u09a4\u0983\u09aa\u09b0 \u09a4\u09be\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09b0\u09ac\u09c7\u09b0 \u0986\u09a6\u09c7\u09b6 \u09ae\u09be\u09a8\u09a4\u09c7 \u0985\u09b9\u0982\u0995\u09be\u09b0 \u0995\u09b0\u09b2\u09cb\u0964 \u09ab\u09b2\u09c7 \u09ac\u099c\u09cd\u09b0\u09be\u0998\u09be\u09a4 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09aa\u09be\u0995\u09dc\u09be\u0993 \u0995\u09b0\u09b2, \u0986\u09b0 \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be (\u0985\u09b8\u09b9\u09be\u09df\u09c7\u09b0 \u09ae\u09a4\u09cb) \u09a4\u09be \u09a6\u09c7\u0996\u099b\u09bf\u09b2\u0964","footnotes":""},{"id":"4720","sura":"51","aya":"45","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0670\u0639\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u0642\u0650\u064a\u064e\u0627\u0645\u0656 \u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0645\u064f\u0646\u062a\u064e\u0635\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u0985\u09a4\u0983\u09aa\u09b0 (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7) \u09a4\u09be\u09b0\u09be \u09a6\u09be\u0981\u09dc\u09be\u09a4\u09c7 \u09b8\u0995\u09cd\u09b7\u09ae \u09b9\u09b2\u09cb \u09a8\u09be \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b0\u09cb\u09a7\u0993 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09b2 \u09a8\u09be\u0964","footnotes":""},{"id":"4721","sura":"51","aya":"46","arabic_text":"\u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064e \u0646\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0642\u064e\u0648\u06e1\u0645\u0657\u0627 \u0641\u064e\u0670\u0633\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u0986\u09b0 \u0987\u09a4\u0983\u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09a8\u09c2\u09b9\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0995\u09c7\u0993\u0964 (\u09ef) \u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09a4\u09be\u09b0\u09be \u099b\u09bf\u09b2 \u098f\u0995\u099f\u09bf \u09ab\u09be\u09b8\u09bf\u0995 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0964\u0964","footnotes":"(\u09ef) \u0986\u09ae\u09bf \u09a1\u09c1\u09ac\u09bf\u09df\u09c7 \u09a7\u09cd\u09ac\u0982\u09b8 \u0995\u09b0\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09bf\u09b2\u09be\u09ae\u0964"},{"id":"4722","sura":"51","aya":"47","arabic_text":"\u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0628\u064e\u0646\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u0628\u0650\u0623\u064e\u064a\u06e1\u064a\u0652\u062f\u0656 \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u0648\u0633\u0650\u0639\u064f\u0648\u0646\u064e","translation":"\u0986\u09b0 \u0986\u09b8\u09ae\u09be\u09a8 \u0986\u09ae\u09bf \u09a8\u09bf\u099c \u09b6\u0995\u09cd\u09a4\u09bf\u09ac\u09b2\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ae\u09be\u09a3 \u0995\u09b0\u09c7\u099b\u09bf, \u0986\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc\u0987 \u0986\u09ae\u09bf\u0987 \u098f\u09b0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09b8\u09be\u09b0\u09a3\u0995\u09be\u09b0\u09c0\u0964","footnotes":""},{"id":"4723","sura":"51","aya":"48","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0641\u064e\u0631\u064e\u0634\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u0641\u064e\u0646\u0650\u0639\u06e1\u0645\u064e \u0671\u0644\u06e1\u0645\u064e\u0670\u0647\u0650\u062f\u064f\u0648\u0646\u064e","translation":"\u0986\u09b0 \u0986\u09ae\u09bf \u099c\u09ae\u09bf\u09a8\u0995\u09c7 \u09ac\u09bf\u099b\u09bf\u09df\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09bf\u0964 \u0986\u09ae\u09bf \u0995\u09a4\u0987 \u09a8\u09be \u0989\u09a4\u09cd\u09a4\u09ae \u09ac\u09bf\u09a8\u09cd\u09af\u09b8\u09cd\u09a4\u0995\u09be\u09b0\u09c0!","footnotes":""},{"id":"4724","sura":"51","aya":"49","arabic_text":"\u0648\u064e\u0645\u0650\u0646 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0627 \u0632\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"\u0986\u09b0 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u09ac\u09b8\u09cd\u09a4\u09c1 \u09a5\u09c7\u0995\u09c7 \u0986\u09ae\u09bf \u099c\u09cb\u09dc\u09be\u09df \u099c\u09cb\u09dc\u09be\u09df (\u09a8\u09be\u09b0\u09c0-\u09aa\u09c1\u09b0\u09c1\u09b7\u09c7) \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf, \u09af\u09be\u09a4\u09c7 \u09a4\u09cb\u09ae\u09b0\u09be \u0989\u09aa\u09a6\u09c7\u09b6 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb\u0964","footnotes":""},{"id":"4725","sura":"51","aya":"50","arabic_text":"\u0641\u064e\u0641\u0650\u0631\u0651\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0644\u0651\u064e\u0647\u0650\u06d6 \u0625\u0650\u0646\u0651\u0650\u064a \u0644\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u065e","translation":"\u0985\u09a4\u098f\u09ac \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09a6\u09bf\u0995\u09c7 \u09a7\u09be\u09ac\u09bf\u09a4 \u09b9\u0993\u0964 \u0986\u09ae\u09bf \u09a4\u09cb \u09a4\u09be\u0981\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09a5\u09c7\u0995\u09c7) \u098f\u0995 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09b8\u09a4\u09b0\u09cd\u0995\u0995\u09be\u09b0\u09c0\u0964","footnotes":""},{"id":"4726","sura":"51","aya":"51","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0627\u0652 \u0645\u064e\u0639\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0625\u0650\u0644\u064e\u0670\u0647\u064b\u0627 \u0621\u064e\u0627\u062e\u064e\u0631\u064e\u06d6 \u0625\u0650\u0646\u0651\u0650\u064a \u0644\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u065e","translation":"\u0986\u09b0 \u09a4\u09cb\u09ae\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09be\u09a5\u09c7 \u0995\u09cb\u09a8 \u0987\u09b2\u09be\u09b9 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09cb \u09a8\u09be; \u0986\u09ae\u09bf \u09a4\u09be\u0981\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af (\u098f \u09ac\u09bf\u09b7\u09df\u09c7) \u098f\u0995 \u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u09b8\u09a4\u09b0\u09cd\u0995\u0995\u09be\u09b0\u09c0\u0964","footnotes":""},{"id":"4727","sura":"51","aya":"52","arabic_text":"\u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u062a\u064e\u0649 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0647\u0650\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0633\u064f\u0648\u0644\u064d \u0625\u0650\u0644\u0651\u064e\u0627 \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0633\u064e\u0627\u062d\u0650\u0631\u064c \u0623\u064e\u0648\u06e1 \u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u064c","translation":"\u098f\u09ad\u09be\u09ac\u09c7 (\u09e7\u09e6) \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09af\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2\u0987 \u098f\u09b8\u09c7\u099b\u09c7, \u09a4\u09be\u09b0\u09be \u09ac\u09b2\u09c7\u099b\u09c7: \u2018\u098f \u09a4\u09cb \u098f\u0995\u099c\u09a8 \u09af\u09be\u09a6\u09c1\u0995\u09b0 \u0985\u09a5\u09ac\u09be \u09aa\u09be\u0997\u09b2\u0964\u2019","footnotes":"(\u09e7\u09e6) \u09ae\u0995\u09cd\u0995\u09be\u09ac\u09be\u09b8\u09c0\u09a6\u09c7\u09b0 \u098f\u0987 \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u099a\u09be\u09b0\u09c7\u09b0 \u09ae\u09a4\u09cb\u0964"},{"id":"4728","sura":"51","aya":"53","arabic_text":"\u0623\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0647\u0650\u06e6\u06da \u0628\u064e\u0644\u06e1 \u0647\u064f\u0645\u06e1 \u0642\u064e\u0648\u06e1\u0645\u065e \u0637\u064e\u0627\u063a\u064f\u0648\u0646\u064e","translation":"\u09a4\u09be\u09b0\u09be \u0995\u09bf (\u09ac\u0982\u09b6\u09be\u09a8\u09c1\u0995\u09cd\u09b0\u09ae\u09c7) \u098f\u0995\u09c7 \u0985\u09aa\u09b0\u0995\u09c7 \u098f\u0987 \u098f\u0995\u0987 \u0989\u09aa\u09a6\u09c7\u09b6\u0987 \u09a6\u09bf\u09df\u09c7 \u0997\u09c7\u099b\u09c7? \u09ac\u09b0\u0982 \u09a4\u09be\u09b0\u09be \u09b8\u09c0\u09ae\u09be\u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09df\u0964","footnotes":""},{"id":"4729","sura":"51","aya":"54","arabic_text":"\u0641\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e \u0639\u064e\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0641\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0628\u0650\u0645\u064e\u0644\u064f\u0648\u0645\u0656","translation":"\u0985\u09a4\u098f\u09ac, \u09b9\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2! \u09a4\u09c1\u09ae\u09bf \u0993\u09a6\u09c7\u09b0 \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u0996 \u09ab\u09bf\u09b0\u09bf\u09df\u09c7 \u09a8\u09be\u0993, \u098f\u09a4\u09c7 \u09a4\u09c1\u09ae\u09bf \u09a4\u09bf\u09b0\u09b8\u09cd\u0995\u09c3\u09a4 \u09b9\u09ac\u09c7 \u09a8\u09be\u0964(\u09e7\u09e7)","footnotes":"(\u09e7\u09e7) \u0995\u09c7\u09a8\u09a8\u09be, \u09a4\u09c1\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u09af\u09c7 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a8\u09bf\u09df\u09c7 \u098f\u09b8\u09c7\u099b\u09cb, \u09a4\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09cc\u0981\u099b\u09c7 \u09a6\u09bf\u09df\u09c7\u099b\u09c7\u09be\u0964"},{"id":"4730","sura":"51","aya":"55","arabic_text":"\u0648\u064e\u0630\u064e\u0643\u0651\u0650\u0631\u06e1 \u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u062a\u064e\u0646\u0641\u064e\u0639\u064f \u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u0650\u064a\u0646\u064e","translation":"\u0986\u09b0 \u09a4\u09c1\u09ae\u09bf (\u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7) \u0989\u09aa\u09a6\u09c7\u09b6 \u09a6\u09bf\u09a4\u09c7 \u09a5\u09be\u0995; \u0995\u09be\u09b0\u09a3 \u0989\u09aa\u09a6\u09c7\u09b6 \u09ae\u09c1\u2019\u09ae\u09bf\u09a8\u09a6\u09c7\u09b0 \u0989\u09aa\u0995\u09be\u09b0\u09c7 \u0986\u09b8\u09c7\u0964","footnotes":""},{"id":"4731","sura":"51","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u062a\u064f \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u064e \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0644\u0650\u064a\u064e\u0639\u06e1\u0628\u064f\u062f\u064f\u0648\u0646\u0650","translation":"\u0986\u09b0 \u0986\u09ae\u09bf \u099c\u09bf\u09a8 \u0993 \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u0995\u09c7\u09ac\u09b2 \u0986\u09ae\u09be\u09b0 \u0987\u09ac\u09be\u09a6\u09be\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u09c7\u0987 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf\u0964","footnotes":""},{"id":"4732","sura":"51","aya":"57","arabic_text":"\u0645\u064e\u0627\u0653 \u0623\u064f\u0631\u0650\u064a\u062f\u064f \u0645\u0650\u0646\u06e1\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u0650\u0632\u06e1\u0642\u0656 \u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064f\u0631\u0650\u064a\u062f\u064f \u0623\u064e\u0646 \u064a\u064f\u0637\u06e1\u0639\u0650\u0645\u064f\u0648\u0646\u0650","translation":"\u0986\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0995\u09cb\u09a8\u09cb \u09b0\u09bf\u09af\u09bf\u0995 \u099a\u09be\u0987 \u09a8\u09be \u098f\u09ac\u0982 \u0986\u09ae\u09bf \u098f\u099f\u09be\u0993 \u099a\u09be\u0987 \u09a8\u09be \u09af\u09c7, \u09a4\u09be\u09b0\u09be \u0986\u09ae\u09be\u0995\u09c7 \u0986\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09ac\u09c7\u0964","footnotes":""},{"id":"4733","sura":"51","aya":"58","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0647\u064f\u0648\u064e \u0671\u0644\u0631\u0651\u064e\u0632\u0651\u064e\u0627\u0642\u064f \u0630\u064f\u0648 \u0671\u0644\u06e1\u0642\u064f\u0648\u0651\u064e\u0629\u0650 \u0671\u0644\u06e1\u0645\u064e\u062a\u0650\u064a\u0646\u064f","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u0987 \u09b0\u09bf\u09af\u0995\u09a6\u09be\u09a4\u09be, \u09a4\u09bf\u09a8\u09bf \u09aa\u09cd\u09b0\u09ac\u09b2 \u09b6\u0995\u09cd\u09a4\u09bf\u09a7\u09b0, \u09aa\u09b0\u09be\u0995\u09cd\u09b0\u09ae\u09b6\u09be\u09b2\u09c0\u0964","footnotes":""},{"id":"4734","sura":"51","aya":"59","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0638\u064e\u0644\u064e\u0645\u064f\u0648\u0627\u0652 \u0630\u064e\u0646\u064f\u0648\u0628\u0657\u0627 \u0645\u0651\u0650\u062b\u06e1\u0644\u064e \u0630\u064e\u0646\u064f\u0648\u0628\u0650 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062a\u064e\u0639\u06e1\u062c\u0650\u0644\u064f\u0648\u0646\u0650","translation":"\u09b8\u09c1\u09a4\u09b0\u09be\u0982 \u09af\u09be\u09b0\u09be (\u09e7\u09e8) \u09af\u09c1\u09b2\u09ae \u0995\u09b0\u09c7\u099b\u09c7, \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09df\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09b8\u09c2\u09b0\u09bf\u09a6\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09c2\u09aa \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u0964 \u0995\u09be\u099c\u09c7\u0987 \u09a4\u09be\u09b0\u09be \u09af\u09c7\u09a8 \u0986\u09ae\u09be\u09b0 \u0995\u09be\u099b\u09c7 (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af) \u09a4\u09be\u09dc\u09be\u09b9\u09c1\u09dc\u09be \u09a8\u09be \u0995\u09b0\u09c7\u0964","footnotes":"(\u09e7\u09e8) \u0988\u09ae\u09be\u09a8 \u09a8\u09be \u098f\u09a8\u09c7 \u09a8\u09bf\u099c\u09c7\u09a6\u09c7\u09b0 \u0993\u09aa\u09b0\u0964"},{"id":"4735","sura":"51","aya":"60","arabic_text":"\u0641\u064e\u0648\u064e\u064a\u06e1\u0644\u065e \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u064a\u064e\u0648\u06e1\u0645\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"\u0985\u09a4\u098f\u09ac, \u09af\u09be\u09b0\u09be \u0995\u09c1\u09ab\u09b0\u09c0 \u0995\u09b0\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09bf\u09df\u09be\u09ae\u09a4 \u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09a7\u09cd\u09ac\u0982\u09b8, \u09af\u09c7\u09a6\u09bf\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09a6\u09c7\u09df\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964","footnotes":""}]}