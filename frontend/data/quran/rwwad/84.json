0\u09ac\u09a8, \u09ae\u09c3\u09a4\u09cd\u09af\u09c1 \u0993 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7\u09c7 \u09aa\u09c1\u09a8\u09b0\u09c1\u09a4\u09cd\u09a5\u09be\u09a8 \u09b9\u09df\u09c7 \u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4 \u0985\u09a5\u09ac\u09be \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u0964"},{"id":"5904","sura":"84","aya":"20","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u0985\u09a4\u098f\u09ac \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09c0 \u09b9\u09b2\u09cb \u09af\u09c7, \u09a4\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u099b\u09c7 \u09a8\u09be?","footnotes":""},{"id":"5905","sura":"84","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064f \u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0646\u064e\u06e4\u06e9","translation":"\u0986\u09b0 \u09af\u0996\u09a8 \u09a4\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0986\u09b2-\u0995\u09c1\u09b0\u0986\u09a8 \u09a4\u09bf\u09b2\u09be\u0993\u09df\u09be\u09a4 \u0995\u09b0\u09be \u09b9\u09df, \u09a4\u0996\u09a8 \u09a4\u09be\u09b0\u09be \u09b8\u09be\u099c\u09a6\u09be \u0995\u09b0\u09c7 \u09a8\u09be\u0964","footnotes":""},{"id":"5906","sura":"84","aya":"22","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"\u09ac\u09b0\u0982 \u0995\u09be\u09ab\u09bf\u09b0\u09b0\u09be \u09ae\u09bf\u09a5\u09cd\u09af\u09be\u09b0\u09cb\u09aa \u0995\u09b0\u09c7\u0964","footnotes":""},{"id":"5907","sura":"84","aya":"23","arabic_text":"\u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0639\u064f\u0648\u0646\u064e","translation":"\u0986\u09b0 \u09a4\u09be\u09b0\u09be \u09af\u09be \u0985\u09a8\u09cd\u09a4\u09b0\u09c7 \u09aa\u09cb\u09b7\u09a3 \u0995\u09b0\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be \u09b8\u09ac\u09bf\u09b6\u09c7\u09b7 \u09aa\u09b0\u09bf\u099c\u09cd\u099e\u09be\u09a4\u0964","footnotes":""},{"id":"5908","sura":"84","aya":"24","arabic_text":"\u0641\u064e\u0628\u064e\u0634\u0651\u0650\u0631\u06e1\u0647\u064f\u0645 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","translation":"\u0985\u09a4\u098f\u09ac ( \u09b0\u09be\u09b8\u09c2\u09b2!) \u09a4\u09c1\u09ae\u09bf \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09af\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u09be\u09a6\u09be\u09df\u0995 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0 \u09b8\u09c1\u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09be\u0993\u0964","footnotes":""},{"id":"5909","sura":"84","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062c\u06e1\u0631\u064c \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0645\u06e1\u0646\u064f\u0648\u0646\u0650\u06ed","translation":"\u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u0986\u09a8\u09c7 \u098f\u09ac\u0982 \u09b8\u09ce\u0995\u09b0\u09cd\u09ae \u0995\u09b0\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09df\u09c7\u099b\u09c7 \u09a8\u09bf\u09b0\u09ac\u099a\u09cd\u099b\u09bf\u09a8\u09cd\u09a8 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09be\u09a8 (\u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4)\u0964","footnotes":""}]}